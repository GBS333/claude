		{ position = Vector3.new(0, 0, -190), angle = 0 },
		{ position = Vector3.new(130, 0, -190), angle = 0 },
	},
}

---------------------------------------------------------------------
-- NÍVEIS E EVOLUÇÃO
-- Seus brainrots ganham XP derrotando brainrots selvagens com você.
-- Cada nível dá mais vida, força e renda. Nos níveis de EvolveLevels eles evoluem!
---------------------------------------------------------------------
Config.Levels = {
	MaxLevel = 50,
	EvolveLevels = { 15, 30 }, -- nível para virar a 2ª e a 3ª evolução
	HealthPerLevel = 0.08, -- +8% de vida por nível
	PowerPerLevel = 0.08, -- +8% de força por nível
	IncomePerLevel = 0.10, -- +10% de renda por nível
	SellPerLevel = 0.10,
	StageHealth = { 1, 1.3, 1.7 }, -- multiplicador de vida em cada evolução
	StagePower = { 1, 1.3, 1.8 },
	StageIncome = { 1, 1.5, 2.5 },
	StageScale = { 1, 1.25, 1.5 }, -- tamanho do modelo
	XpBase = 25, -- XP para o nível 2
	XpExponent = 1.5, -- quanto mais alto, mais XP precisa
	CaptureXpShare = 0.5, -- o parceiro ganha metade do XP quando você captura
}

---------------------------------------------------------------------
-- ATAQUES DO PARCEIRO
-- kind: "Melee" (corpo a corpo), "Projectile" (de longe), "Area" (todos em volta)
-- power = multiplicador da força do brainrot
---------------------------------------------------------------------
Config.Moves = {
	{ id = "Basico", name = "Ataque", level = 1, power = 1, cooldown = 1.4, range = 6, kind = "Melee", auto = true },
	{ id = "Cabecada", name = "Cabeçada", level = 5, power = 2, cooldown = 6, range = 7, kind = "Melee", key = "Z" },
	{ id = "Rajada", name = "Rajada Brainrot", level = 10, power = 2.5, cooldown = 9, range = 45, kind = "Projectile", key = "X" },
	{ id = "Terremoto", name = "Terremoto", level = 20, power = 2, cooldown = 15, range = 16, kind = "Area", key = "C" },
	-- o nome deste vem do "signature" de cada brainrot
	{ id = "Especial", name = "Golpe Especial", level = 30, power = 4.5, cooldown = 22, range = 45, kind = "Projectile", key = "V", signature = true },
}

---------------------------------------------------------------------
-- PARCEIRO (o brainrot que luta com você)
---------------------------------------------------------------------
Config.Companion = {
	HealthMultiplier = 2, -- parceiros são mais fortes que os selvagens do mesmo nível
	DamageMultiplier = 2,
	FollowDistance = 5,
	MinSpeed = 16,
	LeashDistance = 70, -- longe demais do dono = volta correndo
	TeleportDistance = 120,
	AutoTargetRadius = 30, -- no modo automático ataca brainrots até essa distância de você
	FaintTime = 20, -- segundos para voltar depois de desmaiar
	RegenDelay = 5,
	RegenPercentPerSecond = 0.05,
}

---------------------------------------------------------------------
-- Funções de busca (não precisa mexer)
---------------------------------------------------------------------
local function index(list)
	local map = {}
	for _, item in ipairs(list) do
		map[item.id] = item
	end
	return map
end

local brainrotById = index(Config.Brainrots)
local ballById = index(Config.Balls)
local batById = index(Config.Bats)
local moveById = index(Config.Moves)

function Config.getBrainrot(id)
	return brainrotById[id]
end

function Config.getBall(id)
	return ballById[id]
end

function Config.getBat(id)
	return batById[id]
end

function Config.getMove(id)
	return moveById[id]
end

function Config.getRarity(name)
	return Config.Rarities[name]
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000004"><Properties><string name="Name">Stats</string><ProtectedString name="Source"><![CDATA[-- Status dos brainrots por nível e evolução (servidor e interface usam o mesmo cálculo)

local Config = require(script.Parent.Config)

local L = Config.Levels
local Stats = {}

-- 1 = forma normal, 2 = primeira evolução, 3 = evolução final
function Stats.stage(level: number): number
	local stage = 1
	for i, evolveLevel in ipairs(L.EvolveLevels) do
		if level >= evolveLevel then
			stage = i + 1
		end
	end
	return stage
end

function Stats.displayName(def, level: number): string
	local stage = Stats.stage(level)
	if stage > 1 and def.evolutions and def.evolutions[stage - 1] then
		return def.evolutions[stage - 1]
	end
	return def.name
end

local function levelMult(level: number, perLevel: number): number
	return 1 + perLevel * (level - 1)
end

-- stageOverride: os selvagens não evoluem, então eles usam 1
function Stats.maxHealth(def, level: number, stageOverride: number?): number
	local stage = stageOverride or Stats.stage(level)
	return math.floor(def.maxHealth * levelMult(level, L.HealthPerLevel) * L.StageHealth[stage])
end

function Stats.power(def, level: number, stageOverride: number?): number
	local stage = stageOverride or Stats.stage(level)
	return def.damage * levelMult(level, L.PowerPerLevel) * L.StagePower[stage]
end

function Stats.income(def, level: number): number
	local stage = Stats.stage(level)
	return math.floor(def.income * levelMult(level, L.IncomePerLevel) * L.StageIncome[stage] * 10 + 0.5) / 10
end

function Stats.sellPrice(def, level: number): number
	local stage = Stats.stage(level)
	return math.floor(def.sellPrice * levelMult(level, L.SellPerLevel) * L.StageIncome[stage])
end

function Stats.scale(level: number): number
	return L.StageScale[Stats.stage(level)]
end

-- XP para passar do nível atual para o próximo
function Stats.xpToNext(level: number): number
	return math.floor(L.XpBase * level ^ L.XpExponent)
end

function Stats.companionMaxHealth(def, level: number): number
	return math.floor(Stats.maxHealth(def, level) * Config.Companion.HealthMultiplier)
end

function Stats.companionPower(def, level: number): number
	return Stats.power(def, level) * Config.Companion.DamageMultiplier
end

function Stats.moveName(move, def): string
	if move.signature and def and def.signature then
		return def.signature
	end
	return move.name
end

-- ataques que o brainrot já aprendeu
function Stats.knownMoves(level: number)
	local list = {}
	for _, move in ipairs(Config.Moves) do
		if level >= move.level then
			table.insert(list, move)
		end
	end
	return list
end

-- quantos XP ganha ao derrotar um selvagem
function Stats.xpReward(def, level: number): number
	local rarity = Config.getRarity(def.rarity)
	return math.floor(rarity.xpReward * (1 + 0.5 * (level - 1)))
end

return Stats
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000000000000000000000000000013"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000012"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Script principal do servidor: liga todos os sistemas do jogo.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Services = script.Parent:WaitForChild("Services")
local Remotes = require(Services.Remotes)
local DataService = require(Services.DataService)
local WorldBuilder = require(Services.WorldBuilder)
local TycoonService = require(Services.TycoonService)
local WildService = require(Services.WildService)
local ToolService = require(Services.ToolService)
local CompanionService = require(Services.CompanionService)
local ShopService = require(Services.ShopService)

WorldBuilder.build()
TycoonService.start()
WildService.start()
ToolService.start()
CompanionService.start()
ShopService.start()

local function onCharacter(player: Player, character: Model)
	character:WaitForChild("HumanoidRootPart", 10)
	-- espera a mochila nova ser criada após o respawn
	player:WaitForChild("Backpack", 10)
	task.wait(0.2)
	if character.Parent == nil then
		return
	end
	ToolService.giveTools(player)
	TycoonService.teleportHome(player)
	task.wait(0.1)
	CompanionService.spawn(player) -- seu parceiro aparece do seu lado
end

local function onPlayerAdded(player: Player)
	DataService.load(player)
	if player.Parent ~= Players then
		DataService.release(player)
		return
	end
	TycoonService.assign(player)
	DataService.pushUpdate(player)

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end

	Remotes.notify(player, "Bem-vindo! Pegue o 🏏 Taco, bata nos brainrots e use a ⚪ Bola quando estiverem com POUCA vida!", Color3.fromRGB(255, 230, 100))
	task.delay(6, function()
		if player.Parent == Players then
			Remotes.notify(player, "⚔ Escolha um brainrot como PARCEIRO no menu 🎒 para ele lutar com você e ganhar XP!", Color3.fromRGB(140, 230, 255))
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	CompanionService.dismiss(player, true)
	TycoonService.release(player)
	DataService.release(player)
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		task.wait(1)
	end
	for _, player in ipairs(Players:GetPlayers()) do
		TycoonService.release(player)
		task.spawn(DataService.release, player)
	end
	task.wait(3)
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000000000000000000000000000011"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">BrainrotModels</string><ProtectedString name="Source"><![CDATA[-- Monta o visual de cada brainrot usando peças (Parts).
-- Se quiser usar modelos feitos por você: coloque um Model em
-- ServerStorage/BrainrotModels com o MESMO id da Config (ex: "Sapo").
-- O modelo precisa ter uma PrimaryPart no centro do corpo.

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local BrainrotModels = {}

local function makePart(parent, props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		part[k] = v
	end
	part.Parent = parent
	return part
end

local function buildFromParts(def, scale: number)
	local s = scale
	local size = def.size * s
	local model = Instance.new("Model")
	model.Name = def.id

	local root = makePart(model, {
		Name = "Root",
		Size = size,
		Transparency = 1,
		CFrame = CFrame.new(),
	})
	model.PrimaryPart = root

	-- CORPO
	local body
	if def.shape == "Ball" then
		body = makePart(model, {
			Name = "Body", Shape = Enum.PartType.Ball,
			Size = Vector3.new(size.X, size.X, size.X), Color = def.bodyColor, CFrame = CFrame.new(),
		})
	elseif def.shape == "Cylinder" then
		-- cilindros do Roblox ficam deitados no eixo X, então giramos para ficar em pé
		body = makePart(model, {
			Name = "Body", Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(size.Y, size.X, size.X), Color = def.bodyColor,
			CFrame = CFrame.Angles(0, 0, math.rad(90)),
		})
	else
		body = makePart(model, {
			Name = "Body", Size = size, Color = def.bodyColor, CFrame = CFrame.new(),
		})
	end

	local halfY = size.Y / 2
	local front = -size.Z / 2 -- frente do modelo é -Z

	-- OLHOS
	local eyeSize = math.max(size.X * 0.28, 0.6)
	for _, side in ipairs({ -1, 1 }) do
		local eyePos = Vector3.new(side * size.X * 0.22, halfY * 0.35, front * 0.85)
		makePart(model, {
			Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * eyeSize,
			Color = Color3.new(1, 1, 1), CFrame = CFrame.new(eyePos),
		})
		makePart(model, {
			Name = "Pupil", Shape = Enum.PartType.Ball, Size = Vector3.one * eyeSize * 0.5,
			Color = Color3.new(0, 0, 0), CFrame = CFrame.new(eyePos + Vector3.new(0, 0, -eyeSize * 0.35)),
		})
	end

	-- BOCA
	makePart(model, {
		Name = "Mouth", Size = Vector3.new(size.X * 0.4, 0.25 * s, 0.2 * s),
		Color = Color3.fromRGB(60, 20, 20), CFrame = CFrame.new(0, -halfY * 0.25, front * 0.92),
	})

	-- PÉS
	for _, side in ipairs({ -1, 1 }) do
		makePart(model, {
			Name = "Foot", Size = Vector3.new(0.9, 0.7, 1.2) * s, Color = def.accentColor,
			CFrame = CFrame.new(side * size.X * 0.25, -halfY - 0.3 * s, 0),
		})
	end

	-- ACESSÓRIO
	local acc = def.accessory
	local accent = def.accentColor
	if acc == "Antena" then
		makePart(model, {
			Name = "Antenna", Size = Vector3.new(0.2, 1.6, 0.2) * s, Color = Color3.fromRGB(40, 40, 40),
			CFrame = CFrame.new(0, halfY + 0.8 * s, 0),
		})
		makePart(model, {
			Name = "AntennaTip", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.7 * s,
			Color = accent, Material = Enum.Material.Neon, CFrame = CFrame.new(0, halfY + 1.7 * s, 0),
		})
	elseif acc == "Chapeu" then
		makePart(model, {
			Name = "HatBrim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2 * s, size.X * 0.9, size.X * 0.9),
			Color = accent, CFrame = CFrame.new(0, halfY, 0) * CFrame.Angles(0, 0, math.rad(90)),
		})
		makePart(model, {
			Name = "HatTop", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4 * s, size.X * 0.55, size.X * 0.55),
			Color = accent, CFrame = CFrame.new(0, halfY + 0.7 * s, 0) * CFrame.Angles(0, 0, math.rad(90)),
		})
	elseif acc == "Orelhas" then
		for _, side in ipairs({ -1, 1 }) do
			makePart(model, {
				Name = "Ear", Size = Vector3.new(0.5, 1.2, 0.8) * s, Color = accent,
				CFrame = CFrame.new(side * size.X * 0.35, halfY + 0.4 * s, 0) * CFrame.Angles(0, 0, math.rad(-side * 20)),
			})
		end
	elseif acc == "Asas" then
		for _, side in ipairs({ -1, 1 }) do
			makePart(model, {
				Name = "Wing", Size = Vector3.new(2.2, 0.2, 1.4) * s, Color = Color3.new(1, 1, 1),
				CFrame = CFrame.new(side * (size.X / 2 + 1 * s), halfY * 0.3, 0) * CFrame.Angles(0, 0, math.rad(side * 25)),
			})
		end
	elseif acc == "Disco" then
		makePart(model, {
			Name = "Disc", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3 * s, 2 * s, 2 * s),
			Color = accent, Material = Enum.Material.Metal,
			CFrame = CFrame.new(size.X / 2 + 0.3 * s, 0, 0),
		})
	elseif acc == "Capacete" then
		makePart(model, {
			Name = "Helmet", Shape = Enum.PartType.Ball, Size = Vector3.one * size.X * 1.25,
			Color = accent, Material = Enum.Material.Glass, Transparency = 0.6, CFrame = CFrame.new(),
		})
		makePart(model, {
			Name = "Crown", Size = Vector3.new(size.X * 0.5, 0.5 * s, size.X * 0.5), Color = Color3.fromRGB(255, 210, 40),
			Material = Enum.Material.Neon, CFrame = CFrame.new(0, size.X * 0.65, 0),
		})
	elseif acc == "Coroa" then
		makePart(model, {
			Name = "Crown", Size = Vector3.new(size.X * 0.6, 0.6 * s, size.X * 0.6), Color = Color3.fromRGB(255, 210, 40),
			Material = Enum.Material.Neon, CFrame = CFrame.new(0, halfY + 0.3 * s, 0),
		})
	end

	-- brilho para os mais raros
	if def.rarity == "Lendario" or def.rarity == "Mitico" then
		local light = Instance.new("PointLight")
		light.Color = Config.getRarity(def.rarity).color
		light.Range = 12
		light.Brightness = 2
		light.Parent = body
	end

	-- altura do centro do corpo até o chão
	model:SetAttribute("HipHeight", halfY + 0.65 * s)
	return model
end

-- Efeitos das evoluções: 2ª evolução brilha, 3ª ganha coroa e aura
local function applyStage(model: Model, def, stage: number)
	if stage < 2 or not model.PrimaryPart then
		return
	end
	local root = model.PrimaryPart
	local color = Config.getRarity(def.rarity).color

	local aura = Instance.new("ParticleEmitter")
	aura.Name = "EvoAura"
	aura.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	aura.LightEmission = 0.8
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	aura.Transparency = NumberSequence.new(0.3)
	aura.Lifetime = NumberRange.new(0.8, 1.4)
	aura.Rate = if stage >= 3 then 25 else 10
	aura.Speed = NumberRange.new(1, 3)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Parent = root

	if stage >= 3 then
		local _, size = model:GetBoundingBox()
		local crown = Instance.new("Part")
		crown.Name = "EvoCrown"
		crown.Anchored = true
		crown.CanCollide = false
		crown.CanTouch = false
		crown.Material = Enum.Material.Neon
		crown.Color = Color3.fromRGB(255, 215, 50)
		crown.Size = Vector3.new(size.X * 0.45, 0.5, size.X * 0.45)
		crown.CFrame = root.CFrame * CFrame.new(0, size.Y / 2 + 0.6, 0)
		crown.Parent = model
		for i = 0, 3 do
			local spike = Instance.new("Part")
			spike.Name = "EvoSpike"
			spike.Anchored = true
			spike.CanCollide = false
			spike.CanTouch = false
			spike.Material = Enum.Material.Neon
			spike.Color = crown.Color
			spike.Size = Vector3.new(0.35, 0.8, 0.35)
			local angle = i * math.pi / 2
			spike.CFrame = crown.CFrame * CFrame.new(math.cos(angle) * size.X * 0.18, 0.6, math.sin(angle) * size.X * 0.18)
			spike.Parent = model
		end
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 14
		light.Brightness = 3
		light.Parent = root
	end
end

-- Cria um novo modelo do brainrot. scale = tamanho (1 = normal). stage = evolução (1, 2 ou 3).
function BrainrotModels.build(def, scale: number?, stage: number?)
	local model = BrainrotModels.buildBase(def, scale or 1)
	applyStage(model, def, stage or 1)
	return model
end

function BrainrotModels.buildBase(def, scale: number)
	local folder = ServerStorage:FindFirstChild("BrainrotModels")
	local custom = folder and folder:FindFirstChild(def.id)
	if custom and custom:IsA("Model") and custom.PrimaryPart then
		local model = custom:Clone()
		model.Name = def.id
		if scale ~= 1 then
			model:ScaleTo(scale)
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
			end
		end
		if model:GetAttribute("HipHeight") == nil then
			local _, bbSize = model:GetBoundingBox()
			model:SetAttribute("HipHeight", bbSize.Y / 2)
		end
		return model
	end
	return buildFromParts(def, scale)
end

return BrainrotModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">CompanionService</string><ProtectedString name="Source"><![CDATA[-- PARCEIRO: o brainrot que você capturou luta do seu lado.
-- Ele te segue, ataca os selvagens, ganha XP quando eles são derrotados,
-- sobe de nível (mais vida, força e renda), aprende ataques novos e EVOLUI.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local WildService = require(script.Parent.WildService)
local BrainrotModels = require(script.Parent.BrainrotModels)
local Remotes = require(script.Parent.Remotes)

local CompanionService = {}

local CC = Config.Companion
local BASIC = Config.getMove("Basico")

local folder = Instance.new("Folder")
folder.Name = "Companions"
folder.Parent = workspace

local active = {} -- [Player] = Companion
local faintMemory = {} -- [Player] = { uid = string, untilTime = number } (não dá para "trapacear" guardando e chamando de novo)

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

---------------------------------------------------------------------
-- Classe Companion
---------------------------------------------------------------------
local Companion = {}
Companion.__index = Companion

function Companion:isAlive(): boolean
	return not self.destroyed and not self.fainted
end

function Companion:getPosition(): Vector3
	return self.position
end

function Companion:refreshStats(fullHeal: boolean)
	local level = self.item.level
	local oldMax = self.maxHealth or 1
	self.maxHealth = Stats.companionMaxHealth(self.def, level)
	self.power = Stats.companionPower(self.def, level)
	if fullHeal or not self.health then
		self.health = self.maxHealth
	else
		self.health = math.min(self.maxHealth, self.health * self.maxHealth / oldMax)
	end
end

function Companion:updateBar()
	if not self.model then
		return
	end
	local ratio = math.clamp(self.health / self.maxHealth, 0, 1)
	self.fill.Size = UDim2.fromScale(ratio, 1)
	self.hpText.Text = math.ceil(self.health) .. " / " .. self.maxHealth
	self.model:SetAttribute("Health", self.health)
	self.model:SetAttribute("MaxHealth", self.maxHealth)
end

function Companion:buildModel()
	if self.model then
		self.model:Destroy()
	end
	local def, level = self.def, self.item.level
	local model = BrainrotModels.build(def, Stats.scale(level), Stats.stage(level))
	model.Name = self.player.Name .. "_Parceiro"
	model:SetAttribute("OwnerUserId", self.player.UserId)
	model:SetAttribute("CompanionUid", self.item.uid)
	model:SetAttribute("BrainrotId", def.id)
	model:SetAttribute("Level", level)
	-- não bloqueia as bolas nem o mouse
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	self.hipHeight = model:GetAttribute("HipHeight") or def.size.Y / 2
	self.radius = def.size.X * Stats.scale(level) / 2

	-- placa com nome, nível e vida
	local rarity = Config.getRarity(def.rarity)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(190, 62)
	gui.StudsOffsetWorldSpace = Vector3.new(0, self.hipHeight + 3, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Adornee = model.PrimaryPart

	local owner = Instance.new("TextLabel")
	owner.Size = UDim2.new(1, 0, 0, 16)
	owner.BackgroundTransparency = 1
	owner.Text = "⚔ Parceiro de " .. self.player.DisplayName
	owner.TextColor3 = Color3.fromRGB(140, 230, 255)
	owner.TextStrokeTransparency = 0.3
	owner.Font = Enum.Font.GothamBold
	owner.TextScaled = true
	owner.Parent = gui

	local name = Instance.new("TextLabel")
	name.Position = UDim2.fromOffset(0, 16)
	name.Size = UDim2.new(1, 0, 0, 22)
	name.BackgroundTransparency = 1
	name.Text = Stats.displayName(def, level) .. "  Lv." .. level
	name.TextColor3 = rarity.color
	name.TextStrokeTransparency = 0.2
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.Parent = gui

	local back = Instance.new("Frame")
	back.Position = UDim2.fromOffset(15, 42)
	back.Size = UDim2.new(1, -30, 0, 14)
	back.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	back.BorderSizePixel = 0
	back.Parent = gui
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(70, 200, 255)
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)

	local hpText = Instance.new("TextLabel")
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.BackgroundTransparency = 1
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.TextStrokeTransparency = 0.2
	hpText.Font = Enum.Font.GothamBold
	hpText.TextScaled = true
	hpText.ZIndex = 2
	hpText.Parent = back

	gui.Parent = model
	self.model = model
	self.fill = fill
	self.hpText = hpText
	self:updateBar()
	model:PivotTo(CFrame.new(self.position + Vector3.new(0, self.hipHeight, 0)))
	model.Parent = folder
end

function Companion:setVisible(visible: boolean)
	if not self.model then
		return
	end
	for _, d in ipairs(self.model:GetDescendants()) do
		if d:IsA("BasePart") then
			if visible then
				local original = d:GetAttribute("OriginalTransparency")
				if original then
					d.Transparency = original
				end
			else
				if d:GetAttribute("OriginalTransparency") == nil then
					d:SetAttribute("OriginalTransparency", d.Transparency)
				end
				d.Transparency = 1
			end
		elseif d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("PointLight") then
			d.Enabled = visible
		end
	end
end

function Companion:takeDamage(amount: number, attackerState)
	if not self:isAlive() then
		return
	end
	amount = math.max(1, math.floor(amount + 0.5))
	self.health -= amount
	self.lastDamage = os.clock()

	local h = Instance.new("Highlight")
	h.FillColor = Color3.fromRGB(255, 60, 60)
	h.FillTransparency = 0.3
	h.OutlineTransparency = 1
	h.Parent = self.model
	Debris:AddItem(h, 0.15)
	WildService.floatingText(self.position + Vector3.new(0, self.hipHeight * 2 + 1, 0), "-" .. amount, Color3.fromRGB(255, 150, 60))

	-- revida em quem bateu
	if attackerState and (not self.target or not WildService.isAlive(self.target)) then
		self.target = attackerState
	end

	if self.health <= 0 then
		self.health = 0
		self:faint()
	end
	self:updateBar()
end

function Companion:faint()
	self.fainted = true
	self.faintedUntil = os.clock() + CC.FaintTime
	self.target = nil
	self.queuedMove = nil
	faintMemory[self.player] = { uid = self.item.uid, untilTime = self.faintedUntil }
	WildService.poof(self.position + Vector3.new(0, 2, 0), Color3.fromRGB(150, 150, 150))
	self:setVisible(false)
	Remotes.CompanionEvent:FireClient(self.player, "faint", Stats.displayName(self.def, self.item.level), CC.FaintTime)
end

function Companion:revive()
	self.fainted = false
	self.health = self.maxHealth
	faintMemory[self.player] = nil
	if self.needsRebuild then
		self.needsRebuild = false
		self:buildModel()
	end
	local character = self.player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp then
		self.position = (hrp.CFrame * CFrame.new(3, -2, CC.FollowDistance)).Position
	end
	self:setVisible(true)
	self:updateBar()
	WildService.poof(self.position + Vector3.new(0, 2, 0), Color3.fromRGB(120, 230, 255))
	Remotes.CompanionEvent:FireClient(self.player, "revive", Stats.displayName(self.def, self.item.level))
end

function Companion:destroy()
	self.destroyed = true
	if self.model then
		self.model:Destroy()
		self.model = nil
	end
end

---------------------------------------------------------------------
-- Ataques
---------------------------------------------------------------------
local function projectile(fromPos: Vector3, toPos: Vector3, color: Color3, size: number, onArrive)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * size
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CFrame = CFrame.new(fromPos)
	p.Parent = workspace
	local trail = Instance.new("Trail")
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, size / 3, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -size / 3, 0)
	a1.Parent = p
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(color)
	trail.Lifetime = 0.25
	trail.Parent = p

	local travel = math.clamp((toPos - fromPos).Magnitude / 90, 0.12, 0.5)
	local tween = TweenService:Create(p, TweenInfo.new(travel, Enum.EasingStyle.Linear), { CFrame = CFrame.new(toPos) })
	tween:Play()
	tween.Completed:Connect(function()
		p:Destroy()
		onArrive()
	end)
end

local function shockwave(position: Vector3, radius: number, color: Color3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 2, 2)
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.45), { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.5)
end

function Companion:performMove(move, target)
	local player = self.player
	local damage = self.power * move.power
	local color = Config.getRarity(self.def.rarity).color
	local moveName = Stats.moveName(move, self.def)
	self.lastBasic = os.clock() -- não usa o ataque básico junto

	if move.kind == "Melee" then
		self.phase += 2.5 -- pulinho de ataque
		if move.id ~= "Basico" then
			WildService.floatingText(self.position + Vector3.new(0, self.hipHeight * 2 + 2, 0), moveName .. "!", color)
			WildService.poof(WildService.getPosition(target) + Vector3.new(0, 2, 0), color)
		end
		WildService.damage(target, damage, player, self)
	elseif move.kind == "Projectile" then
		WildService.floatingText(self.position + Vector3.new(0, self.hipHeight * 2 + 2, 0), moveName .. "!", color)
		local fromPos = self.position + Vector3.new(0, self.hipHeight * 1.5, 0)
		local targetPos = WildService.getPosition(target) + Vector3.new(0, target.def.size.Y / 2 + 0.5, 0)
		local size = if move.signature then 2.5 else 1.4
		projectile(fromPos, targetPos, color, size, function()
			if WildService.isAlive(target) then
				if move.signature then
					shockwave(targetPos, 6, color)
				end
				WildService.damage(target, damage, player, if self:isAlive() then self else nil)
			end
		end)
	elseif move.kind == "Area" then
		WildService.floatingText(self.position + Vector3.new(0, self.hipHeight * 2 + 2, 0), moveName .. "!", color)
		shockwave(self.position + Vector3.new(0, 0.3, 0), move.range, color)
		for _, state in ipairs(WildService.getInRadius(self.position, move.range)) do
			WildService.damage(state, damage, player, self)
		end
	end
end

---------------------------------------------------------------------
-- IA (roda todo frame)
---------------------------------------------------------------------
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

local function updateGroundFilter()
	local list = { folder }
	local wild = workspace:FindFirstChild("WildBrainrots")
	if wild then
		table.insert(list, wild)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = list
end

local function holdingBall(player: Player): boolean
	local character = player.Character
	return character ~= nil and character:FindFirstChild("Bola") ~= nil
end

function Companion:update(dt: number, now: number)
	if self.destroyed or not self.model then
		return
	end
	if self.fainted then
		if now >= self.faintedUntil then
			self:revive()
		end
		return
	end

	local player = self.player
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local ownerPos = hrp.Position

	-- regenerar fora de combate
	if self.health < self.maxHealth and now - self.lastDamage > CC.RegenDelay then
		self.health = math.min(self.maxHealth, self.health + self.maxHealth * CC.RegenPercentPerSecond * dt)
		self:updateBar()
	end

	-- validar alvo
	local target = self.target
	if target and (not WildService.isAlive(target) or target.capturing
		or flat(WildService.getPosition(target) - ownerPos).Magnitude > CC.LeashDistance) then
		self.target = nil
		self.queuedMove = nil
		target = nil
	end
	if not target then
		target = WildService.findAggressor(player, self, ownerPos, CC.AutoTargetRadius + 10)
		if not target and player:GetAttribute("AutoBattle") ~= false then
			target = WildService.findNearest(ownerPos, CC.AutoTargetRadius)
		end
		self.target = target
	end

	-- segurando a bola + selvagem com pouca vida = o parceiro espera você capturar
	local holdFire = target ~= nil and holdingBall(player) and target.health / target.maxHealth <= 0.25

	-- longe demais? teleporta para perto do dono
	if flat(self.position - ownerPos).Magnitude > CC.TeleportDistance then
		self.position = (hrp.CFrame * CFrame.new(3, -2, CC.FollowDistance)).Position
	end

	local goal, stopDist
	local speed = math.max(self.def.speed * 1.3, CC.MinSpeed)
	if target and not holdFire then
		goal = WildService.getPosition(target)
		stopDist = BASIC.range * 0.6 + target.def.size.X / 2 + self.radius
	else
		goal = (hrp.CFrame * CFrame.new(3, 0, CC.FollowDistance)).Position
		stopDist = 1.5
		if flat(goal - self.position).Magnitude > 20 then
			speed *= 1.6
		end
	end

	local offset = flat(goal - self.position)
	local dist = offset.Magnitude
	local moving = false
	if dist > stopDist then
		local dir = offset.Unit
		self.position += dir * math.min(speed * dt, dist - stopDist)
		self.yaw = math.atan2(-dir.X, -dir.Z)
		moving = true
	end
	if target then
		local look = flat(WildService.getPosition(target) - self.position)
		if look.Magnitude > 0.1 then
			look = look.Unit
			self.yaw = math.atan2(-look.X, -look.Z)
		end
	end

	-- achar o chão
	local result = workspace:Raycast(
		Vector3.new(self.position.X, ownerPos.Y + 15, self.position.Z), Vector3.new(0, -60, 0), groundParams)
	local groundY = if result then result.Position.Y else ownerPos.Y - 3
	self.position = Vector3.new(self.position.X, groundY, self.position.Z)

	local hop
	if moving then
		self.phase += dt * speed * 0.6
		hop = math.abs(math.sin(self.phase)) * 0.8
	else
		hop = math.abs(math.sin(now * 2 + self.phase)) * 0.15
	end
	self.model:PivotTo(CFrame.new(self.position + Vector3.new(0, self.hipHeight + hop, 0)) * CFrame.Angles(0, self.yaw, 0))

	-- atacar
	if target and not holdFire then
		local targetDist = flat(WildService.getPosition(target) - self.position).Magnitude - target.def.size.X / 2 - self.radius
		local queued = self.queuedMove
		if queued and targetDist <= queued.range then
			self.queuedMove = nil
			self:performMove(queued, target)
		elseif targetDist <= BASIC.range and now - self.lastBasic >= BASIC.cooldown then
			self:performMove(BASIC, target)
		end
	end
end

---------------------------------------------------------------------
-- API
---------------------------------------------------------------------
function CompanionService.get(player: Player)
	return active[player]
end

function CompanionService.spawn(player: Player)
	local data = DataService.get(player)
	if not data or not data.companion then
		return
	end
	local item = DataService.findItem(player, data.companion)
	local def = item and Config.getBrainrot(item.id)
	if not def then
		data.companion = nil
		return
	end

	local old = active[player]
	if old then
		old:destroy()
	end

	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local startPos = if hrp then (hrp.CFrame * CFrame.new(3, -2, CC.FollowDistance)).Position else Vector3.zero

	local comp = setmetatable({
		player = player,
		item = item,
		def = def,
		position = startPos,
		yaw = 0,
		phase = 0,
		lastBasic = 0,
		lastDamage = 0,
		cooldowns = {},
		target = nil,
		queuedMove = nil,
		fainted = false,
		faintedUntil = 0,
		destroyed = false,
	}, Companion)
	comp:refreshStats(true)
	comp:buildModel()
	active[player] = comp

	-- se ele tinha desmaiado há pouco, continua desmaiado
	local memory = faintMemory[player]
	if memory and memory.uid == item.uid and os.clock() < memory.untilTime then
		comp.health = 0
		comp.fainted = true
		comp.faintedUntil = memory.untilTime
		comp:setVisible(false)
		comp:updateBar()
	end
	return comp
end

function CompanionService.summon(player: Player, uid: string)
	local data = DataService.get(player)
	local item = DataService.findItem(player, uid)
	if not data or not item then
		return false, "Brainrot não encontrado."
	end
	if item.slot then
		return false, "Tire ele do pedestal primeiro."
	end
	data.companion = uid
	local comp = CompanionService.spawn(player)
	DataService.pushUpdate(player)
	if not comp then
		return false, "Não deu para chamar o parceiro."
	end
	return true, Stats.displayName(comp.def, item.level) .. " é seu parceiro! ⚔"
end

-- keepData = true quando o jogador sai do jogo (o parceiro volta na próxima vez)
function CompanionService.dismiss(player: Player, keepData: boolean?)
	local comp = active[player]
	if comp then
		comp:destroy()
		active[player] = nil
	end
	if not keepData then
		local data = DataService.get(player)
		if data then
			data.companion = nil
			DataService.pushUpdate(player)
		end
	end
	return true, "Parceiro guardado."
end

-- O jogador bateu em alguém com o taco: o parceiro ataca o mesmo
function CompanionService.setTarget(player: Player, state)
	local comp = active[player]
	if comp and comp:isAlive() and WildService.isAlive(state) then
		comp.target = state
	end
end

function CompanionService.useMove(player: Player, moveId: any, targetModel: any)
	local comp = active[player]
	if not comp then
		return false, "Escolha um parceiro no menu 🎒 Brainrots."
	end
	if not comp:isAlive() then
		return false, "Seu parceiro está desmaiado."
	end
	local move = type(moveId) == "string" and Config.getMove(moveId)
	if not move or move.auto then
		return false, nil
	end
	if comp.item.level < move.level then
		return false, Stats.moveName(move, comp.def) .. " só no nível " .. move.level .. "."
	end
	local now = os.clock()
	if comp.cooldowns[move.id] and now < comp.cooldowns[move.id] then
		return false, nil
	end

	if move.kind == "Area" then
		comp.cooldowns[move.id] = now + move.cooldown
		comp:performMove(move, nil)
		return true, nil
	end

	-- alvo: o que está embaixo do mouse, o atual, ou o mais perto
	local target
	if typeof(targetModel) == "Instance" then
		target = WildService.getStateFromModel(targetModel)
	end
	if target and flat(WildService.getPosition(target) - comp.position).Magnitude > CC.LeashDistance then
		target = nil
	end
	target = target or comp.target or WildService.findNearest(comp.position, math.max(move.range, CC.AutoTargetRadius))
	if not target or not WildService.isAlive(target) or target.capturing then
		return false, "Nenhum brainrot selvagem por perto."
	end

	comp.cooldowns[move.id] = now + move.cooldown
	comp.target = target
	local dist = flat(WildService.getPosition(target) - comp.position).Magnitude - target.def.size.X / 2 - comp.radius
	if dist <= move.range then
		comp:performMove(move, target)
	else
		comp.queuedMove = move -- vai correndo e usa quando chegar perto
	end
	return true, nil
end

-- XP, níveis, novos ataques e evolução
function CompanionService.grantXp(player: Player, amount: number)
	local comp = active[player]
	if not comp or amount <= 0 then
		return
	end
	local item = comp.item
	local maxLevel = Config.Levels.MaxLevel
	if item.level >= maxLevel then
		return
	end

	item.xp += amount
	WildService.floatingText(comp.position + Vector3.new(0, comp.hipHeight * 2 + 3, 0), "+" .. amount .. " XP", Color3.fromRGB(120, 230, 255))

	local oldLevel = item.level
	local oldStage = Stats.stage(oldLevel)
	local oldName = Stats.displayName(comp.def, oldLevel)
	while item.level < maxLevel and item.xp >= Stats.xpToNext(item.level) do
		item.xp -= Stats.xpToNext(item.level)
		item.level += 1
	end
	if item.level >= maxLevel then
		item.xp = 0
	end

	if item.level > oldLevel then
		local newStage = Stats.stage(item.level)
		comp:refreshStats(true)
		if comp.model then
			comp.model:SetAttribute("Level", item.level)
		end

		if comp.fainted then
			comp.needsRebuild = true -- reconstrói quando ele voltar
			comp.health = 0
		end
		if newStage > oldStage then
			if not comp.fainted then
				comp:buildModel() -- modelo maior e com efeitos
			end
			local newName = Stats.displayName(comp.def, item.level)
			Remotes.CompanionEvent:FireClient(player, "evolve", oldName, newName)
			WildService.poof(comp.position + Vector3.new(0, 3, 0), Color3.fromRGB(255, 230, 80))
		elseif not comp.fainted then
			comp:buildModel() -- atualiza o nome/nível na placa
		end

		Remotes.CompanionEvent:FireClient(player, "levelup", Stats.displayName(comp.def, item.level), item.level)
		for _, move in ipairs(Config.Moves) do
			if move.level > oldLevel and move.level <= item.level then
				Remotes.CompanionEvent:FireClient(player, "learn", Stats.moveName(move, comp.def), move.key)
			end
		end
	end
	DataService.pushUpdate(player)
end

function CompanionService.onCaptured(player: Player, state)
	local xp = math.floor(Stats.xpReward(state.def, state.level) * Config.Levels.CaptureXpShare)
	CompanionService.grantXp(player, xp)
end

function CompanionService.start()
	WildService.onDefeated = function(state, player)
		CompanionService.grantXp(player, Stats.xpReward(state.def, state.level))
	end
	WildService.onPlayerAttacked = function(player, state)
		local comp = active[player]
		if comp and comp:isAlive() and not comp.target then
			comp.target = state
		end
	end

	local filterTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		filterTimer -= dt
		if filterTimer <= 0 then
			filterTimer = 1
			updateGroundFilter()
		end
		local now = os.clock()
		for player, comp in pairs(active) do
			local ok, err = pcall(comp.update, comp, dt, now)
			if not ok then
				warn("[CompanionService] erro no parceiro de " .. player.Name .. ": " .. tostring(err))
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		CompanionService.dismiss(player, true)
		faintMemory[player] = nil
	end)
end

return CompanionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Salva e carrega os dados dos jogadores (dinheiro, bolas, brainrots, tacos...).

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(script.Parent.Remotes)

local DataService = {}

local profiles = {} -- [Player] = dados

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponível (no Studio ative 'Enable Studio Access to API Services'). Os dados não serão salvos.")
	end
end

local function deepCopy(t)
	local copy = {}
	for k, v in pairs(t) do
		copy[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return copy
end

local function defaultData()
	return {
		cash = Config.StartingCash,
		balls = deepCopy(Config.StartingBalls),
		bat = "Madeira",
		ownedBats = { Madeira = true },
		inventory = {}, -- lista de { uid = "1", id = "Sapo", level = 1, xp = 0, slot = nil ou número do pedestal }
		-- companion = uid do brainrot parceiro (ou nil)
		unlockedSlots = Config.Tycoon.StartingSlots,
		dex = {}, -- [id] = quantas vezes capturou
		nextUid = 1,
		totalCaught = 0,
	}
end

-- Completa campos que faltam (útil quando você adiciona coisas novas ao jogo)
local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = if type(v) == "table" then deepCopy(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" and k ~= "inventory" then
			reconcile(data[k], v)
		end
	end
end

local function key(player: Player)
	return "player_" .. player.UserId
end

local function setupLeaderstats(player: Player, data)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local cash = Instance.new("IntValue")
	cash.Name = "Dinheiro"
	cash.Value = data.cash
	cash.Parent = leaderstats

	local caught = Instance.new("IntValue")
	caught.Name = "Capturados"
	caught.Value = data.totalCaught
	caught.Parent = leaderstats

	leaderstats.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	leaderstats.Dinheiro.Value = math.floor(data.cash)
	leaderstats.Capturados.Value = data.totalCaught
end

function DataService.load(player: Player)
	local data
	local loadFailed = false

	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			data = result
		else
			loadFailed = true
			warn("[DataService] Falha ao carregar dados de " .. player.Name .. ": " .. tostring(result))
		end
	end

	if type(data) ~= "table" then
		data = defaultData()
	else
		reconcile(data, defaultData())
	end

	-- remove brainrots que não existem mais na Config e completa nível/XP de saves antigos
	local companionFound = false
	for i = #data.inventory, 1, -1 do
		local item = data.inventory[i]
		if not Config.getBrainrot(item.id) then
			table.remove(data.inventory, i)
		else
			item.level = math.clamp(math.floor(tonumber(item.level) or 1), 1, Config.Levels.MaxLevel)
			item.xp = tonumber(item.xp) or 0
			if item.uid == data.companion then
				companionFound = true
				item.slot = nil
			end
		end
	end
	if not companionFound then
		data.companion = nil
	end

	-- se falhou o carregamento, não salva por cima (para não apagar o progresso)
	data._loadFailed = loadFailed
	profiles[player] = data
	setupLeaderstats(player, data)

	if player:GetAttribute("SelectedBall") == nil then
		player:SetAttribute("SelectedBall", "Basica")
	end

	return data
end

function DataService.save(player: Player)
	local data = profiles[player]
	if not data or not store or data._loadFailed then
		return
	end

	local toSave = deepCopy(data)
	toSave._loadFailed = nil

	local ok, err = pcall(function()
		store:SetAsync(key(player), toSave)
	end)
	if not ok then
		warn("[DataService] Falha ao salvar " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.release(player: Player)
	DataService.save(player)
	profiles[player] = nil
end

function DataService.get(player: Player)
	return profiles[player]
end

function DataService.snapshot(player: Player)
	local data = profiles[player]
	if not data then
		return nil
	end
	return {
		cash = data.cash,
		balls = data.balls,
		bat = data.bat,
		ownedBats = data.ownedBats,
		inventory = data.inventory,
		unlockedSlots = data.unlockedSlots,
		dex = data.dex,
		totalCaught = data.totalCaught,
		companion = data.companion,
		autoBattle = player:GetAttribute("AutoBattle") ~= false,
		selectedBall = player:GetAttribute("SelectedBall") or "Basica",
	}
end

function DataService.pushUpdate(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	updateLeaderstats(player, data)
	Remotes.DataUpdated:FireClient(player, DataService.snapshot(player))
end

---------------------------------------------------------------------
-- Dinheiro
---------------------------------------------------------------------
function DataService.addCash(player: Player, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.cash += amount
	DataService.pushUpdate(player)
end

function DataService.spendCash(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or data.cash < amount then
		return false
	end
	data.cash -= amount
	DataService.pushUpdate(player)
	return true
end

---------------------------------------------------------------------
-- Bolas
---------------------------------------------------------------------
function DataService.useBall(player: Player, ballId: string): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	local count = data.balls[ballId] or 0
	if count <= 0 then
		return false
	end
	data.balls[ballId] = count - 1
	DataService.pushUpdate(player)
	return true
end

function DataService.addBalls(player: Player, ballId: string, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.balls[ballId] = (data.balls[ballId] or 0) + amount
	DataService.pushUpdate(player)
end

---------------------------------------------------------------------
-- Brainrots
---------------------------------------------------------------------
function DataService.addBrainrot(player: Player, brainrotId: string, level: number?)
	local data = profiles[player]
	if not data then
		return nil
	end
	local item = { uid = tostring(data.nextUid), id = brainrotId, level = level or 1, xp = 0 }
	data.nextUid += 1
	table.insert(data.inventory, item)
	data.dex[brainrotId] = (data.dex[brainrotId] or 0) + 1
	data.totalCaught += 1
	DataService.pushUpdate(player)
	return item
end

function DataService.findItem(player: Player, uid: string)
	local data = profiles[player]
	if not data then
		return nil, nil
	end
	for i, item in ipairs(data.inventory) do
		if item.uid == uid then
			return item, i
		end
	end
	return nil, nil
end

function DataService.removeBrainrot(player: Player, uid: string)
	local data = profiles[player]
	local item, i = DataService.findItem(player, uid)
	if not item then
		return nil
	end
	table.remove(data.inventory, i)
	if data.companion == uid then
		data.companion = nil
	end
	DataService.pushUpdate(player)
	return item
end

---------------------------------------------------------------------
-- Salvamento automático
---------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(Config.AutoSaveInterval)
		for player in pairs(profiles) do
			task.spawn(DataService.save, player)
		end
	end
end)

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Cria os RemoteEvents/RemoteFunctions usados para servidor <-> jogador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local function get(className, name)
	local remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
	end
	return remote
end

Remotes.ThrowBall = get("RemoteEvent", "ThrowBall") -- jogador -> servidor: posição do mouse
Remotes.DataUpdated = get("RemoteEvent", "DataUpdated") -- servidor -> jogador: dados atualizados
Remotes.Notify = get("RemoteEvent", "Notify") -- servidor -> jogador: mensagem na tela
Remotes.CatchResult = get("RemoteEvent", "CatchResult") -- servidor -> jogador: capturou ou não
Remotes.CompanionEvent = get("RemoteEvent", "CompanionEvent") -- servidor -> jogador: subiu de nível, evoluiu...
Remotes.Action = get("RemoteFunction", "Action") -- jogador -> servidor: comprar, vender, colocar...

function Remotes.notify(player: Player, text: string, color: Color3?)
	Remotes.Notify:FireClient(player, text, color)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Recebe os pedidos da interface do jogador: comprar bolas/tacos, escolher bola,
-- colocar/guardar/vender brainrots e desbloquear pedestais.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local DataService = require(script.Parent.DataService)
local TycoonService = require(script.Parent.TycoonService)
local ToolService = require(script.Parent.ToolService)
local CompanionService = require(script.Parent.CompanionService)
local Stats = require(ReplicatedStorage.Shared.Stats)
local Remotes = require(script.Parent.Remotes)

local ShopService = {}

local fmt = CatchMath.formatNumber
local lastAction = {}

local ALLOWED_AMOUNTS = { [1] = true, [5] = true, [10] = true }

local actions = {}

function actions.GetData(player)
	return true, DataService.snapshot(player)
end

function actions.SelectBall(player, ballId)
	if type(ballId) ~= "string" or not Config.getBall(ballId) then
		return false, "Bola inválida."
	end
	player:SetAttribute("SelectedBall", ballId)
	ToolService.updateBallTool(player)
	DataService.pushUpdate(player)
	return true, nil
end

function actions.BuyBall(player, ballId, amount)
	local ballDef = type(ballId) == "string" and Config.getBall(ballId)
	if not ballDef or not ALLOWED_AMOUNTS[amount] then
		return false, "Compra inválida."
	end
	local price = ballDef.price * amount
	if not DataService.spendCash(player, price) then
		return false, "Você precisa de $" .. fmt(price) .. "."
	end
	DataService.addBalls(player, ballId, amount)
	return true, "Comprou " .. amount .. "x " .. ballDef.name .. "!"
end

function actions.BuyBat(player, batId)
	local batDef = type(batId) == "string" and Config.getBat(batId)
	local data = DataService.get(player)
	if not batDef or not data then
		return false, "Taco inválido."
	end
	if not data.ownedBats[batId] then
		if not DataService.spendCash(player, batDef.price) then
			return false, "Você precisa de $" .. fmt(batDef.price) .. "."
		end
		data.ownedBats[batId] = true
	end
	data.bat = batId
	ToolService.giveTools(player)
	DataService.pushUpdate(player)
	return true, batDef.name .. " equipado!"
end

function actions.Place(player, uid)
	if type(uid) ~= "string" then
		return false, "Inválido."
	end
	return TycoonService.place(player, uid, nil)
end

function actions.Store(player, uid)
	if type(uid) ~= "string" then
		return false, "Inválido."
	end
	return TycoonService.store(player, uid)
end

function actions.Sell(player, uid)
	if type(uid) ~= "string" then
		return false, "Inválido."
	end
	local item = DataService.findItem(player, uid)
	if not item then
		return false, "Brainrot não encontrado."
	end
	local def = Config.getBrainrot(item.id)
	local data = DataService.get(player)
	if data.companion == uid then
		CompanionService.dismiss(player)
	end
	local price = Stats.sellPrice(def, item.level or 1)
	DataService.removeBrainrot(player, uid)
	TycoonService.onItemRemoved(player, item)
	DataService.addCash(player, price)
	return true, "Vendeu " .. Stats.displayName(def, item.level or 1) .. " por $" .. fmt(price) .. "!"
end

-- escolher o parceiro de batalha (tira do pedestal se precisar)
function actions.Summon(player, uid)
	if type(uid) ~= "string" then
		return false, "Inválido."
	end
	local item = DataService.findItem(player, uid)
	if item and item.slot then
		TycoonService.store(player, uid)
	end
	return CompanionService.summon(player, uid)
end

function actions.Dismiss(player)
	return CompanionService.dismiss(player)
end

function actions.UseMove(player, moveId, targetModel)
	return CompanionService.useMove(player, moveId, targetModel)
end

function actions.ToggleAuto(player)
	local on = player:GetAttribute("AutoBattle") == false
	player:SetAttribute("AutoBattle", on)
	DataService.pushUpdate(player)
	return true, if on then "⚔ Modo automático LIGADO: seu parceiro ataca brainrots perto de você." else "Modo automático DESLIGADO: ele só ataca quem você bater ou quem te atacar."
end

function actions.Unlock(player)
	return TycoonService.unlockNext(player)
end

function actions.Home(player)
	TycoonService.teleportHome(player)
	return true, nil
end

function ShopService.start()
	Remotes.Action.OnServerInvoke = function(player, actionName, ...)
		local handler = type(actionName) == "string" and actions[actionName]
		if not handler then
			return false, "Ação desconhecida."
		end
		-- proteção simples contra spam
		local now = os.clock()
		if actionName ~= "GetData" and actionName ~= "UseMove" and lastAction[player] and now - lastAction[player] < 0.15 then
			return false, nil
		end
		if actionName ~= "UseMove" then
			lastAction[player] = now
		end

		if not DataService.get(player) then
			return false, "Carregando seus dados..."
		end
		local ok, okResult, msg = pcall(handler, player, ...)
		if not ok then
			warn("[ShopService] erro em " .. actionName .. ": " .. tostring(okResult))
			return false, "Ocorreu um erro."
		end
		return okResult, msg
	end

	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">ToolService</string><ProtectedString name="Source"><![CDATA[-- Ferramentas: o TACO de beisebol (bater) e a BOLA DE CAPTURA (capturar).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local WildService = require(script.Parent.WildService)
local CompanionService = require(script.Parent.CompanionService)
local Remotes = require(script.Parent.Remotes)

local ToolService = {}

local BAT_NAME = "Taco"
local BALL_NAME = "Bola"
local C = Config.Catch

local lastSwing = {} -- [Player] = os.clock()
local lastThrow = {}

---------------------------------------------------------------------
-- TACO
---------------------------------------------------------------------
local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function createBat(batDef)
	local tool = Instance.new("Tool")
	tool.Name = BAT_NAME
	tool.ToolTip = batDef.name .. " (dano " .. batDef.damage .. ")"
	tool.CanBeDropped = false
	tool:SetAttribute("BatId", batDef.id)
	-- segura igual a espada clássica: o taco aponta para cima
	tool.Grip = CFrame.fromMatrix(Vector3.new(0, 0, -0.8), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.45, 0.45, 2.4)
	handle.Color = batDef.color
	handle.Material = batDef.material
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	-- parte grossa do taco
	local barrel = Instance.new("Part")
	barrel.Name = "Barrel"
	barrel.Shape = Enum.PartType.Cylinder
	barrel.Size = Vector3.new(2.6, 0.8, 0.8)
	barrel.Color = batDef.color
	barrel.Material = batDef.material
	barrel.CanCollide = false
	barrel.Massless = true
	barrel.CFrame = handle.CFrame * CFrame.new(0, 0, 2.4) * CFrame.Angles(0, math.rad(90), 0)
	barrel.Parent = tool
	weld(handle, barrel)

	-- fita do cabo
	local grip = Instance.new("Part")
	grip.Name = "Tape"
	grip.Size = Vector3.new(0.5, 0.5, 1)
	grip.Color = Color3.fromRGB(30, 30, 30)
	grip.Material = Enum.Material.Fabric
	grip.CanCollide = false
	grip.Massless = true
	grip.CFrame = handle.CFrame * CFrame.new(0, 0, -0.8)
	grip.Parent = tool
	weld(handle, grip)

	if batDef.id == "Diamante" or batDef.id == "Ouro" then
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = batDef.color
		sparkle.Parent = barrel
	end

	return tool
end

local function onSwing(player: Player, tool: Tool)
	local data = DataService.get(player)
	if not data then
		return
	end
	local batDef = Config.getBat(data.bat) or Config.Bats[1]
	local now = os.clock()
	if lastSwing[player] and now - lastSwing[player] < batDef.cooldown then
		return
	end
	lastSwing[player] = now

	-- animação de golpe (funciona com o script Animate padrão do Roblox)
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 1)

	local target = WildService.findTargetInFront(player, batDef.range)
	if target then
		WildService.damage(target, batDef.damage, player)
		CompanionService.setTarget(player, target) -- seu parceiro ataca o mesmo brainrot
	end
end

---------------------------------------------------------------------
-- BOLA DE CAPTURA
---------------------------------------------------------------------
local function paintBall(part: BasePart, ballDef)
	part.Color = ballDef.color
	local stripe = part:FindFirstChild("Stripe")
	if stripe then
		stripe.Color = Color3.fromRGB(30, 30, 30)
	end
end

local function makeBallPart(ballDef, size: number)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * size
	ball.Material = Enum.Material.SmoothPlastic
	ball.CanCollide = false
	ball.Massless = true
	ball.TopSurface = Enum.SurfaceType.Smooth
	ball.BottomSurface = Enum.SurfaceType.Smooth

	local stripe = Instance.new("Part")
	stripe.Name = "Stripe"
	stripe.Shape = Enum.PartType.Cylinder
	stripe.Size = Vector3.new(size * 0.15, size * 1.02, size * 1.02)
	stripe.CanCollide = false
	stripe.CanQuery = false
	stripe.CanTouch = false
	stripe.Massless = true
	stripe.CFrame = ball.CFrame * CFrame.Angles(0, 0, math.rad(90))
	stripe.Parent = ball
	weld(ball, stripe)

	local button = Instance.new("Part")
	button.Name = "Button"
	button.Shape = Enum.PartType.Cylinder
	button.Size = Vector3.new(size * 0.1, size * 0.35, size * 0.35)
	button.Color = Color3.new(1, 1, 1)
	button.CanCollide = false
	button.CanQuery = false
	button.CanTouch = false
	button.Massless = true
	button.CFrame = ball.CFrame * CFrame.new(0, 0, -size / 2) * CFrame.Angles(0, math.rad(90), 0)
	button.Parent = ball
	weld(ball, button)

	paintBall(ball, ballDef)
	return ball
end

local function createBallTool(ballDef)
	local tool = Instance.new("Tool")
	tool.Name = BALL_NAME
	tool.ToolTip = "Jogue nos brainrots com POUCA vida!"
	tool.CanBeDropped = false

	local handle = makeBallPart(ballDef, 1.1)
	handle.Name = "Handle"
	handle.Parent = tool
	return tool
end

function ToolService.updateBallTool(player: Player)
	local ballDef = Config.getBall(player:GetAttribute("SelectedBall") or "Basica") or Config.Balls[1]
	for _, container in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
		local tool = container and container:FindFirstChild(BALL_NAME)
		if tool and tool:FindFirstChild("Handle") then
			paintBall(tool.Handle, ballDef)
		end
	end
end

local function shake(ball: BasePart, base: CFrame)
	local info = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	for _, angle in ipairs({ 25, -25, 0 }) do
		local tween = TweenService:Create(ball, info, { CFrame = base * CFrame.Angles(0, 0, math.rad(angle)) })
		tween:Play()
		tween.Completed:Wait()
	end
end

local function attemptCapture(player: Player, state, ball: BasePart, ballDef)
	WildService.setCapturing(state, true)
	local def = state.def
	local rarity = Config.getRarity(def.rarity)
	local chance = WildService.getChance(state, ballDef.multiplier)
	local success = math.random() < chance
	local shakes = if success then 3 else math.random(0, 2)

	local ground = WildService.getPosition(state)
	local base = CFrame.new(ground + Vector3.new(0, ball.Size.Y / 2 + 0.05, 0))
	ball.CFrame = base

	-- flash de luz quando o brainrot entra na bola
	WildService.poof(ground + Vector3.new(0, 2, 0), Color3.new(1, 1, 1))
	task.wait(0.6)

	for _ = 1, shakes do
		shake(ball, base)
		task.wait(0.5)
	end

	if success then
		WildService.poof(base.Position, Color3.fromRGB(255, 230, 80))
		ball:Destroy()
		if WildService.isAlive(state) then
			WildService.removeCaptured(state)
		end
		DataService.addBrainrot(player, def.id, state.level)
		CompanionService.onCaptured(player, state)
		Remotes.CatchResult:FireClient(player, true, def.id, chance, state.level)
	else
		WildService.poof(base.Position, rarity.color)
		ball:Destroy()
		WildService.releaseAfterFail(state, player)
		Remotes.CatchResult:FireClient(player, false, def.id, chance)
	end
end

local function throwBall(player: Player, targetPos: any)
	if typeof(targetPos) ~= "Vector3" then
		return
	end
	local magnitude = targetPos.Magnitude
	if magnitude ~= magnitude or magnitude > 1e5 then -- ignora valores inválidos (NaN/gigantes)
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head or not character:FindFirstChild(BALL_NAME) then
		return
	end

	local now = os.clock()
	if lastThrow[player] and now - lastThrow[player] < C.ThrowCooldown then
		return
	end

	local ballId = player:GetAttribute("SelectedBall") or "Basica"
	local ballDef = Config.getBall(ballId)
	if not ballDef then
		return
	end
	if not DataService.useBall(player, ballId) then
		Remotes.notify(player, "Você não tem " .. ballDef.name .. "! Compre na Loja 🛒", Color3.fromRGB(255, 120, 120))
		return
	end
	lastThrow[player] = now

	-- calcula o arremesso em arco
	local origin = head.Position + Vector3.new(0, 0.5, 0)
	local offset = targetPos - origin
	if offset.Magnitude > C.MaxThrowDistance then
		offset = offset.Unit * C.MaxThrowDistance
	end
	if offset.Magnitude < 1 then
		offset = head.CFrame.LookVector * 10
	end
	local flightTime = offset.Magnitude / C.ThrowSpeed
	local velocity = offset / flightTime + Vector3.new(0, 0.5 * C.Gravity * flightTime, 0)

	local ball = makeBallPart(ballDef, 1.2)
	ball.Name = "ThrownBall"
	ball.Anchored = true
	ball.CanQuery = false
	ball.CFrame = CFrame.new(origin) -- as outras peças da bola estão soldadas e acompanham
	ball.Parent = workspace

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, ball }

	local position = origin
	local elapsed = 0
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		local newVelocity = velocity - Vector3.new(0, C.Gravity * dt, 0)
		local newPosition = position + velocity * dt
		local result = workspace:Raycast(position, newPosition - position, params)

		if result then
			connection:Disconnect()
			local state = WildService.getStateFromPart(result.Instance)
			if state and WildService.isAlive(state) and not state.capturing then
				task.spawn(attemptCapture, player, state, ball, ballDef)
			else
				-- errou: a bola quebra
				WildService.poof(result.Position, ballDef.color)
				ball:Destroy()
			end
			return
		end

		position = newPosition
		velocity = newVelocity
		ball.CFrame = CFrame.new(position) * CFrame.Angles(elapsed * 10, 0, 0)

		if elapsed > 4 then
			connection:Disconnect()
			ball:Destroy()
		end
	end)
end

---------------------------------------------------------------------
-- Dar as ferramentas
---------------------------------------------------------------------
function ToolService.giveTools(player: Player)
	local data = DataService.get(player)
	local backpack = player:FindFirstChild("Backpack")
	if not data or not backpack then
		return
	end

	for _, container in ipairs({ backpack, player.Character }) do
		if container then
			for _, name in ipairs({ BAT_NAME, BALL_NAME }) do
				local old = container:FindFirstChild(name)
				if old then
					old:Destroy()
				end
			end
		end
	end

	local bat = createBat(Config.getBat(data.bat) or Config.Bats[1])
	bat.Activated:Connect(function()
		onSwing(player, bat)
	end)
	bat.Parent = backpack

	local ballDef = Config.getBall(player:GetAttribute("SelectedBall") or "Basica") or Config.Balls[1]
	local ballTool = createBallTool(ballDef)
	ballTool.Parent = backpack
end

function ToolService.start()
	Remotes.ThrowBall.OnServerEvent:Connect(throwBall)
	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
		lastThrow[player] = nil
	end)
end

return ToolService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000E"><Properties><string name="Name">TycoonService</string><ProtectedString name="Source"><![CDATA[-- Bases dos jogadores (o "tycoon"): pedestais onde você coloca seus brainrots
-- capturados. Cada brainrot gera dinheiro por segundo, que vai para o coletor.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local BrainrotModels = require(script.Parent.BrainrotModels)
local Remotes = require(script.Parent.Remotes)

local TycoonService = {}

local T = Config.Tycoon
local fmt = CatchMath.formatNumber

local plotsFolder = Instance.new("Folder")
plotsFolder.Name = "Plots"
plotsFolder.Parent = workspace

local plots = {}
local plotByPlayer = {} -- [Player] = plot

-- posições dos 12 pedestais (frente da base = +Z)
local SLOT_COLUMNS = { -21, -7, 7, 21 }
local SLOT_ROWS = { 6, -8, -22 }
local BASE_TOP = 1
local PEDESTAL_HEIGHT = 2

---------------------------------------------------------------------
-- Construção
---------------------------------------------------------------------
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function billboard(adornee: BasePart, offsetY: number, width: number, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(width, height)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.RichText = true
	label.Parent = gui
	gui.Parent = adornee
	return label
end

local function buildPlot(index: number, info)
	local cf = CFrame.new(info.position) * CFrame.Angles(0, math.rad(info.angle), 0)
	local model = Instance.new("Model")
	model.Name = "Plot" .. index

	local colors = {
		Color3.fromRGB(240, 120, 120), Color3.fromRGB(120, 170, 255), Color3.fromRGB(130, 220, 130),
		Color3.fromRGB(255, 210, 100), Color3.fromRGB(200, 140, 255), Color3.fromRGB(255, 160, 210),
	}
	local color = colors[(index - 1) % #colors + 1]

	part(model, {
		Name = "Base", Size = Vector3.new(T.PlotSize, 1, T.PlotSize), CFrame = cf * CFrame.new(0, 0.5, 0),
		Color = Color3.fromRGB(225, 225, 225), Material = Enum.Material.SmoothPlastic,
	})
	-- borda colorida
	part(model, {
		Name = "Border", Size = Vector3.new(T.PlotSize + 2, 0.8, T.PlotSize + 2), CFrame = cf * CFrame.new(0, 0.3, 0),
		Color = color, Material = Enum.Material.SmoothPlastic,
	})

	-- placa com o nome do dono
	local signBoard = part(model, {
		Name = "OwnerSign", Size = Vector3.new(34, 8, 1), CFrame = cf * CFrame.new(0, 9, -T.PlotSize / 2 + 2),
		Color = color, Material = Enum.Material.SmoothPlastic,
	})
	part(model, {
		Name = "SignPole", Size = Vector3.new(1, 9, 1), CFrame = cf * CFrame.new(-16, 4.5, -T.PlotSize / 2 + 2), Color = color,
	})
	part(model, {
		Name = "SignPole", Size = Vector3.new(1, 9, 1), CFrame = cf * CFrame.new(16, 4.5, -T.PlotSize / 2 + 2), Color = color,
	})
	local signGui = Instance.new("SurfaceGui")
	signGui.Face = Enum.NormalId.Back -- a face de trás (+Z) aponta para a frente da base
	signGui.CanvasSize = Vector2.new(680, 160)
	signGui.LightInfluence = 0
	local signLabel = Instance.new("TextLabel")
	signLabel.Size = UDim2.fromScale(1, 1)
	signLabel.BackgroundTransparency = 1
	signLabel.TextColor3 = Color3.new(1, 1, 1)
	signLabel.TextStrokeTransparency = 0
	signLabel.Font = Enum.Font.FredokaOne
	signLabel.TextScaled = true
	signLabel.Text = "Base livre"
	signLabel.Parent = signGui
	signGui.Parent = signBoard

	-- coletor de dinheiro
	local collector = part(model, {
		Name = "Collector", Size = Vector3.new(10, 0.4, 10), CFrame = cf * CFrame.new(0, BASE_TOP + 0.2, 24),
		Color = Color3.fromRGB(60, 230, 90), Material = Enum.Material.Neon,
	})
	local collectorLabel = billboard(collector, 4, 220, 70)

	local plot = {
		index = index,
		cf = cf,
		model = model,
		owner = nil,
		stored = 0,
		slots = {},
		signLabel = signLabel,
		collector = collector,
		collectorLabel = collectorLabel,
		spawnCF = cf * CFrame.new(0, 4, 32) * CFrame.Angles(0, math.pi, 0),
	}

	-- pedestais
	local n = 0
	for _, z in ipairs(SLOT_ROWS) do
		for _, x in ipairs(SLOT_COLUMNS) do
			n += 1
			if n > T.SlotCount then
				break
			end
			local slotCF = cf * CFrame.new(x, BASE_TOP + PEDESTAL_HEIGHT / 2, z)
			local pedestal = part(model, {
				Name = "Pedestal" .. n, Shape = Enum.PartType.Cylinder, Size = Vector3.new(PEDESTAL_HEIGHT, 8, 8),
				CFrame = slotCF * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(90, 90, 100),
			})
			local prompt = Instance.new("ProximityPrompt")
			prompt.RequiresLineOfSight = false
			prompt.MaxActivationDistance = 10
			prompt.HoldDuration = 0.25
			prompt.Enabled = false
			prompt.Parent = pedestal

			local slot = {
				index = n,
				part = pedestal,
				topCF = cf * CFrame.new(x, BASE_TOP + PEDESTAL_HEIGHT, z) * CFrame.Angles(0, math.pi, 0),
				prompt = prompt,
				label = billboard(pedestal, 6, 200, 50),
				display = nil,
			}
			plot.slots[n] = slot

			prompt.Triggered:Connect(function(player)
				TycoonService.onSlotPrompt(player, plot, slot)
			end)
		end
	end

	-- tocar no coletor
	local debounce = {}
	collector.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player or player ~= plot.owner or debounce[player] then
			return
		end
		debounce[player] = true
		TycoonService.collect(player)
		task.delay(0.5, function()
			debounce[player] = nil
		end)
	end)

	model.Parent = plotsFolder
	return plot
end

---------------------------------------------------------------------
-- Atualizar visual
---------------------------------------------------------------------
local function itemInSlot(data, slotIndex: number)
	for _, item in ipairs(data.inventory) do
		if item.slot == slotIndex then
			return item
		end
	end
	return nil
end

local function refreshSlot(plot, slot)
	if slot.display then
		slot.display:Destroy()
		slot.display = nil
	end

	local owner = plot.owner
	local data = owner and DataService.get(owner)
	local prompt = slot.prompt

	if not data then
		slot.part.Color = Color3.fromRGB(90, 90, 100)
		slot.part.Material = Enum.Material.SmoothPlastic
		slot.label.Text = ""
		prompt.Enabled = false
		return
	end

	if slot.index > data.unlockedSlots then
		local price = T.SlotPrices[slot.index] or 0
		slot.part.Color = Color3.fromRGB(70, 70, 75)
		slot.part.Material = Enum.Material.SmoothPlastic
		if slot.index == data.unlockedSlots + 1 then
			slot.label.Text = "🔒 Desbloquear\n<font color=\"#7CFF7C\">$" .. fmt(price) .. "</font>"
			prompt.ActionText = "Desbloquear"
			prompt.ObjectText = "$" .. fmt(price)
			prompt.Enabled = true
		else
			slot.label.Text = "🔒"
			prompt.Enabled = false
		end
		return
	end

	local item = itemInSlot(data, slot.index)
	slot.part.Material = Enum.Material.Neon
	if item then
		local def = Config.getBrainrot(item.id)
		local rarity = Config.getRarity(def.rarity)
		local level = item.level or 1
		local name = Stats.displayName(def, level)
		slot.part.Color = rarity.color

		local model = BrainrotModels.build(def, 0.9 * Stats.scale(level), Stats.stage(level))
		local hip = model:GetAttribute("HipHeight") or def.size.Y / 2
		model:PivotTo(slot.topCF * CFrame.new(0, hip, 0))
		model.Parent = plot.model
		slot.display = model

		slot.label.Text = name .. " Lv." .. level .. "\n<font color=\"#7CFF7C\">+$" .. fmt(Stats.income(def, level)) .. "/s</font>"
		prompt.ActionText = "Guardar"
		prompt.ObjectText = name
		prompt.Enabled = true
	else
		slot.part.Color = Color3.fromRGB(180, 180, 190)
		slot.label.Text = "Vazio"
		prompt.ActionText = "Colocar Brainrot"
		prompt.ObjectText = "Pedestal " .. slot.index
		prompt.Enabled = true
	end
	slot.label.Parent.StudsOffsetWorldSpace = Vector3.new(0, if item then 8 * Stats.scale(item.level or 1) else 3, 0)
end

local function refreshPlot(plot)
	for _, slot in ipairs(plot.slots) do
		refreshSlot(plot, slot)
	end
	if plot.owner then
		plot.signLabel.Text = "Base de " .. plot.owner.DisplayName
	else
		plot.signLabel.Text = "Base livre"
	end
end

local function getIncome(player: Player): number
	local data = DataService.get(player)
	if not data then
		return 0
	end
	local total = 0
	for _, item in ipairs(data.inventory) do
		if item.slot then
			local def = Config.getBrainrot(item.id)
			if def then
				total += Stats.income(def, item.level or 1)
			end
		end
	end
	return total
end

local function updateCollectorLabel(plot)
	if plot.owner then
		plot.collectorLabel.Text = "💰 $" .. fmt(plot.stored) .. "\n<font color=\"#BFFFBF\">+$" .. fmt(getIncome(plot.owner)) .. "/s  (pise aqui)</font>"
	else
		plot.collectorLabel.Text = ""
	end
end

---------------------------------------------------------------------
-- Ações do jogador
---------------------------------------------------------------------
function TycoonService.getPlot(player: Player)
	return plotByPlayer[player]
end

function TycoonService.getIncome(player: Player): number
	return getIncome(player)
end

function TycoonService.refreshPlayer(player: Player)
	local plot = plotByPlayer[player]
	if plot then
		refreshPlot(plot)
		updateCollectorLabel(plot)
	end
end

function TycoonService.collect(player: Player)
	local plot = plotByPlayer[player]
	if not plot or plot.stored < 1 then
		return
	end
	local amount = math.floor(plot.stored)
	plot.stored -= amount
	DataService.addCash(player, amount)
	Remotes.notify(player, "Coletou $" .. fmt(amount) .. "!", Color3.fromRGB(100, 255, 120))
	updateCollectorLabel(plot)
end

function TycoonService.unlockNext(player: Player)
	local data = DataService.get(player)
	if not data then
		return false, "Dados não carregados"
	end
	local nextIndex = data.unlockedSlots + 1
	if nextIndex > T.SlotCount then
		return false, "Todos os pedestais já foram desbloqueados!"
	end
	local price = T.SlotPrices[nextIndex] or 0
	if not DataService.spendCash(player, price) then
		return false, "Você precisa de $" .. fmt(price) .. " para desbloquear."
	end
	data.unlockedSlots = nextIndex
	TycoonService.refreshPlayer(player)
	DataService.pushUpdate(player)
	return true, "Pedestal " .. nextIndex .. " desbloqueado!"
end

-- Coloca um brainrot do inventário em um pedestal (o primeiro livre se slotIndex for nil)
function TycoonService.place(player: Player, uid: string?, slotIndex: number?)
	local data = DataService.get(player)
	local plot = plotByPlayer[player]
	if not data or not plot then
		return false, "Você não tem uma base."
	end

	local item
	if uid then
		item = DataService.findItem(player, uid)
		if not item then
			return false, "Brainrot não encontrado."
		end
		if item.slot then
			return false, "Esse brainrot já está em um pedestal."
		end
		if item.uid == data.companion then
			return false, "Esse é o seu parceiro de batalha! Guarde ele antes."
		end
	else
		-- escolhe o que dá mais dinheiro (menos o parceiro)
		local bestIncome = -1
		for _, candidate in ipairs(data.inventory) do
			local def = Config.getBrainrot(candidate.id)
			local income = def and Stats.income(def, candidate.level or 1)
			if not candidate.slot and candidate.uid ~= data.companion and def and income > bestIncome then
				item, bestIncome = candidate, income
			end
		end
		if not item then
			return false, "Você não tem brainrots guardados. Vá caçar na Zona de Caça!"
		end
	end

	if not slotIndex then
		for i = 1, data.unlockedSlots do
			if not itemInSlot(data, i) then
				slotIndex = i
				break
			end
		end
		if not slotIndex then
			return false, "Todos os pedestais estão ocupados. Desbloqueie mais!"
		end
	elseif slotIndex > data.unlockedSlots or itemInSlot(data, slotIndex) then
		return false, "Esse pedestal não está disponível."
	end

	item.slot = slotIndex
	refreshSlot(plot, plot.slots[slotIndex])
	updateCollectorLabel(plot)
	DataService.pushUpdate(player)
	return true, Stats.displayName(Config.getBrainrot(item.id), item.level or 1) .. " colocado no pedestal " .. slotIndex .. "!"
end

function TycoonService.store(player: Player, uid: string)
	local item = DataService.findItem(player, uid)
	local plot = plotByPlayer[player]
	if not item or not item.slot then
		return false, "Esse brainrot não está em um pedestal."
	end
	local slotIndex = item.slot
	item.slot = nil
	if plot then
		refreshSlot(plot, plot.slots[slotIndex])
		updateCollectorLabel(plot)
	end
	DataService.pushUpdate(player)
	return true, Stats.displayName(Config.getBrainrot(item.id), item.level or 1) .. " guardado."
end

-- Chamado quando um brainrot é vendido (pode estar em um pedestal)
function TycoonService.onItemRemoved(player: Player, item)
	local plot = plotByPlayer[player]
	if plot and item.slot and plot.slots[item.slot] then
		refreshSlot(plot, plot.slots[item.slot])
		updateCollectorLabel(plot)
	end
end

function TycoonService.onSlotPrompt(player: Player, plot, slot)
	if plot.owner ~= player then
		Remotes.notify(player, "Essa base não é sua!", Color3.fromRGB(255, 90, 90))
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end

	local ok, msg
	if slot.index > data.unlockedSlots then
		ok, msg = TycoonService.unlockNext(player)
	else
		local item = itemInSlot(data, slot.index)
		if item then
			ok, msg = TycoonService.store(player, item.uid)
		else
			ok, msg = TycoonService.place(player, nil, slot.index)
		end
	end
	if msg then
		Remotes.notify(player, msg, if ok then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 120, 120))
	end
end

---------------------------------------------------------------------
-- Entrar / sair
---------------------------------------------------------------------
function TycoonService.assign(player: Player)
	local data = DataService.get(player)
	for _, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = player
			plot.stored = 0
			plotByPlayer[player] = plot

			-- conserta dados inválidos (pedestais repetidos ou bloqueados)
			if data then
				local used = {}
				for _, item in ipairs(data.inventory) do
					if item.slot then
						if item.slot > data.unlockedSlots or used[item.slot] then
							item.slot = nil
						else
							used[item.slot] = true
						end
					end
				end
			end

			refreshPlot(plot)
			updateCollectorLabel(plot)
			return plot
		end
	end
	Remotes.notify(player, "Todas as bases estão ocupadas neste servidor :(", Color3.fromRGB(255, 120, 120))
	return nil
end

function TycoonService.release(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	-- dinheiro que ficou no coletor vai para o jogador antes de salvar
	local data = DataService.get(player)
	if data and plot.stored >= 1 then
		data.cash += math.floor(plot.stored)
	end
	plotByPlayer[player] = nil
	plot.owner = nil
	plot.stored = 0
	refreshPlot(plot)
	updateCollectorLabel(plot)
end

function TycoonService.teleportHome(player: Player)
	local plot = plotByPlayer[player]
	local character = player.Character
	if plot and character then
		character:PivotTo(plot.spawnCF)
	end
end

function TycoonService.start()
	for i, info in ipairs(T.Plots) do
		plots[i] = buildPlot(i, info)
		refreshPlot(plots[i])
	end

	-- renda passiva
	task.spawn(function()
		while true do
			task.wait(T.IncomeTick)
			for _, plot in ipairs(plots) do
				if plot.owner then
					plot.stored += getIncome(plot.owner) * T.IncomeTick
					updateCollectorLabel(plot)
				end
			end
		end
	end)
end

return TycoonService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000F"><Properties><string name="Name">WildService</string><ProtectedString name="Source"><![CDATA[-- Brainrots selvagens: nascem na zona de caça, andam, apanham do taco,
-- ficam bravos e atacam, regeneram vida e desmaiam se a vida zerar.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Stats = require(ReplicatedStorage.Shared.Stats)
local BrainrotModels = require(script.Parent.BrainrotModels)
local DataService = require(script.Parent.DataService)
local Remotes = require(script.Parent.Remotes)

local WildService = {}

-- Ganchos preenchidos pelo CompanionService (evita require circular)
WildService.onDefeated = nil -- function(state, player)
WildService.onPlayerAttacked = nil -- function(player, state)

local WILD = Config.Wild
local folder = Instance.new("Folder")
folder.Name = "WildBrainrots"
folder.Parent = workspace

local states = {} -- [Model] = estado
local count = 0
local rng = Random.new()

---------------------------------------------------------------------
-- Utilidades
---------------------------------------------------------------------
local function randomZonePoint(): Vector3
	local c = WILD.ZoneCenter
	local hx, hz = WILD.ZoneSize.X / 2 - 6, WILD.ZoneSize.Y / 2 - 6
	return Vector3.new(c.X + rng:NextNumber(-hx, hx), WILD.GroundY, c.Z + rng:NextNumber(-hz, hz))
end

local function clampToZone(p: Vector3): Vector3
	local c = WILD.ZoneCenter
	local hx, hz = WILD.ZoneSize.X / 2 - 3, WILD.ZoneSize.Y / 2 - 3
	return Vector3.new(math.clamp(p.X, c.X - hx, c.X + hx), WILD.GroundY, math.clamp(p.Z, c.Z - hz, c.Z + hz))
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function pickRandomDef()
	local total = 0
	for _, name in ipairs(Config.RarityOrder) do
		total += Config.Rarities[name].spawnWeight
	end
	local roll = rng:NextNumber(0, total)
	local chosen = Config.RarityOrder[1]
	for _, name in ipairs(Config.RarityOrder) do
		roll -= Config.Rarities[name].spawnWeight
		if roll <= 0 then
			chosen = name
			break
		end
	end
	local options = {}
	for _, def in ipairs(Config.Brainrots) do
		if def.rarity == chosen then
			table.insert(options, def)
		end
	end
	if #options == 0 then
		return Config.Brainrots[rng:NextInteger(1, #Config.Brainrots)]
	end
	return options[rng:NextInteger(1, #options)]
end

---------------------------------------------------------------------
-- Barra de vida
---------------------------------------------------------------------
local function createBillboard(state)
	local def = state.def
	local rarity = Config.getRarity(def.rarity)

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.fromOffset(180, 56)
	gui.StudsOffsetWorldSpace = Vector3.new(0, def.size.Y / 2 + 3, 0)
	gui.MaxDistance = 110
	gui.LightInfluence = 0
	gui.Adornee = state.model.PrimaryPart

	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, 0, 20)
	name.BackgroundTransparency = 1
	name.Text = def.name .. "  Lv." .. state.level
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.3
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.Parent = gui

	local rarityLabel = Instance.new("TextLabel")
	rarityLabel.Position = UDim2.fromOffset(0, 20)
	rarityLabel.Size = UDim2.new(1, 0, 0, 16)
	rarityLabel.BackgroundTransparency = 1
	rarityLabel.Text = rarity.display
	rarityLabel.TextColor3 = rarity.color
	rarityLabel.TextStrokeTransparency = 0.3
	rarityLabel.Font = Enum.Font.GothamBold
	rarityLabel.TextScaled = true
	rarityLabel.Parent = gui

	local back = Instance.new("Frame")
	back.Name = "HealthBack"
	back.Position = UDim2.fromOffset(15, 40)
	back.Size = UDim2.new(1, -30, 0, 12)
	back.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	back.BorderSizePixel = 0
	back.Parent = gui
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 6)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(80, 220, 80)
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)

	local hpText = Instance.new("TextLabel")
	hpText.Name = "HpText"
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.BackgroundTransparency = 1
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.TextStrokeTransparency = 0.2
	hpText.Font = Enum.Font.GothamBold
	hpText.TextScaled = true
	hpText.ZIndex = 2
	hpText.Parent = back

	gui.Parent = state.model
	state.gui = gui
	state.fill = fill
	state.hpText = hpText
end

local function updateHealthBar(state)
	local ratio = math.clamp(state.health / state.maxHealth, 0, 1)
	state.fill.Size = UDim2.fromScale(ratio, 1)
	if ratio > 0.5 then
		state.fill.BackgroundColor3 = Color3.fromRGB(80, 220, 80)
	elseif ratio > 0.2 then
		state.fill.BackgroundColor3 = Color3.fromRGB(255, 200, 40)
	else
		state.fill.BackgroundColor3 = Color3.fromRGB(240, 60, 60)
	end
	state.hpText.Text = math.ceil(state.health) .. " / " .. state.maxHealth
	state.model:SetAttribute("Health", state.health)
end

---------------------------------------------------------------------
-- Efeitos
---------------------------------------------------------------------
local function floatingText(position: Vector3, text: string, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = workspace

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 40)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Parent = gui

	TweenService:Create(anchor, TweenInfo.new(0.9), { CFrame = CFrame.new(position + Vector3.new(0, 4, 0)) }):Play()
	TweenService:Create(label, TweenInfo.new(0.9), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1)
end

WildService.floatingText = floatingText

function WildService.poof(position: Vector3, color: Color3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = CFrame.new(position)
	p.Parent = workspace
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.LightEmission = 0.6
	emitter.Parent = p
	emitter:Emit(35)
	Debris:AddItem(p, 1.5)
end

local function flash(state)
	local h = Instance.new("Highlight")
	h.FillColor = Color3.fromRGB(255, 60, 60)
	h.FillTransparency = 0.3
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = state.model
	Debris:AddItem(h, 0.15)
end

---------------------------------------------------------------------
-- Ciclo de vida
---------------------------------------------------------------------
local function spawnOne()
	local def = pickRandomDef()
	local range = Config.getRarity(def.rarity).wildLevels or { 1, 1 }
	local level = rng:NextInteger(range[1], range[2])
	local maxHealth = Stats.maxHealth(def, level, 1)
	local model = BrainrotModels.build(def, 1)
	local state = {
		def = def,
		model = model,
		level = level,
		maxHealth = maxHealth,
		power = Stats.power(def, level, 1),
		health = maxHealth,
		position = randomZonePoint(),
		yaw = rng:NextNumber(0, math.pi * 2),
		target = nil,
		idleUntil = 0,
		lastDamage = 0,
		lastAttack = 0,
		aggroPlayer = nil,
		aggroCompanion = nil,
		aggroUntil = 0,
		capturing = false,
		hipHeight = model:GetAttribute("HipHeight") or def.size.Y / 2,
		phase = rng:NextNumber(0, 10),
		transparency = {},
	}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			state.transparency[d] = d.Transparency
		end
	end

	model:SetAttribute("BrainrotId", def.id)
	model:SetAttribute("Level", level)
	model:SetAttribute("MaxHealth", maxHealth)
	model:SetAttribute("Health", maxHealth)
	model:PivotTo(CFrame.new(state.position + Vector3.new(0, state.hipHeight, 0)) * CFrame.Angles(0, state.yaw, 0))
	model.Parent = folder
	createBillboard(state)
	updateHealthBar(state)

	states[model] = state
	count += 1
	WildService.poof(state.position + Vector3.new(0, 2, 0), Config.getRarity(def.rarity).color)
	return state
end

local function despawn(state)
	if not states[state.model] then
		return
	end
	states[state.model] = nil
	count -= 1
	state.model:Destroy()
end

local function faint(state, player: Player?)
	local def = state.def
	local rarity = Config.getRarity(def.rarity)
	WildService.poof(state.model:GetPivot().Position, rarity.color)
	despawn(state)
	if player then
		local reward = math.floor(rarity.faintReward * (1 + 0.25 * (state.level - 1)))
		DataService.addCash(player, reward)
		Remotes.notify(player, def.name .. " Lv." .. state.level .. " foi derrotado! +$" .. reward, Color3.fromRGB(255, 170, 60))
		if WildService.onDefeated then
			task.spawn(WildService.onDefeated, state, player)
		end
	end
end

---------------------------------------------------------------------
-- API usada pelo taco e pelas bolas
---------------------------------------------------------------------
function WildService.getStateFromPart(part: Instance)
	local model = part
	while model and model.Parent ~= folder do
		model = model.Parent
	end
	if model then
		return states[model]
	end
	return nil
end

function WildService.isAlive(state): boolean
	return state ~= nil and states[state.model] == state
end

-- Acha o brainrot mais perto na frente do jogador
function WildService.findTargetInFront(player: Player, range: number)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	local best, bestDist = nil, math.huge
	for _, state in pairs(states) do
		if not state.capturing then
			local pos = state.model:GetPivot().Position
			local offset = flat(pos - hrp.Position)
			local dist = offset.Magnitude - state.def.size.X / 2
			if dist <= range and math.abs(pos.Y - hrp.Position.Y) < 12 then
				local facing = offset.Magnitude < 0.1 or flat(hrp.CFrame.LookVector).Unit:Dot(offset.Unit) > 0.2
				if facing and dist < bestDist then
					best, bestDist = state, dist
				end
			end
		end
	end
	return best
end

-- companion = o parceiro que bateu (ou nil se foi o taco do jogador)
function WildService.damage(state, amount: number, player: Player?, companion: any?)
	if not WildService.isAlive(state) or state.capturing then
		return
	end
	amount = math.max(1, math.floor(amount + 0.5))
	state.health -= amount
	state.lastDamage = os.clock()
	flash(state)
	floatingText(state.model:GetPivot().Position + Vector3.new(0, state.def.size.Y / 2 + 1, 0), "-" .. amount, Color3.fromRGB(255, 80, 80))

	if state.health <= 0 then
		state.health = 0
		faint(state, player)
		return
	end
	updateHealthBar(state)

	-- fica bravo com quem bateu e é empurrado para trás
	local sourcePosition
	if companion and companion:isAlive() then
		state.aggroCompanion = companion
		state.aggroPlayer = nil
		state.aggroUntil = os.clock() + WILD.AggroTime
		sourcePosition = companion:getPosition()
	elseif player then
		state.aggroPlayer = player
		state.aggroCompanion = nil
		state.aggroUntil = os.clock() + WILD.AggroTime
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		sourcePosition = hrp and hrp.Position
	end
	if sourcePosition then
		local away = flat(state.position - sourcePosition)
		if away.Magnitude > 0.1 then
			state.position = clampToZone(state.position + away.Unit * WILD.Knockback)
		end
	end
end

function WildService.getChance(state, ballMultiplier: number): number
	return CatchMath.getChance(state.def.catchRate, state.health, state.maxHealth, ballMultiplier)
end

-- Some/aparece enquanto está dentro da bola
function WildService.setCapturing(state, capturing: boolean)
	state.capturing = capturing
	for part, original in pairs(state.transparency) do
		if part.Parent then
			part.Transparency = if capturing then 1 else original
		end
	end
	if state.gui then
		state.gui.Enabled = not capturing
	end
end

function WildService.releaseAfterFail(state, player: Player?)
	if not WildService.isAlive(state) then
		return
	end
	WildService.setCapturing(state, false)
	if player then
		state.aggroPlayer = player
		state.aggroCompanion = nil
		state.aggroUntil = os.clock() + WILD.AggroTime
	end
end

function WildService.removeCaptured(state)
	despawn(state)
end

function WildService.getPosition(state): Vector3
	return state.position
end

-- Todos os selvagens perto de um ponto (para ataques em área)
function WildService.getInRadius(position: Vector3, radius: number)
	local list = {}
	for _, state in pairs(states) do
		if not state.capturing then
			local dist = flat(state.position - position).Magnitude - state.def.size.X / 2
			if dist <= radius then
				table.insert(list, state)
			end
		end
	end
	return list
end

function WildService.findNearest(position: Vector3, radius: number)
	local best, bestDist = nil, math.huge
	for _, state in pairs(states) do
		if not state.capturing then
			local dist = flat(state.position - position).Magnitude
			if dist <= radius and dist < bestDist then
				best, bestDist = state, dist
			end
		end
	end
	return best
end

-- Selvagem que está atacando esse jogador ou o parceiro dele
function WildService.findAggressor(player: Player, companion: any?, position: Vector3, radius: number)
	local now = os.clock()
	local best, bestDist = nil, math.huge
	for _, state in pairs(states) do
		if not state.capturing and now <= state.aggroUntil
			and (state.aggroPlayer == player or (companion and state.aggroCompanion == companion)) then
			local dist = flat(state.position - position).Magnitude
			if dist <= radius and dist < bestDist then
				best, bestDist = state, dist
			end
		end
	end
	return best
end

function WildService.getStateFromModel(model: Instance)
	return states[model]
end

---------------------------------------------------------------------
-- Movimento e IA
---------------------------------------------------------------------
-- Retorna (posição do alvo, função que dá dano) ou nil
local function getAggroTarget(state)
	if os.clock() > state.aggroUntil then
		state.aggroPlayer = nil
		state.aggroCompanion = nil
		return nil
	end
	local companion = state.aggroCompanion
	if companion then
		if companion:isAlive() then
			return companion:getPosition(), function(amount)
				companion:takeDamage(amount, state)
			end
		end
		state.aggroCompanion = nil
		return nil
	end
	if not state.aggroPlayer then
		return nil
	end
	local player = state.aggroPlayer
	if player.Parent ~= Players then
		state.aggroPlayer = nil
		return nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not hrp then
		state.aggroPlayer = nil
		return nil
	end
	return hrp.Position, function(amount)
		humanoid:TakeDamage(state.def.damage)
		if WildService.onPlayerAttacked then
			task.spawn(WildService.onPlayerAttacked, player, state)
		end
	end
end

local function step(state, dt: number, now: number)
	if state.capturing then
		return
	end
	local def = state.def

	-- regenerar
	if state.health < state.maxHealth and now - state.lastDamage > WILD.RegenDelay then
		state.health = math.min(state.maxHealth, state.health + state.maxHealth * WILD.RegenPercentPerSecond * dt)
		updateHealthBar(state)
	end

	local goal
	local speed = def.speed
	local targetPosition, hitTarget = getAggroTarget(state)
	local chasing = targetPosition ~= nil
	if targetPosition then
		goal = clampToZone(targetPosition)
		speed = def.speed * 1.15
		local dist = flat(targetPosition - state.position).Magnitude
		if dist <= WILD.AttackRange + def.size.X / 2 and now - state.lastAttack >= WILD.AttackCooldown then
			state.lastAttack = now
			hitTarget(state.power)
			state.phase += 2 -- pulinho de ataque
		end
	else
		if now < state.idleUntil then
			goal = nil
		elseif not state.target or flat(state.target - state.position).Magnitude < 2 then
			if state.target and rng:NextNumber() < 0.4 then
				state.idleUntil = now + rng:NextNumber(1, 3)
				state.target = nil
			else
				state.target = randomZonePoint()
			end
		end
		goal = if now < state.idleUntil then nil else state.target
	end

	local moving = false
	if goal then
		local offset = flat(goal - state.position)
		local dist = offset.Magnitude
		local stopDist = if chasing then 2.5 else 0.1
		if dist > stopDist then
			local dir = offset.Unit
			state.position = clampToZone(state.position + dir * math.min(speed * dt, dist - stopDist))
			state.yaw = math.atan2(-dir.X, -dir.Z)
			moving = true
		elseif chasing and dist > 0.01 then
			local dir = offset.Unit
			state.yaw = math.atan2(-dir.X, -dir.Z)
		end
	end

	local hop = 0
	if moving then
		state.phase += dt * speed * 0.6
		hop = math.abs(math.sin(state.phase)) * 0.8
	else
		hop = math.abs(math.sin(now * 2 + state.phase)) * 0.15
	end
	local cf = CFrame.new(state.position + Vector3.new(0, state.hipHeight + hop, 0)) * CFrame.Angles(0, state.yaw, 0)
	state.model:PivotTo(cf)
end

---------------------------------------------------------------------
-- Iniciar
---------------------------------------------------------------------
function WildService.start()
	for _ = 1, math.floor(WILD.MaxAlive / 2) do
		spawnOne()
	end

	task.spawn(function()
		while true do
			task.wait(WILD.SpawnInterval)
			if count < WILD.MaxAlive then
				spawnOne()
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, state in pairs(states) do
			local ok, err = pcall(step, state, dt, now)
			if not ok then
				warn("[WildService] erro no brainrot " .. state.def.id .. ": " .. tostring(err))
				despawn(state)
			end
		end
	end)
end

return WildService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000010"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- Constrói o mapa básico: chão, zona de caça (com árvores) e o ponto de spawn.
-- As bases (tycoons) são construídas pelo TycoonService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)

local WorldBuilder = {}

local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function sign(parent, cf: CFrame, text: string, color: Color3)
	local board = part(parent, {
		Name = "Sign", Size = Vector3.new(30, 7, 1), CFrame = cf,
		Color = Color3.fromRGB(60, 40, 25), Material = Enum.Material.Wood,
	})
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.CanvasSize = Vector2.new(600, 140)
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = color
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.Parent = gui
		gui.Parent = board
	end
	for _, side in ipairs({ -1, 1 }) do
		part(parent, {
			Name = "SignPost", Size = Vector3.new(1, cf.Position.Y + 3.5, 1),
			CFrame = CFrame.new((cf * CFrame.new(side * 13, 0, 0)).Position * Vector3.new(1, 0, 1) + Vector3.new(0, (cf.Position.Y + 3.5) / 2, 0)),
			Color = Color3.fromRGB(60, 40, 25), Material = Enum.Material.Wood,
		})
	end
	return board
end

local function tree(parent, pos: Vector3)
	local height = math.random(8, 14)
	part(parent, {
		Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 2, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(105, 70, 40), Material = Enum.Material.Wood,
	})
	local leafSize = math.random(7, 10)
	part(parent, {
		Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * leafSize,
		CFrame = CFrame.new(pos + Vector3.new(0, height + leafSize / 3, 0)),
		Color = Color3.fromRGB(math.random(40, 70), math.random(140, 180), math.random(40, 70)),
		Material = Enum.Material.Grass,
	})
end

function WorldBuilder.build()
	if not Config.BuildMap then
		return
	end
	if workspace:FindFirstChild("Map") then
		workspace.Map:Destroy()
	end

	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace

	-- remove a Baseplate padrão, se existir
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	-- CHÃO
	part(map, {
		Name = "Ground", Size = Vector3.new(620, 4, 620), CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(110, 170, 90), Material = Enum.Material.Grass,
	})

	-- ZONA DE CAÇA
	local zone = Config.Wild
	local center = zone.ZoneCenter
	part(map, {
		Name = "HuntZone", Size = Vector3.new(zone.ZoneSize.X, 1, zone.ZoneSize.Y),
		CFrame = CFrame.new(center.X, zone.GroundY - 0.45, center.Z),
		Color = Color3.fromRGB(70, 140, 60), Material = Enum.Material.Grass,
	})

	-- cerquinha (postes) em volta da zona
	local halfX, halfZ = zone.ZoneSize.X / 2, zone.ZoneSize.Y / 2
	local step = 10
	for x = -halfX, halfX, step do
		for _, z in ipairs({ -halfZ, halfZ }) do
			if math.abs(x) > 12 then -- deixa uma entrada no meio
				part(map, {
					Name = "Post", Size = Vector3.new(1, 3, 1), CFrame = CFrame.new(center.X + x, 1.5, center.Z + z),
					Color = Color3.fromRGB(150, 110, 70), Material = Enum.Material.Wood,
				})
			end
		end
	end
	for z = -halfZ + step, halfZ - step, step do
		for _, x in ipairs({ -halfX, halfX }) do
			if math.abs(z) > 12 then
				part(map, {
					Name = "Post", Size = Vector3.new(1, 3, 1), CFrame = CFrame.new(center.X + x, 1.5, center.Z + z),
					Color = Color3.fromRGB(150, 110, 70), Material = Enum.Material.Wood,
				})
			end
		end
	end

	-- árvores dentro da zona
	local rng = Random.new(42)
	for _ = 1, 18 do
		local pos = Vector3.new(
			center.X + rng:NextNumber(-halfX + 10, halfX - 10),
			zone.GroundY,
			center.Z + rng:NextNumber(-halfZ + 10, halfZ - 10)
		)
		if pos.Magnitude > 20 then
			tree(map, pos)
		end
	end

	-- placas
	sign(map, CFrame.new(center.X, 8, center.Z + halfZ + 4), "🏏 ZONA DE CAÇA 🏏", Color3.fromRGB(255, 230, 80))
	sign(map, CFrame.new(center.X, 8, center.Z - halfZ - 4) * CFrame.Angles(0, math.rad(180), 0), "🏏 ZONA DE CAÇA 🏏", Color3.fromRGB(255, 230, 80))

	-- SPAWN
	local spawnLocation = workspace:FindFirstChildOfClass("SpawnLocation")
	if not spawnLocation then
		spawnLocation = Instance.new("SpawnLocation")
		spawnLocation.Parent = map
	end
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.CFrame = CFrame.new(-250, 0.5, 0)
	spawnLocation.Neutral = true
	spawnLocation.Duration = 3

	-- iluminação mais bonita
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 150)
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000000000000000000000000000017"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000000000000000000000000000016"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000015"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX00000000000000000000000000000014"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Interface do jogador + arremesso da bola.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CatchMath = require(Shared:WaitForChild("CatchMath"))
local Stats = require(Shared:WaitForChild("Stats"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ThrowBall = Remotes:WaitForChild("ThrowBall")
local DataUpdated = Remotes:WaitForChild("DataUpdated")
local Notify = Remotes:WaitForChild("Notify")
local CatchResult = Remotes:WaitForChild("CatchResult")
local CompanionEvent = Remotes:WaitForChild("CompanionEvent")
local Action = Remotes:WaitForChild("Action")

local fmt = CatchMath.formatNumber
local data = nil -- última cópia dos dados vinda do servidor

local GREEN = Color3.fromRGB(110, 230, 120)
local RED = Color3.fromRGB(255, 110, 110)
local DARK = Color3.fromRGB(28, 30, 40)
local DARK2 = Color3.fromRGB(45, 48, 62)

---------------------------------------------------------------------
-- Funções para criar interface
---------------------------------------------------------------------
local function new(className: string, props)
	local inst = Instance.new(className)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 10), Parent = parent })
end

local function stroke(parent, color, thickness)
	return new("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function label(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextScaled = if props.TextScaled == nil then true else props.TextScaled
	return new("TextLabel", props)
end

local function button(props)
	props.BackgroundColor3 = props.BackgroundColor3 or Color3.fromRGB(70, 140, 255)
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	props.Font = props.Font or Enum.Font.FredokaOne
	props.TextScaled = true
	props.AutoButtonColor = true
	local b = new("TextButton", props)
	corner(b, 8)
	new("UIPadding", {
		PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = b,
	})
	return b
end

local gui = new("ScreenGui", {
	Name = "BrainrotUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

---------------------------------------------------------------------
-- Notificações
---------------------------------------------------------------------
local toastList = new("Frame", {
	Name = "Toasts", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 70),
	Size = UDim2.new(0.6, 0, 0, 300), BackgroundTransparency = 1, Parent = gui,
})
new("UIListLayout", {
	HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6),
	SortOrder = Enum.SortOrder.LayoutOrder, Parent = toastList,
})
new("UISizeConstraint", { MaxSize = Vector2.new(600, 300), Parent = toastList })

local toastOrder = 0
local function toast(text: string, color: Color3?)
	toastOrder += 1
	local frame = new("Frame", {
		Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = DARK, BackgroundTransparency = 0.15,
		LayoutOrder = toastOrder, Parent = toastList,
	})
	corner(frame, 8)
	local s = stroke(frame, color or Color3.new(1, 1, 1), 2)
	local l = label({
		Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4),
		Text = text, TextColor3 = color or Color3.new(1, 1, 1), Parent = frame,
	})
	-- no máximo 5 na tela
	local children = {}
	for _, child in ipairs(toastList:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(children, child)
		end
	end
	if #children > 5 then
		table.sort(children, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		children[1]:Destroy()
	end
	task.delay(3.5, function()
		if frame.Parent then
			local info = TweenInfo.new(0.4)
			TweenService:Create(frame, info, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(l, info, { TextTransparency = 1 }):Play()
			TweenService:Create(s, info, { Transparency = 1 }):Play()
			task.wait(0.45)
			frame:Destroy()
		end
	end)
end

local function act(name: string, ...)
	local ok, msg = Action:InvokeServer(name, ...)
	if type(msg) == "string" then
		toast(msg, if ok then GREEN else RED)
	end
	return ok, msg
end

---------------------------------------------------------------------
-- Dinheiro (canto superior esquerdo)
---------------------------------------------------------------------
local cashFrame = new("Frame", {
	Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(230, 70),
	BackgroundColor3 = DARK, BackgroundTransparency = 0.1, Parent = gui,
})
corner(cashFrame, 12)
stroke(cashFrame, Color3.fromRGB(90, 220, 110), 2)
local cashLabel = label({
	Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 38),
	Text = "💰 $0", TextColor3 = Color3.fromRGB(120, 255, 140), Font = Enum.Font.FredokaOne,
	TextXAlignment = Enum.TextXAlignment.Left, Parent = cashFrame,
})
local incomeLabel = label({
	Position = UDim2.fromOffset(10, 42), Size = UDim2.new(1, -20, 0, 22),
	Text = "Renda: +$0/s", TextColor3 = Color3.fromRGB(200, 255, 200),
	TextXAlignment = Enum.TextXAlignment.Left, Parent = cashFrame,
})

---------------------------------------------------------------------
-- Dica de como jogar
---------------------------------------------------------------------
local hint = label({
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -175), Size = UDim2.new(0.7, 0, 0, 26),
	Text = "🏏 Bata com o Taco  •  ⚪ Bola quando estiverem com POUCA vida  •  ⚔ Escolha um PARCEIRO no 🎒 para lutar e evoluir  •  🏠 Pedestais dão $",
	TextColor3 = Color3.fromRGB(255, 240, 160), TextStrokeTransparency = 0.3, Parent = gui,
})
new("UISizeConstraint", { MaxSize = Vector2.new(900, 26), Parent = hint })
task.delay(40, function()
	TweenService:Create(hint, TweenInfo.new(1), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
end)

---------------------------------------------------------------------
-- Seletor de bolas (embaixo)
---------------------------------------------------------------------
local ballBar = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -100),
	Size = UDim2.fromOffset(#Config.Balls * 100, 58), BackgroundTransparency = 1, Parent = gui,
})
new("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = ballBar,
})

local ballButtons = {}
for i, ballDef in ipairs(Config.Balls) do
	local b = button({
		Size = UDim2.fromOffset(92, 56), LayoutOrder = i, BackgroundColor3 = ballDef.color,
		Text = ballDef.name .. "\nx0", Parent = ballBar,
	})
	local s = stroke(b, Color3.new(1, 1, 1), 0)
	ballButtons[ballDef.id] = { button = b, stroke = s }
	b.Activated:Connect(function()
		act("SelectBall", ballDef.id)
	end)
end

---------------------------------------------------------------------
-- Menu lateral + painéis
---------------------------------------------------------------------
local menu = new("Frame", {
	AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
	Size = UDim2.fromOffset(150, 4 * 54), BackgroundTransparency = 1, Parent = gui,
})
new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })

local panel = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.9, 0.75),
	BackgroundColor3 = DARK, Visible = false, Parent = gui,
})
corner(panel, 14)
stroke(panel, Color3.fromRGB(255, 255, 255), 2)
new("UISizeConstraint", { MaxSize = Vector2.new(560, 460), Parent = panel })

local panelTitle = label({
	Position = UDim2.fromOffset(16, 8), Size = UDim2.new(1, -70, 0, 36), Font = Enum.Font.FredokaOne,
	TextXAlignment = Enum.TextXAlignment.Left, Text = "", Parent = panel,
})
local closeButton = button({
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(36, 36),
	Text = "X", BackgroundColor3 = Color3.fromRGB(220, 70, 70), Parent = panel,
})
local scroll = new("ScrollingFrame", {
	Position = UDim2.fromOffset(12, 54), Size = UDim2.new(1, -24, 1, -66), BackgroundTransparency = 1,
	BorderSizePixel = 0, ScrollBarThickness = 8, CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel,
})
new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })

local currentPanel = nil
local renderers = {}

local function clearScroll()
	for _, child in ipairs(scroll:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

local function row(order: number, height: number?)
	local f = new("Frame", {
		Size = UDim2.new(1, -10, 0, height or 60), BackgroundColor3 = DARK2, LayoutOrder = order, Parent = scroll,
	})
	corner(f, 8)
	return f
end

local function header(order: number, text: string)
	label({
		Size = UDim2.new(1, -10, 0, 28), LayoutOrder = order, Text = text, Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.fromRGB(255, 220, 120), TextXAlignment = Enum.TextXAlignment.Left, Parent = scroll,
	})
end

local function rowText(parent, title: string, titleColor: Color3, subtitle: string, rightSpace: number)
	label({
		Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -(rightSpace + 18), 0, 24), Text = title,
		TextColor3 = titleColor, Font = Enum.Font.FredokaOne, TextXAlignment = Enum.TextXAlignment.Left, Parent = parent,
	})
	label({
		Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -(rightSpace + 18), 0, 20), Text = subtitle,
		TextColor3 = Color3.fromRGB(200, 200, 210), Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
end

local function openPanel(name: string?)
	if name == nil or currentPanel == name then
		currentPanel = nil
		panel.Visible = false
		return
	end
	currentPanel = name
	panel.Visible = true
	renderers[name]()
end

local function refreshPanel()
	if currentPanel then
		renderers[currentPanel]()
	end
end

closeButton.Activated:Connect(function()
	openPanel(nil)
end)

---------------------------------------------------------------------
-- Painel: BRAINROTS (inventário)
---------------------------------------------------------------------
renderers.Inventory = function()
	panelTitle.Text = "🎒 Seus Brainrots"
	clearScroll()
	if not data then
		return
	end

	-- desbloquear pedestais
	local unlockRow = row(0, 56)
	local nextIndex = data.unlockedSlots + 1
	local used = 0
	for _, item in ipairs(data.inventory) do
		if item.slot then
			used += 1
		end
	end
	rowText(unlockRow, "Pedestais: " .. used .. " usados / " .. data.unlockedSlots .. " desbloqueados",
		Color3.new(1, 1, 1), "Máximo: " .. Config.Tycoon.SlotCount, 150)
	if nextIndex <= Config.Tycoon.SlotCount then
		local price = Config.Tycoon.SlotPrices[nextIndex] or 0
		local b = button({
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(140, 40),
			Text = "🔓 $" .. fmt(price), BackgroundColor3 = Color3.fromRGB(60, 170, 90), Parent = unlockRow,
		})
		b.Activated:Connect(function()
			act("Unlock")
		end)
	end

	if #data.inventory == 0 then
		local r = row(1, 60)
		rowText(r, "Nenhum brainrot ainda!", Color3.new(1, 1, 1), "Vá para a Zona de Caça e capture alguns.", 0)
		return
	end

	local items = table.clone(data.inventory)
	local function sortKey(item)
		if item.uid == data.companion then
			return 2
		elseif item.slot then
			return 1
		end
		return 0
	end
	table.sort(items, function(a, b)
		local ka, kb = sortKey(a), sortKey(b)
		if ka ~= kb then
			return ka > kb
		end
		local da, db = Config.getBrainrot(a.id), Config.getBrainrot(b.id)
		return Stats.income(da, a.level or 1) > Stats.income(db, b.level or 1)
	end)

	for i, item in ipairs(items) do
		local def = Config.getBrainrot(item.id)
		if def then
			local level = item.level or 1
			local rarity = Config.getRarity(def.rarity)
			local isCompanion = item.uid == data.companion
			local r = row(i, 60)
			if isCompanion then
				stroke(r, Color3.fromRGB(120, 220, 255), 2)
			end
			new("Frame", { Size = UDim2.new(0, 6, 1, 0), BackgroundColor3 = rarity.color, BorderSizePixel = 0, Parent = r })
			local where = if isCompanion then "⚔ Parceiro" elseif item.slot then "Pedestal " .. item.slot else "Guardado"
			local xpText = if level >= Config.Levels.MaxLevel then "MÁX"
				else "XP " .. math.floor(item.xp or 0) .. "/" .. Stats.xpToNext(level)
			rowText(r, Stats.displayName(def, level) .. "  Lv." .. level, rarity.color,
				rarity.display .. " • +$" .. fmt(Stats.income(def, level)) .. "/s • " .. xpText .. " • " .. where, 270)

			local companionButton = button({
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -180, 0.5, 0), Size = UDim2.fromOffset(80, 40),
				Text = if isCompanion then "Recolher" else "⚔ Lutar",
				BackgroundColor3 = if isCompanion then Color3.fromRGB(120, 120, 140) else Color3.fromRGB(200, 70, 90),
				Parent = r,
			})
			companionButton.Activated:Connect(function()
				if isCompanion then
					act("Dismiss")
				else
					act("Summon", item.uid)
				end
			end)

			local placeButton = button({
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -94, 0.5, 0), Size = UDim2.fromOffset(80, 40),
				Text = if item.slot then "Guardar" else "Colocar",
				BackgroundColor3 = if item.slot then Color3.fromRGB(120, 120, 140) else Color3.fromRGB(70, 140, 255),
				Parent = r,
			})
			placeButton.Activated:Connect(function()
				act(if item.slot then "Store" else "Place", item.uid)
			end)

			local price = Stats.sellPrice(def, level)
			local sellButton = button({
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(80, 40),
				Text = "Vender $" .. fmt(price), BackgroundColor3 = Color3.fromRGB(230, 150, 40), Parent = r,
			})
			local confirming = false
			sellButton.Activated:Connect(function()
				if not confirming then
					confirming = true
					sellButton.Text = "Certeza?"
					sellButton.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
					task.delay(2.5, function()
						if sellButton.Parent then
							confirming = false
							sellButton.Text = "Vender $" .. fmt(price)
							sellButton.BackgroundColor3 = Color3.fromRGB(230, 150, 40)
						end
					end)
					return
				end
				act("Sell", item.uid)
			end)
		end
	end
end

