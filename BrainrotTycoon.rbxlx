<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000000000000000000000000000001"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000002"><Properties><string name="Name">CatchMath</string><ProtectedString name="Source"><![CDATA[-- Fórmula de captura (usada pelo servidor e pela interface do jogador)

local Config = require(script.Parent.Config)

local CatchMath = {}

-- Retorna um número de 0 a 1.
-- Quanto MENOS vida o brainrot tem, MAIOR a chance.
function CatchMath.getChance(catchRate: number, health: number, maxHealth: number, ballMultiplier: number): number
	local ratio = math.clamp(health / math.max(maxHealth, 1), 0, 1)
	local healthBonus = 1 + Config.Catch.HealthBonusMax * (1 - ratio)
	local chance = catchRate * ballMultiplier * healthBonus
	return math.clamp(chance, Config.Catch.MinChance, Config.Catch.MaxChance)
end

function CatchMath.formatNumber(n: number): string
	n = math.floor(n)
	if n >= 1e9 then
		return string.format("%.1fB", n / 1e9)
	elseif n >= 1e6 then
		return string.format("%.1fM", n / 1e6)
	elseif n >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	end
	return tostring(n)
end

return CatchMath
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config: todos os números do jogo ficam aqui.
