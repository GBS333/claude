	XpExponent = 1.5,
	CaptureXpShare = 0.5,
}

---------------------------------------------------------------------
-- ATAQUES DO PARCEIRO
---------------------------------------------------------------------
Config.Moves = {
	{ id = "Basico", name = "Ataque", level = 1, power = 1, cooldown = 1.4, range = 6, kind = "Melee", auto = true },
	{ id = "Cabecada", name = "Cabeçada", level = 5, power = 2, cooldown = 6, range = 7, kind = "Melee", key = "Z" },
	{ id = "Rajada", name = "Rajada Brainrot", level = 10, power = 2.5, cooldown = 9, range = 45, kind = "Projectile", key = "X" },
	{ id = "Terremoto", name = "Terremoto", level = 20, power = 2, cooldown = 15, range = 16, kind = "Area", key = "C" },
	{ id = "Especial", name = "Golpe Especial", level = 30, power = 4.5, cooldown = 22, range = 45, kind = "Projectile", key = "V", signature = true },
}

---------------------------------------------------------------------
-- PARCEIRO
---------------------------------------------------------------------
Config.Companion = {
	HealthMultiplier = 2,
	DamageMultiplier = 2,
	FollowDistance = 5,
	MinSpeed = 16,
	LeashDistance = 70,
	TeleportDistance = 120,
	AutoTargetRadius = 30,
	FaintTime = 20,
	RegenDelay = 5,
	RegenPercentPerSecond = 0.05,
}

---------------------------------------------------------------------
-- Funções de busca (não precisa mexer)
---------------------------------------------------------------------
local function index(list)
	local map = {}
	for _, item in ipairs(list) do
		map[item.id] = item
	end
	return map
end

local brainrotById = index(Config.Brainrots)
local ballById = index(Config.Balls)
local batById = index(Config.Bats)
local moveById = index(Config.Moves)
local biomeById = index(Config.Biomes)
local bossById = index(Config.Bosses)
local gearById = index(Config.Gear)
local eventById = index(Config.Events.List)

function Config.getBrainrot(id)
	return brainrotById[id]
end
function Config.getBall(id)
	return ballById[id]
end
function Config.getBat(id)
	return batById[id]
end
function Config.getMove(id)
	return moveById[id]
end
function Config.getRarity(name)
	return Config.Rarities[name]
end
function Config.getBiome(id)
	return biomeById[id]
end
function Config.getBoss(id)
	return bossById[id]
end
function Config.getGear(id)
	return gearById[id]
end
function Config.getEvent(id)
	return eventById[id]
end
function Config.getMutation(id)
	return id and Config.Mutations[id] or nil
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000004"><Properties><string name="Name">Stats</string><ProtectedString name="Source"><![CDATA[-- Status dos brainrots por nível, evolução e mutação (servidor e interface usam o mesmo cálculo)

local Config = require(script.Parent.Config)

local L = Config.Levels
local Stats = {}

local function mutationMult(mutation: string?, field: string): number
	local m = Config.getMutation(mutation)
	return if m then m[field] or 1 else 1
end
Stats.mutationMult = mutationMult

-- 1 = forma normal, 2 = primeira evolução, 3 = evolução final
function Stats.stage(level: number): number
	local stage = 1
	for i, evolveLevel in ipairs(L.EvolveLevels) do
		if level >= evolveLevel then
			stage = i + 1
		end
	end
	return stage
end

function Stats.displayName(def, level: number, mutation: string?): string
	local stage = Stats.stage(level)
	local name = def.name
	if stage > 1 and def.evolutions and def.evolutions[stage - 1] then
		name = def.evolutions[stage - 1]
	end
	local m = Config.getMutation(mutation)
	if m then
		name = m.icon .. " " .. name
	end
	return name
end

local function levelMult(level: number, perLevel: number): number
	return 1 + perLevel * (level - 1)
end

-- stageOverride: os selvagens não evoluem, então eles usam 1
function Stats.maxHealth(def, level: number, stageOverride: number?, mutation: string?): number
	local stage = stageOverride or Stats.stage(level)
	return math.floor(def.maxHealth * levelMult(level, L.HealthPerLevel) * L.StageHealth[stage] * mutationMult(mutation, "health"))
end

function Stats.power(def, level: number, stageOverride: number?, mutation: string?): number
	local stage = stageOverride or Stats.stage(level)
	return def.damage * levelMult(level, L.PowerPerLevel) * L.StagePower[stage] * mutationMult(mutation, "power")
end

function Stats.income(def, level: number, mutation: string?): number
	local stage = Stats.stage(level)
	local value = def.income * levelMult(level, L.IncomePerLevel) * L.StageIncome[stage] * mutationMult(mutation, "income")
	return math.floor(value * 10 + 0.5) / 10
end

function Stats.sellPrice(def, level: number, mutation: string?): number
	local stage = Stats.stage(level)
	return math.floor(def.sellPrice * levelMult(level, L.SellPerLevel) * L.StageIncome[stage] * mutationMult(mutation, "income"))
end

function Stats.scale(level: number): number
	return L.StageScale[Stats.stage(level)]
end

function Stats.xpToNext(level: number): number
	return math.floor(L.XpBase * level ^ L.XpExponent)
end

function Stats.companionMaxHealth(def, level: number, mutation: string?): number
	return math.floor(Stats.maxHealth(def, level, nil, mutation) * Config.Companion.HealthMultiplier)
end

function Stats.companionPower(def, level: number, mutation: string?): number
	return Stats.power(def, level, nil, mutation) * Config.Companion.DamageMultiplier
end

function Stats.moveName(move, def): string
	if move.signature and def and def.signature then
		return def.signature
	end
	return move.name
end

function Stats.knownMoves(level: number)
	local list = {}
	for _, move in ipairs(Config.Moves) do
		if level >= move.level then
			table.insert(list, move)
		end
	end
	return list
end

-- XP ganho ao derrotar um selvagem
function Stats.xpReward(def, level: number): number
	local rarity = Config.getRarity(def.rarity)
	return math.floor(rarity.xpReward * (1 + 0.5 * (level - 1)))
end

---------------------------------------------------------------------
-- Jogador
---------------------------------------------------------------------
function Stats.playerXpToNext(level: number): number
	local P = Config.PlayerLevels
	return math.floor(P.XpBase * level ^ P.XpExponent)
end

-- quantos pedestais o jogador pode ter (aumenta com rebirth)
function Stats.maxSlots(rebirths: number): number
	local T = Config.Tycoon
	return math.min(T.SlotCount, T.BaseMaxSlots + T.SlotsPerRebirth * (rebirths or 0))
end

function Stats.rebirthIncomeMultiplier(rebirths: number): number
	return 1 + Config.Rebirth.IncomeBonus * (rebirths or 0)
end

-- progress = { level = n, bosses = { [id] = true }, rebirths = n }
-- Retorna true se pode entrar no bioma, ou false + motivo
function Stats.canEnter(progress, biome): (boolean, string?)
	local unlock = biome.unlock or {}
	if unlock.level and (progress.level or 1) < unlock.level then
		return false, "Precisa do nível " .. unlock.level
	end
	if unlock.boss and not (progress.bosses and progress.bosses[unlock.boss]) then
		local boss = Config.getBoss(unlock.boss)
		local where = boss and Config.getBiome(boss.biome)
		return false, "Derrote o chefão " .. (if boss then boss.name else unlock.boss)
			.. (if where then " (" .. where.name .. ")" else "")
	end
	if unlock.rebirths and (progress.rebirths or 0) < unlock.rebirths then
		return false, "Precisa de " .. unlock.rebirths .. " rebirth(s)"
	end
	return true, nil
end

-- Em qual bioma está essa posição (ou nil)
function Stats.biomeAt(position: Vector3)
	for _, biome in ipairs(Config.Biomes) do
		local c = biome.center
		if math.abs(position.X - c.X) <= biome.size.X / 2 and math.abs(position.Z - c.Z) <= biome.size.Y / 2
			and position.Y > c.Y - 40 and position.Y < c.Y + 120 then
			return biome
		end
	end
	return nil
end

return Stats
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000000000000000000000000000019"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000018"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Script principal do servidor: liga todos os sistemas do jogo.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Services = script.Parent:WaitForChild("Services")
local Remotes = require(Services.Remotes)
local DataService = require(Services.DataService)
local WorldBuilder = require(Services.WorldBuilder)
local TycoonService = require(Services.TycoonService)
local WildService = require(Services.WildService)
local EventService = require(Services.EventService)
local ProgressService = require(Services.ProgressService)
local CompanionService = require(Services.CompanionService)
local StealService = require(Services.StealService)
local ToolService = require(Services.ToolService)
local InventoryService = require(Services.InventoryService)
local TradeService = require(Services.TradeService)
local DuelService = require(Services.DuelService)
local ShopService = require(Services.ShopService)

WorldBuilder.build()
TycoonService.start()
WildService.start()
EventService.start()
ProgressService.start()
CompanionService.start()
StealService.start()
ToolService.start()
InventoryService.start()
TradeService.start()
DuelService.start()
ShopService.start()

---------------------------------------------------------------------
-- Comandos de teste no chat (só no Studio ou para o dono do jogo)
---------------------------------------------------------------------
local function isAdmin(player: Player): boolean
	return Config.AdminCommands and (RunService:IsStudio() or player.UserId == game.CreatorId)
end

local commands = {}
commands.ajuda = function(player)
	Remotes.notify(player, "/dinheiro 100000 • /nivel 30 • /rebirth 2 • /evento Magma • /chefe TungGigante • "
		.. "/brainrot TungTung 20 Magma • /bolas 50 • /liberar", Color3.fromRGB(255, 230, 120))
end
commands.dinheiro = function(player, amount)
	DataService.addCash(player, tonumber(amount) or 100000)
end
commands.nivel = function(player, level)
	ProgressService.setLevel(player, tonumber(level) or 30)
end
commands.rebirth = function(player, amount)
	local data = DataService.get(player)
	data.rebirths = math.clamp(tonumber(amount) or 1, 0, Config.Rebirth.Max)
	TycoonService.refreshPlayer(player)
	DataService.pushUpdate(player)
end
commands.evento = function(player, eventId)
	if not EventService.startEvent(eventId) then
		Remotes.notify(player, "Eventos: Radiacao, Magma, ArcoIris", Color3.fromRGB(255, 120, 120))
	end
end
commands.chefe = function(player, bossId)
	if not WildService.spawnBoss(bossId or "TungGigante") then
		Remotes.notify(player, "Chefões: TungGigante, FrigoTita, BombardiroImperador (ou já está vivo)", Color3.fromRGB(255, 120, 120))
	end
end
commands.brainrot = function(player, id, level, mutation)
	if not Config.getBrainrot(id) then
		Remotes.notify(player, "id inválido (veja os ids na Config)", Color3.fromRGB(255, 120, 120))
		return
	end
	DataService.addBrainrot(player, id, math.clamp(tonumber(level) or 1, 1, Config.Levels.MaxLevel), Config.getMutation(mutation) and mutation or nil)
end
commands.bolas = function(player, amount)
	for _, ball in ipairs(Config.Balls) do
		DataService.addBalls(player, ball.id, tonumber(amount) or 50)
	end
end
commands.liberar = function(player)
	ProgressService.setLevel(player, Config.PlayerLevels.Max)
	for _, boss in ipairs(Config.Bosses) do
		ProgressService.markBoss(player, boss.id)
	end
	commands.rebirth(player, 1)
end

local function onChatted(player: Player, message: string)
	if not isAdmin(player) or string.sub(message, 1, 1) ~= "/" then
		return
	end
	local args = string.split(string.sub(message, 2), " ")
	local name = string.lower(table.remove(args, 1) or "")
	local command = commands[name]
	if command then
		local ok, err = pcall(command, player, table.unpack(args))
		if not ok then
			warn("[Admin] erro em /" .. name .. ": " .. tostring(err))
		end
	end
end

---------------------------------------------------------------------
-- Jogadores
---------------------------------------------------------------------
local function onCharacter(player: Player, character: Model)
	character:WaitForChild("HumanoidRootPart", 10)
	player:WaitForChild("Backpack", 10)
	task.wait(0.2)
	if character.Parent == nil then
		return
	end
	ToolService.giveTools(player)
	InventoryService.sync(player, true)
	TycoonService.teleportHome(player)
	task.wait(0.1)
	CompanionService.spawn(player)
end

local function onPlayerAdded(player: Player)
	player.Chatted:Connect(function(message)
		onChatted(player, message)
	end)

	DataService.load(player)
	if player.Parent ~= Players then
		DataService.release(player)
		return
	end
	TycoonService.assign(player)
	DataService.pushUpdate(player)

	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end

	Remotes.notify(player, "Bem-vindo! 🏏 Bata nos brainrots e use a ⚪ Bola quando estiverem com POUCA vida!", Color3.fromRGB(255, 230, 100))
	task.delay(6, function()
		if player.Parent == Players then
			Remotes.notify(player, "🗺 Explore os biomas, derrote chefões e cuidado: outros jogadores podem ROUBAR sua base!",
				Color3.fromRGB(140, 230, 255))
		end
	end)
	if isAdmin(player) then
		task.delay(10, function()
			if player.Parent == Players then
				commands.ajuda(player)
			end
		end)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	StealService.cancel(player, "saiu do jogo")
	CompanionService.dismiss(player, true)
	TycoonService.release(player)
	DataService.release(player)
end)

game:BindToClose(function()
	if RunService:IsStudio() then
		task.wait(1)
	end
	for _, player in ipairs(Players:GetPlayers()) do
		TycoonService.release(player)
		task.spawn(DataService.release, player)
	end
	task.wait(3)
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000000000000000000000000000017"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">BrainrotModels</string><ProtectedString name="Source"><![CDATA[-- Monta o visual de cada brainrot.
--
-- MODELOS 3D DE VERDADE (recomendado):
--   1. No Studio: View → Toolbox → pesquise o nome (ex.: "Tung Tung Tung Sahur").
--   2. Coloque o modelo dentro de uma pasta chamada "BrainrotModels" em ServerStorage.
--   3. Renomeie o modelo para o "id" que está na Config (ex.: "TungTung", "Tralalero").
--   O jogo ajusta o tamanho sozinho, cria a caixa de acerto e APAGA os scripts do modelo
--   (modelos da Toolbox podem ter vírus).
--
-- Sem modelo na pasta, o jogo monta um boneco com peças no formato de cada brainrot.

local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local BrainrotModels = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local rad = math.rad

local WHITE = RGB(255, 255, 255)
local BLACK = RGB(20, 20, 20)
local DARK_MOUTH = RGB(60, 20, 20)
local SKIN = RGB(240, 200, 165)
local WOOD = Enum.Material.Wood
local METAL = Enum.Material.Metal
local NEON = Enum.Material.Neon

---------------------------------------------------------------------
-- Ajudante para criar peças
-- shape: "Block", "Ball", "Wedge", "Cyl" (cilindro em pé: size = diâmetro, altura, diâmetro),
--        "CylX" (deitado no eixo X: size = comprimento, diâmetro, diâmetro), "CylZ" (deitado no eixo Z)
---------------------------------------------------------------------
local function maker(model: Model)
	return function(shape: string, size, where, color: Color3, material: Enum.Material?, transparency: number?)
		local part = if shape == "Wedge" then Instance.new("WedgePart") else Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false -- quem recebe os acertos é a caixa "Root"
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Material = material or Enum.Material.SmoothPlastic
		part.Color = color
		part.Transparency = transparency or 0

		local cf = if typeof(where) == "CFrame" then where else CFrame.new(where)
		if typeof(size) == "number" then
			size = V(size, size, size)
		end
		if shape == "Ball" then
			part.Shape = Enum.PartType.Ball
			part.Size = V(size.X, size.X, size.X)
		elseif shape == "Cyl" then
			part.Shape = Enum.PartType.Cylinder
			part.Size = V(size.Y, size.X, size.X)
			cf = cf * CFrame.Angles(0, 0, rad(90))
		elseif shape == "CylX" then
			part.Shape = Enum.PartType.Cylinder
			part.Size = V(size.X, size.Y, size.Y)
		elseif shape == "CylZ" then
			part.Shape = Enum.PartType.Cylinder
			part.Size = V(size.Z, size.X, size.X)
			cf = cf * CFrame.Angles(0, rad(90), 0)
		else
			part.Size = size
		end
		part.CFrame = cf
		part.Parent = model
		return part
	end
end

-- dois olhos (bola branca + pupila preta) olhando para a frente (-Z)
local function eyes(P, center: Vector3, spacing: number, size: number)
	for _, s in ipairs({ -1, 1 }) do
		local pos = center + V(s * spacing, 0, 0)
		P("Ball", size, pos, WHITE)
		P("Ball", size * 0.5, pos + V(0, 0, -size * 0.32), BLACK)
	end
end

---------------------------------------------------------------------
-- Os brainrots (chão em y = 0, frente = -Z)
---------------------------------------------------------------------
local builders = {}

builders.TungTung = function(P)
	local wood = RGB(200, 155, 105)
	local dark = RGB(105, 70, 40)
	for _, s in ipairs({ -1, 1 }) do
		P("Cyl", V(0.35, 1.4, 0.35), V(s * 0.5, 0.7, 0), wood, WOOD)
		P("Block", V(0.55, 0.3, 0.8), V(s * 0.5, 0.15, -0.15), dark)
		P("Cyl", V(0.3, 1.8, 0.3), CFrame.new(s * 1.35, 3.6, 0) * CFrame.Angles(0, 0, rad(s * 25)), wood, WOOD)
	end
	P("Cyl", V(2.4, 5, 2.4), V(0, 3.9, 0), wood, WOOD) -- a tora
	P("Cyl", V(2.0, 0.05, 2.0), V(0, 6.41, 0), RGB(230, 195, 145), WOOD) -- anel da madeira
	P("Cyl", V(1.2, 0.06, 1.2), V(0, 6.43, 0), RGB(180, 135, 90), WOOD)
	eyes(P, V(0, 5.1, -1.12), 0.5, 0.65)
	P("Block", V(1.3, 0.2, 0.2), V(0, 4.15, -1.17), RGB(50, 25, 15)) -- sorriso
	-- o famoso taco
	local batCF = CFrame.new(1.95, 3.4, -0.35) * CFrame.Angles(rad(-15), 0, rad(-12))
	P("Cyl", V(0.3, 1.6, 0.3), batCF, dark, WOOD)
	P("Cyl", V(0.55, 2.0, 0.55), batCF * CFrame.new(0, 1.7, 0), dark, WOOD)
end

builders.Tralalero = function(P)
	local blue = RGB(95, 145, 200)
	local shoe = RGB(30, 100, 255)
	P("CylZ", V(2.4, 2.4, 4.2), V(0, 2.7, 0.3), blue) -- corpo do tubarão
	P("Ball", 2.4, V(0, 2.7, -1.8), blue) -- focinho
	P("Block", V(1.5, 0.5, 4.4), V(0, 1.75, -0.3), WHITE) -- barriga
	P("Ball", 1.6, V(0, 2.8, 2.6), blue) -- final do corpo
	P("Wedge", V(0.35, 1.6, 1.2), CFrame.new(0, 3.9, 3.2), blue) -- cauda de cima
	P("Wedge", V(0.35, 1.0, 1.0), CFrame.new(0, 2.0, 3.3) * CFrame.Angles(0, 0, rad(180)), blue) -- cauda de baixo
	P("Wedge", V(0.3, 1.4, 1.5), CFrame.new(0, 4.5, 0.4), blue) -- barbatana
	for _, s in ipairs({ -1, 1 }) do
		P("Block", V(1.2, 0.15, 0.7), CFrame.new(s * 1.5, 2.2, -0.6) * CFrame.Angles(0, 0, rad(-s * 25)), blue)
		P("Ball", 0.5, V(s * 0.95, 3.15, -2.3), WHITE)
		P("Ball", 0.28, V(s * 1.05, 3.15, -2.45), BLACK)
	end
	P("Block", V(1.4, 0.25, 0.3), V(0, 2.1, -2.95), DARK_MOUTH)
	for i = 0, 4 do
		P("Wedge", V(0.15, 0.2, 0.12), CFrame.new(-0.5 + i * 0.25, 2.18, -3.08) * CFrame.Angles(rad(180), 0, 0), WHITE)
	end
	-- 3 pernas com tênis azul
	for _, pos in ipairs({ V(-0.6, 0, -0.9), V(0.6, 0, -0.9), V(0, 0, 1.2) }) do
		P("Cyl", V(0.35, 1.3, 0.35), pos + V(0, 0.95, 0), SKIN)
		P("Block", V(0.7, 0.4, 1.2), pos + V(0, 0.32, -0.15), shoe)
		P("Block", V(0.75, 0.12, 1.25), pos + V(0, 0.06, -0.15), WHITE)
		P("Block", V(0.05, 0.15, 0.6), pos + V(0.37, 0.34, -0.1), WHITE)
		P("Block", V(0.05, 0.15, 0.6), pos + V(-0.37, 0.34, -0.1), WHITE)
	end
end

builders.Bombardiro = function(P)
	local plane = RGB(85, 110, 65)
	local croc = RGB(70, 150, 70)
	local grey = RGB(120, 120, 130)
	P("CylZ", V(2.2, 2.2, 5), V(0, 3, 0.5), plane) -- fuselagem
	P("Block", V(1.9, 1.3, 1.6), V(0, 3.2, -2.6), croc) -- cabeça
	P("Block", V(1.4, 0.5, 2.2), V(0, 3.4, -4.4), croc) -- focinho
	P("Block", V(1.3, 0.35, 2.0), V(0, 2.75, -4.3), croc) -- mandíbula
	for i = 0, 4 do
		P("Wedge", V(0.15, 0.25, 0.15), CFrame.new(-0.55 + i * 0.27, 3.0, -4.9) * CFrame.Angles(rad(180), 0, 0), WHITE)
	end
	for _, s in ipairs({ -1, 1 }) do
		P("Ball", 0.75, V(s * 0.55, 3.95, -2.9), croc)
		P("Ball", 0.45, V(s * 0.55, 4.1, -3.15), RGB(250, 220, 60))
		P("Block", V(0.08, 0.3, 0.05), V(s * 0.55, 4.1, -3.38), BLACK)
		-- motores e hélices
		P("CylZ", V(0.8, 0.8, 1.6), V(s * 2.6, 2.9, -0.3), grey, METAL)
		P("Block", V(0.15, 1.8, 0.1), V(s * 2.6, 2.9, -1.15), BLACK)
		P("Block", V(1.8, 0.15, 0.1), V(s * 2.6, 2.9, -1.15), BLACK)
		-- bombas
		P("CylZ", V(0.5, 0.5, 1.3), V(s * 1.4, 2.25, 0.6), RGB(50, 55, 50), METAL)
		P("Ball", 0.5, V(s * 1.4, 2.25, -0.05), RGB(50, 55, 50), METAL)
	end
	P("Block", V(9, 0.3, 1.8), V(0, 3.1, 0.2), plane) -- asas
	P("Block", V(3, 0.2, 1), V(0, 3.3, 3.2), plane) -- asa de trás
	P("Wedge", V(0.25, 1.4, 1.2), CFrame.new(0, 4.2, 3.3), plane) -- leme
	P("Cyl", V(0.6, 0.05, 0.6), CFrame.new(-2.5, 3.26, 0.2), WHITE) -- estrela
end

builders.Ballerina = function(P)
	local pink = RGB(255, 160, 205)
