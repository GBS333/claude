---------------------------------------------------------------------
-- Boneco genérico (para brainrots novos sem modelo e sem formato próprio)
---------------------------------------------------------------------
local function genericBuilder(def)
	return function(P)
		local size = def.size
		local body = def.bodyColor or Config.getRarity(def.rarity).color
		local accent = def.accentColor or WHITE
		local legH = 0.7
		local cy = legH + size.Y / 2
		local shape = def.shape or "Ball"
		if shape == "Ball" then
			P("Ball", size.X, V(0, legH + size.X / 2, 0), body)
			cy = legH + size.X / 2
		elseif shape == "Cylinder" then
			P("Cyl", V(size.X, size.Y, size.X), V(0, cy, 0), body)
		else
			P("Block", size, V(0, cy, 0), body)
		end
		local top = if shape == "Ball" then legH + size.X else legH + size.Y
		local front = -size.Z / 2
		eyes(P, V(0, cy + size.Y * 0.18, front * 0.85), size.X * 0.22, math.max(size.X * 0.28, 0.6))
		P("Block", V(size.X * 0.4, 0.25, 0.2), V(0, cy - size.Y * 0.12, front * 0.92), DARK_MOUTH)
		for _, s in ipairs({ -1, 1 }) do
			P("Block", V(0.9, 0.7, 1.2), V(s * size.X * 0.25, 0.35, 0), accent)
		end
		local acc = def.accessory
		if acc == "Antena" then
			P("Cyl", V(0.2, 1.6, 0.2), V(0, top + 0.8, 0), BLACK)
			P("Ball", 0.7, V(0, top + 1.7, 0), accent, NEON)
		elseif acc == "Chapeu" then
			P("Cyl", V(size.X * 0.9, 0.2, size.X * 0.9), V(0, top, 0), accent)
			P("Cyl", V(size.X * 0.55, 1.4, size.X * 0.55), V(0, top + 0.7, 0), accent)
		elseif acc == "Orelhas" then
			for _, s in ipairs({ -1, 1 }) do
				P("Block", V(0.5, 1.2, 0.8), V(s * size.X * 0.35, top + 0.4, 0), accent)
			end
		elseif acc == "Asas" then
			for _, s in ipairs({ -1, 1 }) do
				P("Block", V(2.2, 0.2, 1.4), CFrame.new(s * (size.X / 2 + 1), cy, 0) * CFrame.Angles(0, 0, rad(s * 25)), WHITE)
			end
		elseif acc == "Disco" then
			P("CylX", V(0.3, 2, 2), V(size.X / 2 + 0.3, cy, 0), accent, METAL)
		elseif acc == "Capacete" or acc == "Coroa" then
			P("Block", V(size.X * 0.5, 0.5, size.X * 0.5), V(0, top + 0.3, 0), RGB(255, 210, 40), NEON)
		end
	end
end

---------------------------------------------------------------------
-- Montagem final: caixa de acerto "Root" + altura até o chão
---------------------------------------------------------------------
local function finalize(model: Model)
	model.WorldPivot = CFrame.new()
	local bbCF, bbSize = model:GetBoundingBox()
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = true
	root.Transparency = 1
	root.Size = bbSize
	root.CFrame = CFrame.new(bbCF.Position)
	root.Parent = model
	model.PrimaryPart = root
	model:SetAttribute("HipHeight", bbCF.Position.Y) -- o chão estava em y = 0
	return model
end

local function buildFromParts(def)
	local model = Instance.new("Model")
	model.Name = def.id
	local builder = builders[def.id] or genericBuilder(def)
	builder(maker(model))
	return finalize(model)
end

-- Prepara um modelo da Toolbox: remove scripts, ancora, ajusta tamanho e cria a caixa de acerto
local function prepareCustom(def, source: Model)
	local model = source:Clone()
	model.Name = def.id
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("ModuleScript") or d:IsA("Sound") then
			d:Destroy()
		elseif d:IsA("Humanoid") then
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
		end
	end

	-- usa só a direção horizontal do modelo (mais o ajuste modelYaw da Config)
	local pivot = model:GetPivot()
	local look = Vector3.new(pivot.LookVector.X, 0, pivot.LookVector.Z)
	local rotation = if look.Magnitude > 0.01 then CFrame.lookAt(Vector3.zero, look) else CFrame.new()
	rotation *= CFrame.Angles(0, rad(def.modelYaw or 0), 0)
	model.PrimaryPart = nil
	model.WorldPivot = CFrame.new(pivot.Position) * rotation

	local bbCF, bbSize = model:GetBoundingBox()
	if bbSize.Y > 0.01 then
		model:ScaleTo(model:GetScale() * (def.size.Y / bbSize.Y))
	end
	bbCF, bbSize = model:GetBoundingBox()

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = true
	root.Transparency = 1
	root.Size = bbSize
	root.CFrame = bbCF
	root.Parent = model
	model.PrimaryPart = root
	model:SetAttribute("HipHeight", bbSize.Y / 2)
	return model
end

---------------------------------------------------------------------
-- Efeitos das evoluções: 2ª evolução brilha, 3ª ganha coroa e aura
---------------------------------------------------------------------
local function applyStage(model: Model, def, stage: number)
	if stage < 2 or not model.PrimaryPart then
		return
	end
	local root = model.PrimaryPart
	local color = Config.getRarity(def.rarity).color

	local aura = Instance.new("ParticleEmitter")
	aura.Name = "EvoAura"
	aura.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	aura.LightEmission = 0.8
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	aura.Transparency = NumberSequence.new(0.3)
	aura.Lifetime = NumberRange.new(0.8, 1.4)
	aura.Rate = if stage >= 3 then 25 else 10
	aura.Speed = NumberRange.new(1, 3)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Parent = root

	if stage >= 3 then
		local size = root.Size
		local crown = Instance.new("Part")
		crown.Name = "EvoCrown"
		crown.Anchored = true
		crown.CanCollide = false
		crown.CanTouch = false
		crown.CanQuery = false
		crown.Material = NEON
		crown.Color = RGB(255, 215, 50)
		crown.Size = V(1.4, 0.4, 1.4)
		crown.CFrame = root.CFrame * CFrame.new(0, size.Y / 2 + 0.6, 0)
		crown.Parent = model
		for i = 0, 3 do
			local spike = crown:Clone()
			spike.Name = "EvoSpike"
			spike.Size = V(0.3, 0.7, 0.3)
			local angle = i * math.pi / 2
			spike.CFrame = crown.CFrame * CFrame.new(math.cos(angle) * 0.55, 0.5, math.sin(angle) * 0.55)
			spike.Parent = model
		end
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 14
		light.Brightness = 3
		light.Parent = root
	end
end

---------------------------------------------------------------------
-- API
---------------------------------------------------------------------
local templates = {} -- modelo pronto de cada brainrot (montado uma vez, depois só clonado)

local function getTemplate(def)
	local template = templates[def.id]
	if template then
		return template
	end
	local folder = ServerStorage:FindFirstChild("BrainrotModels")
	local custom = folder and folder:FindFirstChild(def.id)
	if custom and custom:IsA("Model") then
		local ok, result = pcall(prepareCustom, def, custom)
		if ok then
			template = result
		else
			warn("[BrainrotModels] Não deu para usar o modelo '" .. def.id .. "': " .. tostring(result))
		end
	end
	template = template or buildFromParts(def)
	templates[def.id] = template
	return template
end

-- Brilho colorido + partículas das mutações (Dourado, Magma, Radioativo...)
function BrainrotModels.applyMutation(model: Model, mutationId: string?)
	local m = Config.getMutation(mutationId)
	local root = model.PrimaryPart
	if not m or not root then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.Name = "Mutation"
	highlight.FillColor = m.color
	highlight.FillTransparency = 0.55
	highlight.OutlineColor = m.color
	highlight.OutlineTransparency = 0.2
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "MutationParticles"
	if mutationId == "ArcoIris" then
		emitter.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, RGB(255, 80, 80)), ColorSequenceKeypoint.new(0.25, RGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.5, RGB(80, 255, 120)), ColorSequenceKeypoint.new(0.75, RGB(80, 160, 255)),
			ColorSequenceKeypoint.new(1, RGB(220, 90, 255)),
		})
	else
		emitter.Color = ColorSequence.new(m.color)
	end
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Rate = 10
	emitter.Speed = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = root
end

-- Cria um novo modelo do brainrot. scale = tamanho (1 = normal). stage = evolução (1, 2 ou 3).
function BrainrotModels.build(def, scale: number?, stage: number?, mutation: string?)
	scale = scale or 1
	local model = getTemplate(def):Clone()
	if scale ~= 1 then
		model:ScaleTo(model:GetScale() * scale)
		model:SetAttribute("HipHeight", (model:GetAttribute("HipHeight") or 0) * scale)
	end
	applyStage(model, def, stage or 1)
	BrainrotModels.applyMutation(model, mutation)
	return model
end

return BrainrotModels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">CompanionService</string><ProtectedString name="Source"><![CDATA[-- PARCEIRO: o brainrot que você capturou luta do seu lado.
-- Ele te segue, ataca os selvagens, ganha XP quando eles são derrotados,
-- sobe de nível (mais vida, força e renda), aprende ataques novos e EVOLUI.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local WildService = require(script.Parent.WildService)
local BrainrotModels = require(script.Parent.BrainrotModels)
local Remotes = require(script.Parent.Remotes)

local CompanionService = {}

local CC = Config.Companion
local BASIC = Config.getMove("Basico")

local folder = Instance.new("Folder")
folder.Name = "Companions"
folder.Parent = workspace

local active = {} -- [Player] = Companion
local faintMemory = {} -- [Player] = { uid = string, untilTime = number } (não dá para "trapacear" guardando e chamando de novo)

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

---------------------------------------------------------------------
-- Classe Companion
---------------------------------------------------------------------
local Companion = {}
Companion.__index = Companion

-- O alvo pode ser um brainrot selvagem OU o parceiro de outro jogador (no duelo)
local function isCompanion(t): boolean
	return type(t) == "table" and getmetatable(t) == Companion
end
local function tAlive(t): boolean
	if isCompanion(t) then
		return t:isAlive()
	end
	return WildService.isAlive(t) and not t.capturing
end
local function tPos(t): Vector3
	return if isCompanion(t) then t.position else WildService.getPosition(t)
end
local function tRadius(t): number
	return if isCompanion(t) then t.radius else WildService.radius(t)
end
local function tHeight(t): number
	return (t.hipHeight or 2) * 2
end

function Companion:isAlive(): boolean
	return not self.destroyed and not self.fainted
end

function Companion:getPosition(): Vector3
	return self.position
end

function Companion:refreshStats(fullHeal: boolean)
	local level = self.item.level
	local oldMax = self.maxHealth or 1
	self.maxHealth = Stats.companionMaxHealth(self.def, level, self.item.mutation)
	self.power = Stats.companionPower(self.def, level, self.item.mutation)
	if fullHeal or not self.health then
		self.health = self.maxHealth
	else
		self.health = math.min(self.maxHealth, self.health * self.maxHealth / oldMax)
	end
end

function Companion:updateBar()
	if not self.model then
		return
	end
	local ratio = math.clamp(self.health / self.maxHealth, 0, 1)
	self.fill.Size = UDim2.fromScale(ratio, 1)
	self.hpText.Text = math.ceil(self.health) .. " / " .. self.maxHealth
	self.model:SetAttribute("Health", self.health)
	self.model:SetAttribute("MaxHealth", self.maxHealth)
end

function Companion:buildModel()
	if self.model then
		self.model:Destroy()
	end
	local def, level = self.def, self.item.level
	local model = BrainrotModels.build(def, Stats.scale(level), Stats.stage(level), self.item.mutation)
	model.Name = self.player.Name .. "_Parceiro"
	model:SetAttribute("OwnerUserId", self.player.UserId)
	model:SetAttribute("CompanionUid", self.item.uid)
	model:SetAttribute("BrainrotId", def.id)
	model:SetAttribute("Level", level)
	-- não bloqueia as bolas nem o mouse
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	self.hipHeight = model:GetAttribute("HipHeight") or def.size.Y / 2
	self.radius = def.size.X * Stats.scale(level) / 2

	-- placa com nome, nível e vida
	local rarity = Config.getRarity(def.rarity)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(190, 62)
	gui.StudsOffsetWorldSpace = Vector3.new(0, self.hipHeight + 3, 0)
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Adornee = model.PrimaryPart

	local owner = Instance.new("TextLabel")
	owner.Size = UDim2.new(1, 0, 0, 16)
	owner.BackgroundTransparency = 1
	owner.Text = "⚔ Parceiro de " .. self.player.DisplayName
	owner.TextColor3 = Color3.fromRGB(140, 230, 255)
	owner.TextStrokeTransparency = 0.3
	owner.Font = Enum.Font.GothamBold
	owner.TextScaled = true
	owner.Parent = gui

	local name = Instance.new("TextLabel")
	name.Position = UDim2.fromOffset(0, 16)
	name.Size = UDim2.new(1, 0, 0, 22)
	name.BackgroundTransparency = 1
	name.Text = Stats.displayName(def, level, self.item.mutation) .. "  Lv." .. level
	name.TextColor3 = rarity.color
	name.TextStrokeTransparency = 0.2
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.Parent = gui

	local back = Instance.new("Frame")
	back.Position = UDim2.fromOffset(15, 42)
	back.Size = UDim2.new(1, -30, 0, 14)
	back.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	back.BorderSizePixel = 0
	back.Parent = gui
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(70, 200, 255)
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)

	local hpText = Instance.new("TextLabel")
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.BackgroundTransparency = 1
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.TextStrokeTransparency = 0.2
	hpText.Font = Enum.Font.GothamBold
	hpText.TextScaled = true
	hpText.ZIndex = 2
	hpText.Parent = back

	gui.Parent = model
	self.model = model
	self.fill = fill
	self.hpText = hpText
	self:updateBar()
	model:PivotTo(CFrame.new(self.position + Vector3.new(0, self.hipHeight, 0)))
	model.Parent = folder
end

function Companion:setVisible(visible: boolean)
	if not self.model then
		return
	end
	for _, d in ipairs(self.model:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			if visible then
				local original = d:GetAttribute("OriginalTransparency")
				if original then
					d.Transparency = original
				end
			else
				if d:GetAttribute("OriginalTransparency") == nil then
					d:SetAttribute("OriginalTransparency", d.Transparency)
				end
				d.Transparency = 1
			end
		elseif d:IsA("BillboardGui") or d:IsA("ParticleEmitter") or d:IsA("PointLight") or d:IsA("Highlight") then
			d.Enabled = visible
		end
	end
end

function Companion:takeDamage(amount: number, attackerState)
	if not self:isAlive() then
		return
	end
	amount = math.max(1, math.floor(amount + 0.5))
	self.health -= amount
	self.lastDamage = os.clock()

	local h = Instance.new("Highlight")
	h.FillColor = Color3.fromRGB(255, 60, 60)
	h.FillTransparency = 0.3
	h.OutlineTransparency = 1
	h.Parent = self.model
	Debris:AddItem(h, 0.15)
	WildService.floatingText(self.position + Vector3.new(0, self.hipHeight * 2 + 1, 0), "-" .. amount, Color3.fromRGB(255, 150, 60))

	-- revida em quem bateu
	if attackerState and not isCompanion(attackerState) and not self.duelTarget
		and (not self.target or not tAlive(self.target)) then
		self.target = attackerState
	end

	if self.health <= 0 then
		self.health = 0
		self:faint()
	end
	self:updateBar()
end

function Companion:faint()
	self.fainted = true
	self.faintedUntil = os.clock() + CC.FaintTime
	self.target = nil
	self.queuedMove = nil
	faintMemory[self.player] = { uid = self.item.uid, untilTime = self.faintedUntil }
	WildService.poof(self.position + Vector3.new(0, 2, 0), Color3.fromRGB(150, 150, 150))
	self:setVisible(false)
	Remotes.CompanionEvent:FireClient(self.player, "faint", Stats.displayName(self.def, self.item.level, self.item.mutation), CC.FaintTime)
end

function Companion:revive()
	self.fainted = false
	self.health = self.maxHealth
	faintMemory[self.player] = nil
	if self.needsRebuild then
		self.needsRebuild = false
		self:buildModel()
	end
	local character = self.player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp then
		self.position = (hrp.CFrame * CFrame.new(3, -2, CC.FollowDistance)).Position
	end
	self:setVisible(true)
	self:updateBar()
	WildService.poof(self.position + Vector3.new(0, 2, 0), Color3.fromRGB(120, 230, 255))
	Remotes.CompanionEvent:FireClient(self.player, "revive", Stats.displayName(self.def, self.item.level, self.item.mutation))
end

function Companion:destroy()
	self.destroyed = true
	if self.model then
		self.model:Destroy()
		self.model = nil
	end
end

---------------------------------------------------------------------
-- Ataques
---------------------------------------------------------------------
local function projectile(fromPos: Vector3, toPos: Vector3, color: Color3, size: number, onArrive)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * size
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CFrame = CFrame.new(fromPos)
	p.Parent = workspace
	local trail = Instance.new("Trail")
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, size / 3, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -size / 3, 0)
	a1.Parent = p
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(color)
	trail.Lifetime = 0.25
	trail.Parent = p

	local travel = math.clamp((toPos - fromPos).Magnitude / 90, 0.12, 0.5)
	local tween = TweenService:Create(p, TweenInfo.new(travel, Enum.EasingStyle.Linear), { CFrame = CFrame.new(toPos) })
	tween:Play()
	tween.Completed:Connect(function()
		p:Destroy()
		onArrive()
	end)
end

local function shockwave(position: Vector3, radius: number, color: Color3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 2, 2)
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.45), { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.5)
end

-- dá dano em um alvo (selvagem ou parceiro inimigo no duelo)
function Companion:hit(target, damage: number)
	if isCompanion(target) then
		target:takeDamage(damage * Config.Duel.CompanionDamageScale, self)
	else
		WildService.damage(target, damage, self.player, if self:isAlive() then self else nil)
	end
end

function Companion:performMove(move, target)
	local damage = self.power * move.power
	local color = Config.getRarity(self.def.rarity).color
	local moveName = Stats.moveName(move, self.def)
	self.lastBasic = os.clock() -- não usa o ataque básico junto

	if move.kind == "Melee" then
		self.phase += 2.5 -- pulinho de ataque
		if move.id ~= "Basico" then
			WildService.floatingText(self.position + Vector3.new(0, self.hipHeight * 2 + 2, 0), moveName .. "!", color)
			WildService.poof(tPos(target) + Vector3.new(0, 2, 0), color)
		end
		self:hit(target, damage)
	elseif move.kind == "Projectile" then
		WildService.floatingText(self.position + Vector3.new(0, self.hipHeight * 2 + 2, 0), moveName .. "!", color)
		local fromPos = self.position + Vector3.new(0, self.hipHeight * 1.5, 0)
		local targetPos = tPos(target) + Vector3.new(0, tHeight(target) / 2 + 0.5, 0)
		local size = if move.signature then 2.5 else 1.4
		projectile(fromPos, targetPos, color, size, function()
			if tAlive(target) then
				if move.signature then
					shockwave(targetPos, 6, color)
				end
				self:hit(target, damage)
			end
		end)
	elseif move.kind == "Area" then
		WildService.floatingText(self.position + Vector3.new(0, self.hipHeight * 2 + 2, 0), moveName .. "!", color)
		shockwave(self.position + Vector3.new(0, 0.3, 0), move.range, color)
		local duelTarget = self.duelTarget
		if duelTarget then
			if tAlive(duelTarget) and flat(tPos(duelTarget) - self.position).Magnitude - tRadius(duelTarget) <= move.range then
				self:hit(duelTarget, damage)
			end
		else
			for _, state in ipairs(WildService.getInRadius(self.position, move.range)) do
				self:hit(state, damage)
			end
		end
	end
end

---------------------------------------------------------------------
-- IA (roda todo frame)
---------------------------------------------------------------------
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

local function updateGroundFilter()
	local list = { folder }
	local wild = workspace:FindFirstChild("WildBrainrots")
	if wild then
		table.insert(list, wild)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	groundParams.FilterDescendantsInstances = list
end

local function holdingBall(player: Player): boolean
	local character = player.Character
	return character ~= nil and character:FindFirstChild("Bola") ~= nil
end

function Companion:update(dt: number, now: number)
	if self.destroyed or not self.model then
		return
	end
	if self.fainted then
		if now >= self.faintedUntil then
			self:revive()
		end
		return
	end

	local player = self.player
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local ownerPos = hrp.Position

	-- regenerar fora de combate
	if self.health < self.maxHealth and now - self.lastDamage > CC.RegenDelay then
		self.health = math.min(self.maxHealth, self.health + self.maxHealth * CC.RegenPercentPerSecond * dt)
		self:updateBar()
	end

	-- validar alvo (no duelo, o alvo é o parceiro do adversário)
	local target = self.target
	if self.duelTarget then
		target = if tAlive(self.duelTarget) then self.duelTarget else nil
		self.target = target
	else
		if target and (isCompanion(target) or not tAlive(target)
			or flat(tPos(target) - ownerPos).Magnitude > CC.LeashDistance) then
			self.target = nil
			self.queuedMove = nil
			target = nil
		end
		if not target then
			target = WildService.findAggressor(player, self, ownerPos, CC.AutoTargetRadius + 10)
			if not target and player:GetAttribute("AutoBattle") ~= false then
				target = WildService.findNearest(ownerPos, CC.AutoTargetRadius)
			end
			self.target = target
		end
	end

	-- segurando a bola + selvagem com pouca vida = o parceiro espera você capturar
	local holdFire = target ~= nil and not isCompanion(target) and holdingBall(player)
		and target.health / target.maxHealth <= 0.25

	-- longe demais? teleporta para perto do dono
	if flat(self.position - ownerPos).Magnitude > CC.TeleportDistance then
		self.position = (hrp.CFrame * CFrame.new(3, -2, CC.FollowDistance)).Position
	end

	local goal, stopDist
	local speed = math.max(self.def.speed * 1.3, CC.MinSpeed)
	if target and not holdFire then
		goal = tPos(target)
		stopDist = BASIC.range * 0.6 + tRadius(target) + self.radius
	else
		goal = (hrp.CFrame * CFrame.new(3, 0, CC.FollowDistance)).Position
		stopDist = 1.5
		if flat(goal - self.position).Magnitude > 20 then
			speed *= 1.6
		end
	end

	local offset = flat(goal - self.position)
	local dist = offset.Magnitude
	local moving = false
	if dist > stopDist then
		local dir = offset.Unit
		self.position += dir * math.min(speed * dt, dist - stopDist)
		self.yaw = math.atan2(-dir.X, -dir.Z)
		moving = true
	end
	if target then
		local look = flat(tPos(target) - self.position)
		if look.Magnitude > 0.1 then
			look = look.Unit
			self.yaw = math.atan2(-look.X, -look.Z)
		end
	end

	-- achar o chão
	local result = workspace:Raycast(
		Vector3.new(self.position.X, ownerPos.Y + 15, self.position.Z), Vector3.new(0, -60, 0), groundParams)
	local groundY = if result then result.Position.Y else ownerPos.Y - 3
	self.position = Vector3.new(self.position.X, groundY, self.position.Z)

	local hop
	if moving then
		self.phase += dt * speed * 0.6
		hop = math.abs(math.sin(self.phase)) * 0.8
	else
		hop = math.abs(math.sin(now * 2 + self.phase)) * 0.15
	end
	self.model:PivotTo(CFrame.new(self.position + Vector3.new(0, self.hipHeight + hop, 0)) * CFrame.Angles(0, self.yaw, 0))

	-- atacar
	if target and not holdFire then
		local targetDist = flat(tPos(target) - self.position).Magnitude - tRadius(target) - self.radius
		local queued = self.queuedMove
		if queued and targetDist <= queued.range then
			self.queuedMove = nil
			self:performMove(queued, target)
		elseif targetDist <= BASIC.range and now - self.lastBasic >= BASIC.cooldown then
			self:performMove(BASIC, target)
		end
	end
end

---------------------------------------------------------------------
-- API
---------------------------------------------------------------------
function CompanionService.get(player: Player)
	return active[player]
end

function CompanionService.spawn(player: Player)
	local data = DataService.get(player)
	if not data or not data.companion then
		return
	end
	local item = DataService.findItem(player, data.companion)
	local def = item and Config.getBrainrot(item.id)
	if not def then
		data.companion = nil
		return
	end

	local old = active[player]
	if old then
		old:destroy()
	end

	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local startPos = if hrp then (hrp.CFrame * CFrame.new(3, -2, CC.FollowDistance)).Position else Vector3.zero

	local comp = setmetatable({
		player = player,
		item = item,
		def = def,
		position = startPos,
		yaw = 0,
		phase = 0,
		lastBasic = 0,
		lastDamage = 0,
		cooldowns = {},
		target = nil,
		queuedMove = nil,
		fainted = false,
		faintedUntil = 0,
		destroyed = false,
	}, Companion)
	comp:refreshStats(true)
	comp:buildModel()
	active[player] = comp

	-- se ele tinha desmaiado há pouco, continua desmaiado
	local memory = faintMemory[player]
	if memory and memory.uid == item.uid and os.clock() < memory.untilTime then
		comp.health = 0
		comp.fainted = true
		comp.faintedUntil = memory.untilTime
		comp:setVisible(false)
		comp:updateBar()
	end
	return comp
end

function CompanionService.summon(player: Player, uid: string)
	local data = DataService.get(player)
	local item = DataService.findItem(player, uid)
	if not data or not item then
		return false, "Brainrot não encontrado."
	end
	if item.slot then
		return false, "Tire ele do pedestal primeiro."
	end
	data.companion = uid
	local comp = CompanionService.spawn(player)
	DataService.pushUpdate(player)
	if not comp then
		return false, "Não deu para chamar o parceiro."
	end
	return true, Stats.displayName(comp.def, item.level, item.mutation) .. " é seu parceiro! ⚔"
end

-- keepData = true quando o jogador sai do jogo (o parceiro volta na próxima vez)
function CompanionService.dismiss(player: Player, keepData: boolean?)
	local comp = active[player]
	if comp then
		comp:destroy()
		active[player] = nil
	end
	if not keepData then
		local data = DataService.get(player)
		if data then
			data.companion = nil
			DataService.pushUpdate(player)
		end
	end
	return true, "Parceiro guardado."
end

-- O jogador bateu em alguém com o taco: o parceiro ataca o mesmo
function CompanionService.setTarget(player: Player, state)
	local comp = active[player]
	if comp and comp:isAlive() and WildService.isAlive(state) then
		comp.target = state
	end
end

function CompanionService.useMove(player: Player, moveId: any, targetModel: any)
	local comp = active[player]
	if not comp then
		return false, "Escolha um parceiro no menu 🎒 Brainrots."
	end
	if not comp:isAlive() then
		return false, "Seu parceiro está desmaiado."
	end
	local move = type(moveId) == "string" and Config.getMove(moveId)
	if not move or move.auto then
		return false, nil
	end
	if comp.item.level < move.level then
		return false, Stats.moveName(move, comp.def) .. " só no nível " .. move.level .. "."
	end
	local now = os.clock()
	if comp.cooldowns[move.id] and now < comp.cooldowns[move.id] then
		return false, nil
	end

	if move.kind == "Area" then
		comp.cooldowns[move.id] = now + move.cooldown
		comp:performMove(move, nil)
		return true, nil
	end

	-- alvo: no duelo é o parceiro inimigo; senão o que está embaixo do mouse, o atual, ou o mais perto
	local target
	if comp.duelTarget then
		target = comp.duelTarget
		if not tAlive(target) then
			return false, "O parceiro do adversário está desmaiado."
		end
	else
		if typeof(targetModel) == "Instance" then
			target = WildService.getStateFromModel(targetModel)
		end
		if target and flat(WildService.getPosition(target) - comp.position).Magnitude > CC.LeashDistance then
			target = nil
		end
		if comp.target and not isCompanion(comp.target) then
			target = target or comp.target
		end
		target = target or WildService.findNearest(comp.position, math.max(move.range, CC.AutoTargetRadius))
		if not target or not tAlive(target) then
			return false, "Nenhum brainrot selvagem por perto."
		end
	end

	comp.cooldowns[move.id] = now + move.cooldown
	comp.target = target
	local dist = flat(tPos(target) - comp.position).Magnitude - tRadius(target) - comp.radius
	if dist <= move.range then
		comp:performMove(move, target)
	else
		comp.queuedMove = move -- vai correndo e usa quando chegar perto
	end
	return true, nil
end

-- Duelo: o parceiro do jogador luta contra o parceiro do adversário (nil = acabou)
function CompanionService.setDuelTarget(player: Player, enemy: Player?)
	local comp = active[player]
	if not comp then
		return
	end
	comp.duelTarget = if enemy then active[enemy] else nil
	comp.target = nil
	comp.queuedMove = nil
	if comp.fainted and enemy then
		-- começa o duelo inteiro
		comp.faintedUntil = os.clock()
	end
end

-- XP, níveis, novos ataques e evolução
function CompanionService.grantXp(player: Player, amount: number)
	local comp = active[player]
	if not comp or amount <= 0 then
		return
	end
	local item = comp.item
	local maxLevel = Config.Levels.MaxLevel
	if item.level >= maxLevel then
		return
	end

	item.xp += amount
	WildService.floatingText(comp.position + Vector3.new(0, comp.hipHeight * 2 + 3, 0), "+" .. amount .. " XP", Color3.fromRGB(120, 230, 255))

	local oldLevel = item.level
	local oldStage = Stats.stage(oldLevel)
	local oldName = Stats.displayName(comp.def, oldLevel, item.mutation)
	while item.level < maxLevel and item.xp >= Stats.xpToNext(item.level) do
		item.xp -= Stats.xpToNext(item.level)
		item.level += 1
	end
	if item.level >= maxLevel then
		item.xp = 0
	end

	if item.level > oldLevel then
		local newStage = Stats.stage(item.level)
		comp:refreshStats(true)
		if comp.model then
			comp.model:SetAttribute("Level", item.level)
		end

		if comp.fainted then
			comp.needsRebuild = true -- reconstrói quando ele voltar
			comp.health = 0
		end
		if newStage > oldStage then
			if not comp.fainted then
				comp:buildModel() -- modelo maior e com efeitos
			end
			local newName = Stats.displayName(comp.def, item.level, item.mutation)
			Remotes.CompanionEvent:FireClient(player, "evolve", oldName, newName)
			WildService.poof(comp.position + Vector3.new(0, 3, 0), Color3.fromRGB(255, 230, 80))
		elseif not comp.fainted then
			comp:buildModel() -- atualiza o nome/nível na placa
		end

		Remotes.CompanionEvent:FireClient(player, "levelup", Stats.displayName(comp.def, item.level, item.mutation), item.level)
		for _, move in ipairs(Config.Moves) do
			if move.level > oldLevel and move.level <= item.level then
				Remotes.CompanionEvent:FireClient(player, "learn", Stats.moveName(move, comp.def), move.key)
			end
		end
	end
	DataService.pushUpdate(player)
end

function CompanionService.onCaptured(player: Player, state)
	local xp = math.floor(Stats.xpReward(state.def, state.level) * Config.Levels.CaptureXpShare)
	CompanionService.grantXp(player, xp)
end

function CompanionService.start()
	WildService.onDefeated(function(state, player)
		CompanionService.grantXp(player, Stats.xpReward(state.def, state.level))
	end)
	WildService.onPlayerAttacked(function(player, state)
		local comp = active[player]
		if comp and comp:isAlive() and not comp.target and not comp.duelTarget then
			comp.target = state
		end
	end)
	-- pancada dos chefões também acerta os parceiros
	WildService.onBossSlam(function(position, radius, damage, state)
		for _, comp in pairs(active) do
			if comp:isAlive() and (comp.position - position).Magnitude <= radius + comp.radius then
				comp:takeDamage(damage, state)
			end
		end
	end)

	local filterTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		filterTimer -= dt
		if filterTimer <= 0 then
			filterTimer = 1
			updateGroundFilter()
		end
		local now = os.clock()
		for player, comp in pairs(active) do
			local ok, err = pcall(comp.update, comp, dt, now)
			if not ok then
				warn("[CompanionService] erro no parceiro de " .. player.Name .. ": " .. tostring(err))
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		CompanionService.dismiss(player, true)
		faintMemory[player] = nil
	end)
end

return CompanionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Salva e carrega os dados dos jogadores (dinheiro, bolas, brainrots, tacos...).

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local Remotes = require(script.Parent.Remotes)

local DataService = {}

local profiles = {} -- [Player] = dados

local store
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore indisponível (no Studio ative 'Enable Studio Access to API Services'). Os dados não serão salvos.")
	end
end

local function deepCopy(t)
	local copy = {}
	for k, v in pairs(t) do
		copy[k] = if type(v) == "table" then deepCopy(v) else v
	end
	return copy
end

local function defaultData()
	return {
		cash = Config.StartingCash,
		balls = deepCopy(Config.StartingBalls),
		bat = "Madeira",
		ownedBats = { Madeira = true },
		-- lista de { uid = "1", id = "TungTung", level = 1, xp = 0, mutation = nil/"Magma", slot = nil/número do pedestal }
		inventory = {},
		-- companion = uid do brainrot parceiro (ou nil)
		playerLevel = 1,
		playerXp = 0,
		rebirths = 0,
		bosses = {}, -- [id do chefão] = true
		ownedGear = {}, -- [id do equipamento] = true
		unlockedSlots = Config.Tycoon.StartingSlots,
		dex = {}, -- [id] = quantas vezes capturou
		nextUid = 1,
		totalCaught = 0,
	}
end

-- Completa campos que faltam (útil quando você adiciona coisas novas ao jogo)
local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = if type(v) == "table" then deepCopy(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" and k ~= "inventory" then
			reconcile(data[k], v)
		end
	end
end

local function key(player: Player)
	return "player_" .. player.UserId
end

local function setupLeaderstats(player: Player, data)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local cash = Instance.new("IntValue")
	cash.Name = "Dinheiro"
	cash.Value = data.cash
	cash.Parent = leaderstats

	local caught = Instance.new("IntValue")
	caught.Name = "Capturados"
	caught.Value = data.totalCaught
	caught.Parent = leaderstats

	local level = Instance.new("IntValue")
	level.Name = "Nível"
	level.Value = data.playerLevel
	level.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.rebirths
	rebirths.Parent = leaderstats

	leaderstats.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	leaderstats.Dinheiro.Value = math.floor(data.cash)
	leaderstats.Capturados.Value = data.totalCaught
	leaderstats["Nível"].Value = data.playerLevel
	leaderstats.Rebirths.Value = data.rebirths
end

function DataService.load(player: Player)
	local data
	local loadFailed = false

	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			data = result
		else
			loadFailed = true
			warn("[DataService] Falha ao carregar dados de " .. player.Name .. ": " .. tostring(result))
		end
	end

	if type(data) ~= "table" then
		data = defaultData()
	else
		reconcile(data, defaultData())
	end

	-- remove brainrots que não existem mais na Config e completa nível/XP de saves antigos
	local companionFound = false
	for i = #data.inventory, 1, -1 do
		local item = data.inventory[i]
		if not Config.getBrainrot(item.id) then
			table.remove(data.inventory, i)
		else
			item.level = math.clamp(math.floor(tonumber(item.level) or 1), 1, Config.Levels.MaxLevel)
			item.xp = tonumber(item.xp) or 0
			if item.mutation and not Config.getMutation(item.mutation) then
				item.mutation = nil
			end
			if item.uid == data.companion then
				companionFound = true
				item.slot = nil
			end
		end
	end
	if not companionFound then
		data.companion = nil
	end

	-- se falhou o carregamento, não salva por cima (para não apagar o progresso)
	data._loadFailed = loadFailed
	profiles[player] = data
	setupLeaderstats(player, data)

	if player:GetAttribute("SelectedBall") == nil then
		player:SetAttribute("SelectedBall", "Basica")
	end

	return data
end

function DataService.save(player: Player)
	local data = profiles[player]
	if not data or not store or data._loadFailed then
		return
	end

	local toSave = deepCopy(data)
	toSave._loadFailed = nil

	local ok, err = pcall(function()
		store:SetAsync(key(player), toSave)
	end)
	if not ok then
		warn("[DataService] Falha ao salvar " .. player.Name .. ": " .. tostring(err))
	end
end

function DataService.release(player: Player)
	DataService.save(player)
	profiles[player] = nil
end

function DataService.get(player: Player)
	return profiles[player]
end

function DataService.snapshot(player: Player)
	local data = profiles[player]
	if not data then
		return nil
	end
	return {
		cash = data.cash,
		balls = data.balls,
		bat = data.bat,
		ownedBats = data.ownedBats,
		inventory = data.inventory,
		unlockedSlots = data.unlockedSlots,
		dex = data.dex,
		totalCaught = data.totalCaught,
		companion = data.companion,
		playerLevel = data.playerLevel,
		playerXp = data.playerXp,
		rebirths = data.rebirths,
		bosses = data.bosses,
		ownedGear = data.ownedGear,
		autoBattle = player:GetAttribute("AutoBattle") ~= false,
		selectedBall = player:GetAttribute("SelectedBall") or "Basica",
	}
end

function DataService.pushUpdate(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	updateLeaderstats(player, data)
	Remotes.DataUpdated:FireClient(player, DataService.snapshot(player))
	for _, callback in ipairs(DataService.updateListeners) do
		task.spawn(callback, player)
	end
end

-- Outros sistemas podem pedir para ser avisados quando os dados mudam
DataService.updateListeners = {}
function DataService.onUpdate(callback)
	table.insert(DataService.updateListeners, callback)
end

---------------------------------------------------------------------
-- Dinheiro
---------------------------------------------------------------------
function DataService.addCash(player: Player, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.cash += amount
	DataService.pushUpdate(player)
end

function DataService.spendCash(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or data.cash < amount then
		return false
	end
	data.cash -= amount
	DataService.pushUpdate(player)
	return true
end

---------------------------------------------------------------------
-- Bolas
---------------------------------------------------------------------
function DataService.useBall(player: Player, ballId: string): boolean
	local data = profiles[player]
	if not data then
		return false
	end
	local count = data.balls[ballId] or 0
	if count <= 0 then
		return false
	end
	data.balls[ballId] = count - 1
	DataService.pushUpdate(player)
	return true
end

function DataService.addBalls(player: Player, ballId: string, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.balls[ballId] = (data.balls[ballId] or 0) + amount
	DataService.pushUpdate(player)
end

---------------------------------------------------------------------
-- Brainrots
---------------------------------------------------------------------
function DataService.addBrainrot(player: Player, brainrotId: string, level: number?, mutation: string?, xp: number?)
	local data = profiles[player]
	if not data then
		return nil
	end
	local item = { uid = tostring(data.nextUid), id = brainrotId, level = level or 1, xp = xp or 0, mutation = mutation }
	data.nextUid += 1
	table.insert(data.inventory, item)
	data.dex[brainrotId] = (data.dex[brainrotId] or 0) + 1
	data.totalCaught += 1
	DataService.pushUpdate(player)
	return item
end

function DataService.findItem(player: Player, uid: string)
	local data = profiles[player]
	if not data then
		return nil, nil
	end
	for i, item in ipairs(data.inventory) do
		if item.uid == uid then
			return item, i
		end
	end
	return nil, nil
end

function DataService.removeBrainrot(player: Player, uid: string)
	local data = profiles[player]
	local item, i = DataService.findItem(player, uid)
	if not item then
		return nil
	end
	table.remove(data.inventory, i)
	if data.companion == uid then
		data.companion = nil
	end
	DataService.pushUpdate(player)
	return item
end

-- Passa um brainrot de um jogador para outro (troca, roubo, duelo). Mantém nível, XP e mutação.
-- Quem chama precisa atualizar pedestal/parceiro antes.
function DataService.transferItem(from: Player, to: Player, uid: string)
	local fromData, toData = profiles[from], profiles[to]
	local item = DataService.findItem(from, uid)
	if not fromData or not toData or not item then
		return nil
	end
	DataService.removeBrainrot(from, uid)
	local newItem = { uid = tostring(toData.nextUid), id = item.id, level = item.level or 1, xp = item.xp or 0, mutation = item.mutation }
	toData.nextUid += 1
	table.insert(toData.inventory, newItem)
	toData.dex[item.id] = toData.dex[item.id] or 1
	DataService.pushUpdate(to)
	return newItem, item
end

---------------------------------------------------------------------
-- Nível do jogador
---------------------------------------------------------------------
-- Retorna quantos níveis subiu
function DataService.addPlayerXp(player: Player, amount: number): number
	local data = profiles[player]
	if not data or amount <= 0 then
		return 0
	end
	local max = Config.PlayerLevels.Max
	if data.playerLevel >= max then
		return 0
	end
	data.playerXp += amount
	local gained = 0
	while data.playerLevel < max and data.playerXp >= Stats.playerXpToNext(data.playerLevel) do
		data.playerXp -= Stats.playerXpToNext(data.playerLevel)
		data.playerLevel += 1
		gained += 1
	end
	if data.playerLevel >= max then
		data.playerXp = 0
	end
	DataService.pushUpdate(player)
	return gained
end

---------------------------------------------------------------------
-- Salvamento automático
---------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(Config.AutoSaveInterval)
		for player in pairs(profiles) do
			task.spawn(DataService.save, player)
		end
	end
end)

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">DuelService</string><ProtectedString name="Source"><![CDATA[-- DUELO: desafie outro jogador. Os dois vão para a Arena e lutam com os objetos de bater
-- (e os parceiros lutam entre si). Quem cair perde. O vencedor escolhe um brainrot
-- do perdedor, e o perdedor pode PAGAR um resgate para não perder ele.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local DataService = require(script.Parent.DataService)
local TycoonService = require(script.Parent.TycoonService)
local CompanionService = require(script.Parent.CompanionService)
local StealService = require(script.Parent.StealService)
local ProgressService = require(script.Parent.ProgressService)
local Remotes = require(script.Parent.Remotes)

local DuelService = {}

local D = Config.Duel
local fmt = CatchMath.formatNumber
local RED = Color3.fromRGB(255, 120, 120)
local GREEN = Color3.fromRGB(120, 255, 140)
local GOLD = Color3.fromRGB(255, 220, 90)
local REQUEST_TIME = 20

local requests = {} -- [alvo] = { from, time }
local duels = {} -- [Player] = duelo

function DuelService.isInDuel(player: Player): boolean
	return duels[player] ~= nil
end

local function ransomPrice(item): number
	local def = Config.getBrainrot(item.id)
	return math.max(100, math.floor(Stats.sellPrice(def, item.level or 1, item.mutation) * D.RansomMultiplier))
end

local function cleanup(duel)
	for _, p in ipairs({ duel.a, duel.b }) do
		if duels[p] == duel then
			duels[p] = nil
		end
	end
end

local function sendHome(player: Player)
	task.delay(2.5, function()
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			humanoid.Health = humanoid.MaxHealth
			TycoonService.teleportHome(player)
		end
	end)
end

local function resolve(duel, pay: boolean)
	if duel.resolved then
		return
	end
	duel.resolved = true
	local winner, loser = duel.winner, duel.loser
	local loserData = DataService.get(loser)
	local item = loserData and DataService.findItem(loser, duel.pickedUid)
	if not item or winner.Parent ~= Players then
		cleanup(duel)
		return
	end
	local def = Config.getBrainrot(item.id)
	local name = Stats.displayName(def, item.level or 1, item.mutation)
	local price = ransomPrice(item)

	if pay and loserData.cash >= price then
		loserData.cash -= price
		DataService.addCash(winner, price)
		DataService.pushUpdate(loser)
		Remotes.notify(loser, "💸 Você pagou $" .. fmt(price) .. " e salvou " .. name .. "!", GOLD)
		Remotes.notify(winner, "💰 " .. loser.DisplayName .. " pagou $" .. fmt(price) .. " de resgate por " .. name .. "!", GREEN)
	else
		if loserData.companion == item.uid then
			CompanionService.dismiss(loser)
		end
		local _, oldItem = DataService.transferItem(loser, winner, item.uid)
		if oldItem then
			TycoonService.onItemRemoved(loser, oldItem)
		end
		Remotes.notify(winner, "🏆 Você ganhou " .. name .. " do duelo! Ele está na sua barra de itens.", GREEN)
		Remotes.notify(loser, "😭 " .. winner.DisplayName .. " levou seu " .. name .. ".", RED)
	end
	cleanup(duel)
end

local function startRansom(duel, uid: string)
	local item = DataService.findItem(duel.loser, uid)
	if not item then
		resolve(duel, false)
		return
	end
	duel.phase = "ransom"
	duel.pickedUid = uid
	local def = Config.getBrainrot(item.id)
	local name = Stats.displayName(def, item.level or 1, item.mutation)
	Remotes.Social:FireClient(duel.loser, "duelRansom", {
		winnerName = duel.winner.DisplayName, itemName = name, price = ransomPrice(item), time = D.RansomTime,
	})
	Remotes.notify(duel.winner, "Você escolheu " .. name .. ". Esperando " .. duel.loser.DisplayName .. " decidir se paga o resgate...", GOLD)
	task.delay(D.RansomTime, function()
		if duel.phase == "ransom" and not duel.resolved then
			resolve(duel, false)
		end
	end)
end

local function finishDuel(duel, winner: Player?, loser: Player?, reason: string?)
	if duel.ended then
		return
	end
	duel.ended = true
	for _, c in ipairs(duel.connections) do
		c:Disconnect()
	end
	for _, p in ipairs({ duel.a, duel.b }) do
		p:SetAttribute("InDuel", nil)
		p:SetAttribute("Frozen", nil)
		CompanionService.setDuelTarget(p, nil)
		if p.Parent == Players then
			Remotes.Social:FireClient(p, "duelEnded", { won = p == winner, draw = winner == nil })
		end
	end

	if not winner or not loser then
		for _, p in ipairs({ duel.a, duel.b }) do
			if p.Parent == Players then
				Remotes.notify(p, "⚔ Duelo terminou empatado" .. (if reason then " (" .. reason .. ")" else "") .. ".", GOLD)
				sendHome(p)
			end
		end
		cleanup(duel)
		return
	end

	duel.winner, duel.loser = winner, loser
	Remotes.notify(winner, "🏆 Você venceu o duelo contra " .. loser.DisplayName .. "!", GREEN)
	ProgressService.giveXp(winner, 150)
	sendHome(winner)

	local loserData = DataService.get(loser)
	if not loserData or loser.Parent ~= Players then
		cleanup(duel)
		return
	end
	Remotes.notify(loser, "💀 Você perdeu o duelo para " .. winner.DisplayName .. ".", RED)

	-- lista de brainrots que o vencedor pode escolher
	local items = {}
	for _, item in ipairs(loserData.inventory) do
		if not TycoonService.isItemStolen(loser, item.uid) then
			local def = Config.getBrainrot(item.id)
			table.insert(items, {
				uid = item.uid, id = item.id, level = item.level or 1, mutation = item.mutation,
				name = Stats.displayName(def, item.level or 1, item.mutation), rarity = def.rarity,
				value = Stats.sellPrice(def, item.level or 1, item.mutation),
			})
		end
	end

	if #items == 0 then
		local prize = math.floor(loserData.cash * 0.1)
		if prize > 0 then
			loserData.cash -= prize
			DataService.pushUpdate(loser)
			DataService.addCash(winner, prize)
		end
		Remotes.notify(winner, loser.DisplayName .. " não tem brainrots. Você ganhou $" .. fmt(prize) .. ".", GOLD)
		cleanup(duel)
		return
	end

	table.sort(items, function(x, y)
		return x.value > y.value
	end)
	duel.phase = "pick"
	duel.pickItems = items
	Remotes.Social:FireClient(winner, "duelPick", { loserName = loser.DisplayName, items = items, time = D.PickTime })
	Remotes.notify(loser, winner.DisplayName .. " está escolhendo um brainrot seu... 😬", RED)
	task.delay(D.PickTime, function()
		if duel.phase == "pick" then
			startRansom(duel, items[1].uid) -- escolhe o mais valioso automaticamente
		end
	end)
end

local function startDuel(a: Player, b: Player)
	local duel = { a = a, b = b, connections = {}, phase = "countdown" }
	duels[a] = duel
	duels[b] = duel

	local arena = D.Arena
	local spots = {
		[a] = CFrame.lookAt(arena + Vector3.new(-D.PadOffset, 4, 0), arena + Vector3.new(0, 4, 0)),
		[b] = CFrame.lookAt(arena + Vector3.new(D.PadOffset, 4, 0), arena + Vector3.new(0, 4, 0)),
	}
	for _, p in ipairs({ a, b }) do
		local other = if p == a then b else a
		local character = p.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			finishDuel(duel, nil, nil, "sem personagem")
			return
		end
		character:PivotTo(spots[p])
		humanoid.Health = humanoid.MaxHealth
		p:SetAttribute("InDuel", true)
		p:SetAttribute("Frozen", true)
		Remotes.Social:FireClient(p, "duelCountdown", { opponent = other.DisplayName, seconds = D.Countdown })
		table.insert(duel.connections, humanoid.Died:Connect(function()
			finishDuel(duel, other, p)
		end))
	end

	task.delay(D.Countdown, function()
		if duel.ended then
			return
		end
		duel.phase = "fight"
		for _, p in ipairs({ a, b }) do
			p:SetAttribute("Frozen", nil)
			Remotes.Social:FireClient(p, "duelFight", {})
		end
		CompanionService.setDuelTarget(a, b)
		CompanionService.setDuelTarget(b, a)
	end)

	task.delay(D.Countdown + D.MaxTime, function()
		if not duel.ended then
			finishDuel(duel, nil, nil, "tempo esgotado")
		end
	end)
end

---------------------------------------------------------------------
-- Ações chamadas pela interface
---------------------------------------------------------------------
local function canDuel(player: Player): (boolean, string?)
	if duels[player] then
		return false, "Já está em um duelo."
	end
	if StealService.isCarrying(player) then
		return false, "Está carregando um brainrot roubado."
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false, "Precisa estar vivo."
	end
	return true, nil
end

function DuelService.request(from: Player, targetUserId: any)
	local target = type(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
	if not target or target == from then
		return false, "Jogador não encontrado."
	end
	local ok, why = canDuel(from)
	if not ok then
		return false, why
	end
	ok, why = canDuel(target)
	if not ok then
		return false, target.DisplayName .. ": " .. (why or "não pode duelar agora")
	end
	requests[target] = { from = from, time = os.clock() }
	Remotes.Social:FireClient(target, "duelRequest", { fromName = from.DisplayName, fromUserId = from.UserId })
	return true, "⚔ Desafio enviado para " .. target.DisplayName .. "!"
end

function DuelService.respond(target: Player, accept: any)
	local req = requests[target]
	requests[target] = nil
	if not req or os.clock() - req.time > REQUEST_TIME or req.from.Parent ~= Players then
		return false, "O desafio expirou."
	end
	if not accept then
		Remotes.notify(req.from, target.DisplayName .. " recusou o duelo. 🐔", RED)
		return true, nil
	end
	local ok, why = canDuel(req.from)
	if ok then
		ok, why = canDuel(target)
	end
	if not ok then
		return false, why
	end
	startDuel(req.from, target)
	return true, nil
end

function DuelService.pick(player: Player, uid: any)
	local duel = duels[player]
	if not duel or duel.phase ~= "pick" or duel.winner ~= player or type(uid) ~= "string" then
		return false, nil
	end
	for _, info in ipairs(duel.pickItems) do
		if info.uid == uid then
			startRansom(duel, uid)
			return true, nil
		end
	end
	return false, "Brainrot inválido."
end

function DuelService.ransom(player: Player, pay: any)
	local duel = duels[player]
	if not duel or duel.phase ~= "ransom" or duel.loser ~= player then
		return false, nil
	end
	resolve(duel, pay == true)
	return true, nil
end

function DuelService.start()
	StealService.canStealCheck = function(player: Player)
		if duels[player] then
			return false, "Você está em um duelo!"
		end
		return true, nil
	end

	Players.PlayerRemoving:Connect(function(player)
		requests[player] = nil
		local duel = duels[player]
		if duel then
			if not duel.ended then
				local other = if duel.a == player then duel.b else duel.a
				finishDuel(duel, other, player)
			elseif duel.phase == "ransom" and duel.loser == player then
				resolve(duel, false)
			else
				cleanup(duel)
			end
		end
	end)
end

return DuelService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[-- EVENTOS: de tempos em tempos acontece um evento (Chuva Radioativa, Erupção de Magma,
-- Arco-Íris...). Durante o evento o céu muda de cor e os brainrots nascem com MUTAÇÕES,
-- que deixam eles mais fortes e dando muito mais dinheiro.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WildService = require(script.Parent.WildService)
local Remotes = require(script.Parent.Remotes)

local EventService = {}

local E = Config.Events
local rng = Random.new()
local token = 0
local saved = nil

local function notifyAll(text: string, color: Color3)
	for _, p in ipairs(Players:GetPlayers()) do
		Remotes.notify(p, text, color)
	end
end

local function setLighting(event)
	local cc = Lighting:FindFirstChild("BrainrotColorCorrectionEffect")
	local atmosphere = Lighting:FindFirstChild("BrainrotAtmosphere")
	if event then
		saved = saved or {
			tint = cc and cc.TintColor,
			atmosphere = atmosphere and atmosphere.Color,
		}
		if cc then
			cc.TintColor = event.tint
		end
		if atmosphere then
			atmosphere.Color = event.atmosphere
		end
	elseif saved then
		if cc and saved.tint then
			cc.TintColor = saved.tint
		end
		if atmosphere and saved.atmosphere then
			atmosphere.Color = saved.atmosphere
		end
		saved = nil
	end
end

function EventService.getCurrent()
	return WildService.currentEvent
end

function EventService.stopEvent()
	local event = WildService.currentEvent
	if not event then
		return
	end
	WildService.currentEvent = nil
	workspace:SetAttribute("EventId", nil)
	workspace:SetAttribute("EventEnds", nil)
	setLighting(nil)
	notifyAll("O evento " .. event.name .. " acabou.", Color3.fromRGB(200, 200, 220))
end

function EventService.startEvent(eventId: string?, duration: number?)
	local event = if eventId then Config.getEvent(eventId) else E.List[rng:NextInteger(1, #E.List)]
	if not event then
		return false
	end
	EventService.stopEvent()
	token += 1
	local myToken = token
	duration = duration or E.Duration

	WildService.currentEvent = event
	workspace:SetAttribute("EventId", event.id)
	workspace:SetAttribute("EventEnds", workspace:GetServerTimeNow() + duration)
	setLighting(event)
	notifyAll("⚠ EVENTO: " .. event.name .. "! " .. event.text, Config.getMutation(event.mutation).color)

	-- parte dos brainrots que já estão no mapa também muda
	WildService.forEachWild(function(state)
		if not state.mutation and rng:NextNumber() < event.chance * 0.6 then
			WildService.setMutation(state, event.mutation)
		end
	end)

	task.delay(duration, function()
		if token == myToken then
			EventService.stopEvent()
		end
	end)
	return true
end

function EventService.start()
	task.spawn(function()
		task.wait(E.FirstDelay)
		while true do
			EventService.startEvent(nil, E.Duration)
			task.wait(E.Duration + E.Interval)
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[-- Cada brainrot capturado (que não está no pedestal e não é o parceiro) vira um ITEM
-- na barra de itens do jogador. Segure ele e clique perto de um pedestal vazio da sua
-- base para colocar (ou use o "Colocar Brainrot" do pedestal segurando ele).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local TycoonService = require(script.Parent.TycoonService)
local BrainrotModels = require(script.Parent.BrainrotModels)
local Remotes = require(script.Parent.Remotes)

local InventoryService = {}

local UID_ATTRIBUTE = "BrainrotUid"
local HOLD_HEIGHT = 2.6 -- altura do brainrot na mão
local PLACE_DISTANCE = 16

local function createTool(player: Player, item)
	local def = Config.getBrainrot(item.id)
	if not def then
		return nil
	end
	local level = item.level or 1
	local name = Stats.displayName(def, level, item.mutation)

	local tool = Instance.new("Tool")
	tool.Name = name .. " Lv." .. level
	tool.ToolTip = "Clique perto de um pedestal vazio da sua base para colocar"
	tool.CanBeDropped = false
	tool:SetAttribute(UID_ATTRIBUTE, item.uid)
	tool:SetAttribute("Level", level)
	tool:SetAttribute("Mutation", item.mutation)

	-- miniatura do brainrot soldada na "Handle"
	local model = BrainrotModels.build(def, HOLD_HEIGHT / math.max(def.size.Y, 0.5), Stats.stage(level), item.mutation)
	local root = model.PrimaryPart
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Humanoid") then
			d:Destroy() -- modelos da Toolbox: Humanoid dentro de ferramenta dá problema
		elseif d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			if d ~= root then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = d
				weld.Parent = root
			end
		end
	end
	root.Name = "Handle"
	for _, child in ipairs(model:GetChildren()) do
		child.Parent = tool
	end
	model:Destroy()

	-- segura com o brainrot em cima da mão, um pouco para a frente
	tool.Grip = CFrame.new(0, -root.Size.Y / 2, 0.6)

	tool.Activated:Connect(function()
		InventoryService.placeHeld(player, tool)
	end)
	return tool
end

function InventoryService.placeHeld(player: Player, tool: Tool)
	local uid = tool:GetAttribute(UID_ATTRIBUTE)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not uid or not hrp or tool.Parent ~= character then
		return
	end
	local slotIndex = TycoonService.findFreeSlotNear(player, hrp.Position, PLACE_DISTANCE)
	if not slotIndex then
		Remotes.notify(player, "Chegue perto de um pedestal VAZIO da sua base 🏠 (ou desbloqueie mais pedestais).",
			Color3.fromRGB(255, 200, 90))
		return
	end
	local ok, msg = TycoonService.place(player, uid, slotIndex)
	if msg then
		Remotes.notify(player, msg, if ok then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 120, 120))
	end
end

-- Deixa os itens iguais ao inventário. reorder = true coloca os brainrots depois do Taco e da Bola.
function InventoryService.sync(player: Player, reorder: boolean?)
	local data = DataService.get(player)
	local backpack = player:FindFirstChild("Backpack")
	if not data or not backpack then
		return
	end

	local wanted = {}
	for _, item in ipairs(data.inventory) do
		if not item.slot and item.uid ~= data.companion then
			wanted[item.uid] = item
		end
	end

	local existing = {}
	-- muda o nome se a mutação mudar
	local function outdated(tool, item)
		return tool:GetAttribute("Level") ~= (item.level or 1) or tool:GetAttribute("Mutation") ~= item.mutation
	end
	for _, container in ipairs({ backpack, player.Character }) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				local uid = tool:IsA("Tool") and tool:GetAttribute(UID_ATTRIBUTE)
				if uid then
					local item = wanted[uid]
					if not item or existing[uid] or outdated(tool, item) then
						tool:Destroy() -- foi colocado/vendido, é repetido ou subiu de nível
					else
						existing[uid] = tool
					end
				end
			end
		end
	end

	if reorder then
		for _, tool in pairs(existing) do
			if tool.Parent == backpack then
				tool.Parent = nil
				tool.Parent = backpack
			end
		end
	end

	-- cria os que faltam, na ordem do inventário
	for _, item in ipairs(data.inventory) do
		if wanted[item.uid] and not existing[item.uid] then
			local tool = createTool(player, item)
			if tool then
				tool.Parent = backpack
			end
		end
	end
end

function InventoryService.start()
	DataService.onUpdate(function(player)
		InventoryService.sync(player)
	end)
end

return InventoryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000E"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[-- PROGRESSO: nível do jogador, áreas que desbloqueiam (por nível, chefão ou rebirth),
-- teleporte entre áreas, recompensa dos chefões e REBIRTH.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local DataService = require(script.Parent.DataService)
local TycoonService = require(script.Parent.TycoonService)
local WildService = require(script.Parent.WildService)
local Remotes = require(script.Parent.Remotes)

local ProgressService = {}

local fmt = CatchMath.formatNumber
local GOLD = Color3.fromRGB(255, 220, 90)
local RED = Color3.fromRGB(255, 120, 120)
local lastWarning = {}

local function progressOf(data)
	return { level = data.playerLevel, bosses = data.bosses, rebirths = data.rebirths }
end

function ProgressService.canEnter(player: Player, biome): (boolean, string?)
	local data = DataService.get(player)
	if not data then
		return false, "Carregando..."
	end
	return Stats.canEnter(progressOf(data), biome)
end

local function unlockedSet(data)
	local set = {}
	if data then
		for _, biome in ipairs(Config.Biomes) do
			if Stats.canEnter(progressOf(data), biome) then
				set[biome.id] = true
			end
		end
	end
	return set
end

local function announceNewAreas(player: Player, before)
	local data = DataService.get(player)
	local after = unlockedSet(data)
	for _, biome in ipairs(Config.Biomes) do
		if after[biome.id] and not before[biome.id] then
			Remotes.Social:FireClient(player, "areaUnlocked", biome.icon .. " " .. biome.name)
			Remotes.notify(player, "🔓 Nova área liberada: " .. biome.icon .. " " .. biome.name .. "! (menu 🗺 Áreas)", GOLD)
		end
	end
end

function ProgressService.giveXp(player: Player, amount: number)
	local data = DataService.get(player)
	if not data or amount <= 0 then
		return
	end
	local before = unlockedSet(data)
	local gained = DataService.addPlayerXp(player, math.floor(amount))
	if gained > 0 then
		Remotes.CompanionEvent:FireClient(player, "playerlevel", data.playerLevel)
		announceNewAreas(player, before)
	end
end

function ProgressService.setLevel(player: Player, level: number)
	local data = DataService.get(player)
	if not data then
		return
	end
	local before = unlockedSet(data)
	data.playerLevel = math.clamp(math.floor(level), 1, Config.PlayerLevels.Max)
	data.playerXp = 0
	DataService.pushUpdate(player)
	announceNewAreas(player, before)
end

function ProgressService.markBoss(player: Player, bossId: string)
	local data = DataService.get(player)
	if not data then
		return
	end
	local before = unlockedSet(data)
	data.bosses[bossId] = true
	DataService.pushUpdate(player)
	announceNewAreas(player, before)
end

---------------------------------------------------------------------
-- Teleporte
---------------------------------------------------------------------
local function hubCFrame(): CFrame
	local spawnLocation = workspace:FindFirstChild("SpawnLocation", true)
	if spawnLocation and spawnLocation:IsA("BasePart") then
		return spawnLocation.CFrame + Vector3.new(0, 4, 0)
	end
	return CFrame.new(0, 5, 0)
end

local function entryCFrame(biome): CFrame
	local c = biome.center
	if biome.id == "Ceu" or c.Magnitude < 1 then
		return CFrame.new(c + Vector3.new(0, 5, 0))
	end
	local toward = Vector3.new(-c.X, 0, -c.Z).Unit
	local depth = math.min(biome.size.X, biome.size.Y) / 2 - 15
	local pos = c + toward * depth + Vector3.new(0, 5, 0)
	return CFrame.lookAt(pos, Vector3.new(c.X, pos.Y, c.Z))
end

function ProgressService.teleportTo(player: Player, biomeId: string)
	local biome = Config.getBiome(biomeId)
	local character = player.Character
	if not biome or not character then
		return false, "Área inválida."
	end
	local ok, why = ProgressService.canEnter(player, biome)
	if not ok then
		return false, "🔒 " .. biome.name .. ": " .. (why or "trancado")
	end
	if player:GetAttribute("Carrying") then
		return false, "Não dá para teleportar carregando um brainrot roubado!"
	end
	if player:GetAttribute("InDuel") then
		return false, "Você está em um duelo!"
	end
	character:PivotTo(entryCFrame(biome))
	return true, "Bem-vindo a " .. biome.icon .. " " .. biome.name .. "!"
end

function ProgressService.teleportHub(player: Player)
	if player.Character then
		player.Character:PivotTo(hubCFrame())
	end
end

---------------------------------------------------------------------
-- Rebirth
---------------------------------------------------------------------
function ProgressService.rebirthInfo(rebirths: number)
	local R = Config.Rebirth
	local nextIndex = rebirths + 1
	if nextIndex > R.Max then
		return nil
	end
	return { cost = R.Costs[nextIndex], level = R.Levels[nextIndex], number = nextIndex }
end

function ProgressService.rebirth(player: Player)
	local data = DataService.get(player)
	if not data then
		return false, "Carregando..."
	end
	local info = ProgressService.rebirthInfo(data.rebirths)
	if not info then
		return false, "Você já tem o máximo de rebirths!"
	end
	if data.playerLevel < info.level then
		return false, "Precisa do nível " .. info.level .. " para o rebirth " .. info.number .. "."
	end
	if data.cash < info.cost then
		return false, "Precisa de $" .. fmt(info.cost) .. " para o rebirth " .. info.number .. "."
	end
	local before = unlockedSet(data)
	data.cash = Config.StartingCash
	data.rebirths += 1
	TycoonService.refreshPlayer(player)
	DataService.pushUpdate(player)
	announceNewAreas(player, before)
	Remotes.CompanionEvent:FireClient(player, "rebirth", data.rebirths)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			Remotes.notify(p, "♻ " .. player.DisplayName .. " fez o REBIRTH " .. data.rebirths .. "!", GOLD)
		end
	end
	return true, "♻ REBIRTH " .. data.rebirths .. "! +" .. math.floor(Config.Rebirth.IncomeBonus * 100)
		.. "% de renda, mais pedestais e itens novos na loja!"
end

---------------------------------------------------------------------
-- Iniciar
---------------------------------------------------------------------
function ProgressService.start()
	-- XP do jogador por derrotar brainrots
	WildService.onDefeated(function(state, player)
		ProgressService.giveXp(player, Stats.xpReward(state.def, state.level))
	end)

	-- chefões: todo mundo que bateu ganha a recompensa e desbloqueia a área
	WildService.onBossDefeated(function(cfg, contributors)
		local names = {}
		for player, damage in pairs(contributors) do
			if player.Parent == Players and DataService.get(player) and damage > 0 then
				table.insert(names, player.DisplayName)
				DataService.addCash(player, cfg.reward)
				ProgressService.giveXp(player, cfg.xp)
				ProgressService.markBoss(player, cfg.id)
				Remotes.CompanionEvent:FireClient(player, "boss", cfg.name, cfg.reward)
			end
		end
		local text = "👑 O chefão " .. cfg.name .. " foi derrotado"
			.. (if #names > 0 then " por " .. table.concat(names, ", ") else "") .. "! Volta em " .. cfg.respawn .. "s."
		for _, p in ipairs(Players:GetPlayers()) do
			Remotes.notify(p, text, GOLD)
		end
	end)

	-- não deixa entrar em área trancada
	task.spawn(function()
		while true do
			task.wait(0.3)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				local biome = hrp and Stats.biomeAt(hrp.Position)
				if biome then
					local ok, why = ProgressService.canEnter(player, biome)
					if not ok then
						if biome.id == "Ceu" then
							character:PivotTo(hubCFrame())
						else
							local c = biome.center
							local pos = hrp.Position
							local dx, dz = pos.X - c.X, pos.Z - c.Z
							local hx, hz = biome.size.X / 2, biome.size.Y / 2
							local x, z = pos.X, pos.Z
							if hx - math.abs(dx) < hz - math.abs(dz) then
								x = c.X + (if dx >= 0 then 1 else -1) * (hx + 8)
							else
								z = c.Z + (if dz >= 0 then 1 else -1) * (hz + 8)
							end
							character:PivotTo(CFrame.new(x, c.Y + 5, z))
						end
						local now = os.clock()
						if not lastWarning[player] or now - lastWarning[player] > 3 then
							lastWarning[player] = now
							Remotes.notify(player, "🔒 " .. biome.icon .. " " .. biome.name .. " está trancado: " .. (why or ""), RED)
						end
					end
				end
			end
		end
	end)

	-- portais do Céu Celestial
	local debounce = {}
	local function portal(name: string, action)
		local pad = workspace:FindFirstChild(name, true)
		if pad and pad:IsA("BasePart") then
			pad.Touched:Connect(function(hit)
				local player = Players:GetPlayerFromCharacter(hit.Parent)
				if not player or debounce[player] then
					return
				end
				debounce[player] = true
				action(player)
				task.delay(2, function()
					debounce[player] = nil
				end)
			end)
		end
	end
	portal("PortalCeu", function(player)
		local ok, msg = ProgressService.teleportTo(player, "Ceu")
		Remotes.notify(player, msg, if ok then GOLD else RED)
	end)
	portal("PortalVolta", function(player)
		ProgressService.teleportHub(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastWarning[player] = nil
	end)
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000F"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Cria os RemoteEvents/RemoteFunctions usados para servidor <-> jogador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folder = ReplicatedStorage:FindFirstChild("Remotes")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage
end

local function get(className, name)
	local remote = folder:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = folder
	end
	return remote
end

Remotes.ThrowBall = get("RemoteEvent", "ThrowBall") -- jogador -> servidor: posição do mouse
Remotes.DataUpdated = get("RemoteEvent", "DataUpdated") -- servidor -> jogador: dados atualizados
Remotes.Notify = get("RemoteEvent", "Notify") -- servidor -> jogador: mensagem na tela
Remotes.CatchResult = get("RemoteEvent", "CatchResult") -- servidor -> jogador: capturou ou não
Remotes.CompanionEvent = get("RemoteEvent", "CompanionEvent") -- servidor -> jogador: subiu de nível, evoluiu...
Remotes.Knockback = get("RemoteEvent", "Knockback") -- servidor -> jogador: empurrão
Remotes.Social = get("RemoteEvent", "Social") -- servidor -> jogador: trocas, duelos, pedidos
Remotes.Action = get("RemoteFunction", "Action") -- jogador -> servidor: comprar, vender, colocar...

function Remotes.notify(player: Player, text: string, color: Color3?)
	Remotes.Notify:FireClient(player, text, color)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000010"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Recebe os pedidos da interface do jogador: loja, rebirth, teleporte, trancar base,
-- colocar/guardar/vender, parceiro, trocas e duelos.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local TycoonService = require(script.Parent.TycoonService)
local ToolService = require(script.Parent.ToolService)
local CompanionService = require(script.Parent.CompanionService)
local InventoryService = require(script.Parent.InventoryService)
local ProgressService = require(script.Parent.ProgressService)
local TradeService = require(script.Parent.TradeService)
local DuelService = require(script.Parent.DuelService)
local Remotes = require(script.Parent.Remotes)

local ShopService = {}

local fmt = CatchMath.formatNumber
local lastAction = {}
local ALLOWED_AMOUNTS = { [1] = true, [5] = true, [10] = true }
local FAST_ACTIONS = { GetData = true, UseMove = true, TradeSetOffer = true }

local function rebirthLock(player: Player, needed: number?)
	local data = DataService.get(player)
	if needed and needed > 0 and data.rebirths < needed then
		return "Precisa de " .. needed .. " rebirth(s) ♻"
	end
	return nil
end

local actions = {}

function actions.GetData(player)
	return true, DataService.snapshot(player)
end

function actions.SelectBall(player, ballId)
	local ballDef = type(ballId) == "string" and Config.getBall(ballId)
	if not ballDef then
		return false, "Bola inválida."
	end
	player:SetAttribute("SelectedBall", ballId)
	ToolService.updateBallTool(player)
	DataService.pushUpdate(player)
	return true, nil
end

function actions.BuyBall(player, ballId, amount)
	local ballDef = type(ballId) == "string" and Config.getBall(ballId)
	if not ballDef or not ALLOWED_AMOUNTS[amount] then
		return false, "Compra inválida."
	end
	local locked = rebirthLock(player, ballDef.rebirth)
	if locked then
		return false, locked
	end
	local price = ballDef.price * amount
	if not DataService.spendCash(player, price) then
		return false, "Você precisa de $" .. fmt(price) .. "."
	end
	DataService.addBalls(player, ballId, amount)
	return true, "Comprou " .. amount .. "x " .. ballDef.name .. "!"
end

function actions.BuyBat(player, batId)
	local batDef = type(batId) == "string" and Config.getBat(batId)
	local data = DataService.get(player)
	if not batDef then
		return false, "Item inválido."
	end
	if not data.ownedBats[batId] then
		local locked = rebirthLock(player, batDef.rebirth)
		if locked then
			return false, locked
		end
		if not DataService.spendCash(player, batDef.price) then
			return false, "Você precisa de $" .. fmt(batDef.price) .. "."
		end
		data.ownedBats[batId] = true
	end
	data.bat = batId
	ToolService.giveTools(player)
	InventoryService.sync(player, true)
	DataService.pushUpdate(player)
	return true, batDef.name .. " equipado!"
end

function actions.BuyGear(player, gearId)
	local gear = type(gearId) == "string" and Config.getGear(gearId)
	local data = DataService.get(player)
	if not gear then
		return false, "Item inválido."
	end
	if data.ownedGear[gearId] then
		return false, "Você já tem " .. gear.name .. "."
	end
	local locked = rebirthLock(player, gear.rebirth)
	if locked then
		return false, locked
	end
	if not DataService.spendCash(player, gear.price) then
		return false, "Você precisa de $" .. fmt(gear.price) .. "."
	end
	data.ownedGear[gearId] = true
	ToolService.giveTools(player)
	InventoryService.sync(player, true)
	DataService.pushUpdate(player)
	return true, "Comprou " .. gear.name .. "! Está na sua barra de itens."
end

function actions.Place(player, uid)
	if type(uid) ~= "string" then
		return false, "Inválido."
	end
	return TycoonService.place(player, uid, nil)
end

function actions.Store(player, uid)
	if type(uid) ~= "string" then
		return false, "Inválido."
	end
	return TycoonService.store(player, uid)
end

function actions.Sell(player, uid)
	if type(uid) ~= "string" then
		return false, "Inválido."
	end
	local item = DataService.findItem(player, uid)
	if not item then
		return false, "Brainrot não encontrado."
	end
	if TycoonService.isItemStolen(player, uid) then
		return false, "Ele está sendo roubado agora!"
	end
	if TradeService.isTrading(player) then
		return false, "Termine a troca primeiro."
	end
	local def = Config.getBrainrot(item.id)
	local data = DataService.get(player)
	if data.companion == uid then
		CompanionService.dismiss(player)
	end
	local price = Stats.sellPrice(def, item.level or 1, item.mutation)
	DataService.removeBrainrot(player, uid)
	TycoonService.onItemRemoved(player, item)
	DataService.addCash(player, price)
	return true, "Vendeu " .. Stats.displayName(def, item.level or 1, item.mutation) .. " por $" .. fmt(price) .. "!"
end

function actions.Summon(player, uid)
	if type(uid) ~= "string" then
		return false, "Inválido."
	end
	if TycoonService.isItemStolen(player, uid) then
		return false, "Ele está sendo roubado agora!"
	end
	local item = DataService.findItem(player, uid)
	if item and item.slot then
		TycoonService.store(player, uid)
	end
	return CompanionService.summon(player, uid)
end

function actions.Dismiss(player)
	return CompanionService.dismiss(player)
end

function actions.UseMove(player, moveId, targetModel)
	return CompanionService.useMove(player, moveId, targetModel)
end

function actions.ToggleAuto(player)
	local on = player:GetAttribute("AutoBattle") == false
	player:SetAttribute("AutoBattle", on)
	DataService.pushUpdate(player)
	return true, if on then "⚔ Modo automático LIGADO." else "Modo automático DESLIGADO."
end

function actions.Unlock(player)
	return TycoonService.unlockNext(player)
end

function actions.Home(player)
	if player:GetAttribute("InDuel") then
		return false, "Você está em um duelo!"
	end
	TycoonService.teleportHome(player)
	return true, nil
end

function actions.Lock(player)
	return TycoonService.lock(player)
end

function actions.Rebirth(player)
	return ProgressService.rebirth(player)
end

function actions.Teleport(player, biomeId)
	if type(biomeId) ~= "string" then
		return false, "Inválido."
	end
	return ProgressService.teleportTo(player, biomeId)
end

-- trocas
function actions.TradeRequest(player, userId)
	return TradeService.request(player, userId)
end
function actions.TradeRespond(player, accept)
	return TradeService.respond(player, accept)
end
function actions.TradeSetOffer(player, uids, cash)
	return TradeService.setOffer(player, uids, cash)
end
function actions.TradeReady(player, ready)
	return TradeService.setReady(player, ready)
end
function actions.TradeCancel(player)
	return TradeService.cancel(player)
end

-- duelos
function actions.DuelRequest(player, userId)
	return DuelService.request(player, userId)
end
function actions.DuelRespond(player, accept)
	return DuelService.respond(player, accept)
end
function actions.DuelPick(player, uid)
	return DuelService.pick(player, uid)
end
function actions.DuelRansom(player, pay)
	return DuelService.ransom(player, pay)
end

function ShopService.start()
	Remotes.Action.OnServerInvoke = function(player, actionName, ...)
		local handler = type(actionName) == "string" and actions[actionName]
		if not handler then
			return false, "Ação desconhecida."
		end
		local now = os.clock()
		if not FAST_ACTIONS[actionName] then
			if lastAction[player] and now - lastAction[player] < 0.15 then
				return false, nil
			end
			lastAction[player] = now
		end
		if not DataService.get(player) then
			return false, "Carregando seus dados..."
		end
		local ok, okResult, msg = pcall(handler, player, ...)
		if not ok then
			warn("[ShopService] erro em " .. actionName .. ": " .. tostring(okResult))
			return false, "Ocorreu um erro."
		end
		return okResult, msg
	end

	Players.PlayerRemoving:Connect(function(player)
		lastAction[player] = nil
	end)
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000011"><Properties><string name="Name">StealService</string><ProtectedString name="Source"><![CDATA[-- ROUBO: vá até a base de outro jogador, segure F no pedestal para pegar o brainrot
-- e leve até a SUA base antes do tempo acabar. Se alguém te bater com um taco
-- (ou você morrer), o brainrot volta para o dono. O dono recebe um alarme.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local TycoonService = require(script.Parent.TycoonService)
local BrainrotModels = require(script.Parent.BrainrotModels)
local Remotes = require(script.Parent.Remotes)

local StealService = {}

local S = Config.Steal
local RED = Color3.fromRGB(255, 100, 100)
local GREEN = Color3.fromRGB(120, 255, 140)

local carrying = {} -- [ladrão] = { victim, plot, slotIndex, uid, startTime, model, name }

-- outros sistemas podem bloquear o roubo (ex.: quem está em duelo)
StealService.canStealCheck = nil -- function(player): (boolean, string?)

function StealService.isCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

local function attachCarryModel(thief: Player, item)
	local character = thief.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return nil
	end
	local def = Config.getBrainrot(item.id)
	local model = BrainrotModels.build(def, 3 / math.max(def.size.Y, 0.5), Stats.stage(item.level or 1), item.mutation)
	local root = model.PrimaryPart
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.Massless = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			if d ~= root then
				local w = Instance.new("WeldConstraint")
				w.Part0 = root
				w.Part1 = d
				w.Parent = root
			end
		end
	end
	model:PivotTo(head.CFrame * CFrame.new(0, 1 + root.Size.Y / 2, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = root
	weld.Parent = root
	model.Name = "Roubado"
	model.Parent = character
	return model
end

local function finish(thief: Player, success: boolean, reason: string?)
	local info = carrying[thief]
	if not info then
		return
	end
	carrying[thief] = nil
	if info.model then
		info.model:Destroy()
	end
	thief:SetAttribute("Carrying", nil)

	local victim = info.victim
	local victimOnline = victim.Parent == Players and DataService.get(victim) ~= nil
	local item = victimOnline and DataService.findItem(victim, info.uid)

	if success and item and DataService.get(thief) then
		-- tira do pedestal e passa para o ladrão
		local _, oldItem = DataService.transferItem(victim, thief, info.uid)
		if oldItem then
			TycoonService.onItemRemoved(victim, oldItem)
		end
		Remotes.notify(thief, "🤑 Você roubou " .. info.name .. "! Ele está na sua barra de itens.", GREEN)
		Remotes.notify(victim, "😭 " .. thief.DisplayName .. " roubou seu " .. info.name .. "!", RED)
		return
	end

	-- falhou: volta para o pedestal do dono
	if victimOnline and item then
		TycoonService.setSlotStolen(info.plot, info.slotIndex, false)
		Remotes.notify(victim, "🛡 Seu " .. info.name .. " voltou para a base!", GREEN)
	end
	if thief.Parent == Players then
		Remotes.notify(thief, "❌ Roubo falhou" .. (if reason then ": " .. reason else "") .. ".", RED)
	end
end

local function startSteal(thief: Player, plot, slot)
	local victim = plot.owner
	if not victim or victim == thief then
		return
	end
	if carrying[thief] then
		Remotes.notify(thief, "Você já está carregando um brainrot!", RED)
		return
	end
	if not TycoonService.getPlot(thief) then
		Remotes.notify(thief, "Você precisa de uma base para roubar.", RED)
		return
	end
	if TycoonService.isLocked(plot) then
		Remotes.notify(thief, "Essa base está trancada! 🔒", RED)
		return
	end
	if slot.stolen then
		Remotes.notify(thief, "Alguém já está roubando esse!", RED)
		return
	end
	if StealService.canStealCheck then
		local ok, why = StealService.canStealCheck(thief)
		if not ok then
			Remotes.notify(thief, why or "Agora não dá.", RED)
			return
		end
	end
	local character = thief.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local item = TycoonService.getSlotItem(plot, slot.index)
	if not item then
		return
	end

	local def = Config.getBrainrot(item.id)
	local name = Stats.displayName(def, item.level or 1, item.mutation)
	TycoonService.setSlotStolen(plot, slot.index, true)
	carrying[thief] = {
		victim = victim,
		plot = plot,
		slotIndex = slot.index,
		uid = item.uid,
		startTime = os.clock(),
		name = name,
		model = attachCarryModel(thief, item),
	}
	thief:SetAttribute("Carrying", true)
	-- tira a invisibilidade quando pega (fica mais justo)
	thief:SetAttribute("BreakInvisibility", true)

	Remotes.notify(thief, "🏃 Leve " .. name .. " até a SUA base em " .. S.TimeLimit .. "s! Não deixe te baterem!", Color3.fromRGB(255, 220, 90))
	Remotes.notify(victim, "🚨 " .. thief.DisplayName .. " está ROUBANDO seu " .. name .. "! Bata nele com o taco!", RED)
end

-- chamado quando alguém acerta o ladrão com um objeto de bater
function StealService.onPlayerHit(victim: Player, attacker: Player?)
	if carrying[victim] then
		finish(victim, false, if attacker then attacker.DisplayName .. " te acertou" else "você levou um golpe")
		if attacker then
			Remotes.notify(attacker, "💥 Você fez " .. victim.DisplayName .. " largar o brainrot!", GREEN)
		end
	end
end

function StealService.cancel(player: Player, reason: string?)
	finish(player, false, reason)
end

function StealService.start()
	TycoonService.stealHandler = startSteal

	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		for thief, info in pairs(carrying) do
			local character = thief.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			if thief.Parent ~= Players or not humanoid or humanoid.Health <= 0 or not hrp then
				finish(thief, false, "você caiu")
			elseif info.victim.Parent ~= Players then
				finish(thief, false, "o dono saiu do jogo")
			elseif now - info.startTime > S.TimeLimit then
				finish(thief, false, "o tempo acabou")
			else
				local myPlot = TycoonService.getPlot(thief)
				if myPlot and TycoonService.isInPlot(myPlot, hrp.Position) then
					finish(thief, true)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if carrying[player] then
			finish(player, false, "saiu do jogo")
		end
		for thief, info in pairs(carrying) do
			if info.victim == player then
				finish(thief, false, "o dono saiu do jogo")
			end
		end
	end)
end

return StealService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000012"><Properties><string name="Name">ToolService</string><ProtectedString name="Source"><![CDATA[-- Ferramentas: OBJETOS DE BATER (taco, frigideira, martelo...), a BOLA DE CAPTURA
-- e os EQUIPAMENTOS (molas, escudo, capa de invisibilidade).
-- Os objetos de bater acertam brainrots e também JOGADORES (com empurrão).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local WildService = require(script.Parent.WildService)
local CompanionService = require(script.Parent.CompanionService)
local StealService = require(script.Parent.StealService)
local ProgressService = require(script.Parent.ProgressService)
local Remotes = require(script.Parent.Remotes)

local ToolService = {}

local BAT_NAME = "Taco"
local BALL_NAME = "Bola"
local C = Config.Catch
local RED = Color3.fromRGB(255, 120, 120)

local lastSwing = {} -- [Player] = os.clock()
local lastThrow = {}
local gearCooldown = {} -- [Player] = { [gearId] = os.clock() }

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
end

local function toolPart(tool: Tool, handle: BasePart?, props)
	local p = Instance.new("Part")
	p.CanCollide = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = tool
	if handle then
		weld(handle, p)
	end
	return p
end

---------------------------------------------------------------------
-- MOVIMENTO (velocidade/pulo dependem de mola, roubo e duelo)
---------------------------------------------------------------------
function ToolService.refreshMovement(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local speed, jump = 16, 50
	for _, tool in ipairs(character:GetChildren()) do
		if tool:IsA("Tool") then
			local gear = Config.getGear(tool:GetAttribute("GearId"))
			if gear and gear.kind == "speed" then
				speed = gear.value
			elseif gear and gear.kind == "jump" then
				jump = gear.value
			end
		end
	end
	if player:GetAttribute("Carrying") then
		speed = math.min(speed, Config.Steal.CarrySpeed)
	end
	if player:GetAttribute("Frozen") then
		speed, jump = 0, 0
	end
	humanoid.UseJumpPower = true
	humanoid.WalkSpeed = speed
	humanoid.JumpPower = jump
end

---------------------------------------------------------------------
-- OBJETOS DE BATER
---------------------------------------------------------------------
local function createBat(batDef)
	local tool = Instance.new("Tool")
	tool.Name = BAT_NAME
	tool.ToolTip = batDef.name .. " (dano " .. batDef.damage .. ", empurrão " .. batDef.knockback .. ")"
	tool.CanBeDropped = false
	tool:SetAttribute("BatId", batDef.id)
	-- segura igual à espada clássica: a ponta aponta para cima
	tool.Grip = CFrame.fromMatrix(Vector3.new(0, 0, -0.8), Vector3.new(0, 1, 0), Vector3.new(0, 0, 1))

	local color, material = batDef.color, batDef.material
	local handle = toolPart(tool, nil, {
		Name = "Handle", Size = Vector3.new(0.45, 0.45, 2.4), Color = if batDef.look == "bat" then color else Color3.fromRGB(90, 60, 40),
		Material = if batDef.look == "bat" then material else Enum.Material.Wood,
	})
	toolPart(tool, handle, {
		Name = "Tape", Size = Vector3.new(0.5, 0.5, 1), Color = Color3.fromRGB(30, 30, 30), Material = Enum.Material.Fabric,
		CFrame = handle.CFrame * CFrame.new(0, 0, -0.8),
	})

	local head
	if batDef.look == "pan" then
		-- frigideira: disco grande na ponta
		head = toolPart(tool, handle, {
			Name = "Pan", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 2.6, 2.6), Color = color, Material = material,
			CFrame = handle.CFrame * CFrame.new(0, 0, 2.5),
		})
	elseif batDef.look == "hammer" then
		-- martelo: bloco atravessado na ponta
		head = toolPart(tool, handle, {
			Name = "HammerHead", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.4, 1.3, 1.3), Color = color, Material = material,
			CFrame = handle.CFrame * CFrame.new(0, 0, 1.8),
		})
	else
		head = toolPart(tool, handle, {
			Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6, 0.8, 0.8), Color = color, Material = material,
			CFrame = handle.CFrame * CFrame.new(0, 0, 2.4) * CFrame.Angles(0, math.rad(90), 0),
		})
	end
	if batDef.rebirth > 0 or batDef.id == "Diamante" or batDef.id == "Ouro" then
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = color
		sparkle.Parent = head
	end
	return tool
end

-- jogador mais perto na frente (para o PvP)
local function findPlayerInFront(attacker: Player, range: number)
	local character = attacker.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil, nil
	end
	local best, bestDist = nil, math.huge
	for _, other in ipairs(Players:GetPlayers()) do
		local oc = other ~= attacker and other.Character
		local ohrp = oc and oc:FindFirstChild("HumanoidRootPart")
		local ohum = oc and oc:FindFirstChildOfClass("Humanoid")
		if ohrp and ohum and ohum.Health > 0 then
			local offset = ohrp.Position - hrp.Position
			local flatOffset = Vector3.new(offset.X, 0, offset.Z)
			local dist = flatOffset.Magnitude
			if dist <= range and math.abs(offset.Y) < 8 then
				local look = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z).Unit
				if dist < 0.5 or look:Dot(flatOffset.Unit) > 0.3 then
					if dist < bestDist then
						best, bestDist = other, dist
					end
				end
			end
		end
	end
	return best, bestDist
end

local function isSafe(player: Player): boolean
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local spawnLocation = workspace:FindFirstChild("SpawnLocation", true)
	if hrp and spawnLocation and spawnLocation:IsA("BasePart") then
		return (hrp.Position - spawnLocation.Position).Magnitude < Config.PvP.SafeRadius
	end
	return false
end

local function hitPlayer(attacker: Player, victim: Player, batDef)
	if isSafe(victim) or isSafe(attacker) then
		Remotes.notify(attacker, "Perto do spawn ninguém apanha 😇", RED)
		return
	end
	local character = victim.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local attackerRoot = attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not attackerRoot then
		return
	end
	StealService.onPlayerHit(victim, attacker) -- ladrão larga o brainrot
	if character:FindFirstChildOfClass("ForceField") then
		return -- escudo de bolha
	end
	humanoid:TakeDamage(batDef.pvpDamage)
	WildService.knockbackPlayer(victim, attackerRoot.Position, batDef.knockback)
	local head = character:FindFirstChild("Head")
	if head then
		WildService.floatingText(head.Position + Vector3.new(0, 2, 0), "-" .. batDef.pvpDamage, Color3.fromRGB(255, 80, 80))
	end
end

local function onSwing(player: Player, tool: Tool)
	local data = DataService.get(player)
	if not data then
		return
	end
	local batDef = Config.getBat(data.bat) or Config.Bats[1]
	local now = os.clock()
	if lastSwing[player] and now - lastSwing[player] < batDef.cooldown then
		return
	end
	lastSwing[player] = now

	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 1)

	local target, targetDist = WildService.findTargetInFront(player, batDef.range)
	local victim, victimDist = nil, nil
	if Config.PvP.Enabled then
		victim, victimDist = findPlayerInFront(player, batDef.range * 0.7)
	end
	if victim and (not target or victimDist < targetDist) then
		hitPlayer(player, victim, batDef)
	elseif target then
		WildService.damage(target, batDef.damage, player)
		CompanionService.setTarget(player, target)
	end
end

---------------------------------------------------------------------
-- BOLA DE CAPTURA
---------------------------------------------------------------------
local function paintBall(part: BasePart, ballDef)
	part.Color = ballDef.color
	local stripe = part:FindFirstChild("Stripe")
	if stripe then
		stripe.Color = Color3.fromRGB(30, 30, 30)
	end
end

local function makeBallPart(ballDef, size: number)
	local ball = Instance.new("Part")
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.one * size
	ball.Material = Enum.Material.SmoothPlastic
	ball.CanCollide = false
	ball.Massless = true
	ball.TopSurface = Enum.SurfaceType.Smooth
	ball.BottomSurface = Enum.SurfaceType.Smooth

	local stripe = Instance.new("Part")
	stripe.Name = "Stripe"
	stripe.Shape = Enum.PartType.Cylinder
	stripe.Size = Vector3.new(size * 0.15, size * 1.02, size * 1.02)
	stripe.CanCollide = false
	stripe.CanQuery = false
	stripe.CanTouch = false
	stripe.Massless = true
	stripe.CFrame = ball.CFrame * CFrame.Angles(0, 0, math.rad(90))
	stripe.Parent = ball
	weld(ball, stripe)

	local button = Instance.new("Part")
	button.Name = "Button"
	button.Shape = Enum.PartType.Cylinder
	button.Size = Vector3.new(size * 0.1, size * 0.35, size * 0.35)
	button.Color = Color3.new(1, 1, 1)
	button.CanCollide = false
	button.CanQuery = false
	button.CanTouch = false
	button.Massless = true
	button.CFrame = ball.CFrame * CFrame.new(0, 0, -size / 2) * CFrame.Angles(0, math.rad(90), 0)
	button.Parent = ball
	weld(ball, button)

	paintBall(ball, ballDef)
	return ball
end

local function createBallTool(ballDef)
	local tool = Instance.new("Tool")
	tool.Name = BALL_NAME
	tool.ToolTip = "Jogue nos brainrots com POUCA vida!"
	tool.CanBeDropped = false
	local handle = makeBallPart(ballDef, 1.1)
	handle.Name = "Handle"
	handle.Parent = tool
	return tool
end

function ToolService.updateBallTool(player: Player)
	local ballDef = Config.getBall(player:GetAttribute("SelectedBall") or "Basica") or Config.Balls[1]
	for _, container in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
		local tool = container and container:FindFirstChild(BALL_NAME)
		if tool and tool:FindFirstChild("Handle") then
			paintBall(tool.Handle, ballDef)
		end
	end
end

local function shake(ball: BasePart, base: CFrame)
	local info = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	for _, angle in ipairs({ 25, -25, 0 }) do
		local tween = TweenService:Create(ball, info, { CFrame = base * CFrame.Angles(0, 0, math.rad(angle)) })
		tween:Play()
		tween.Completed:Wait()
	end
end

local function attemptCapture(player: Player, state, ball: BasePart, ballDef)
	WildService.setCapturing(state, true)
	local def = state.def
	local rarity = Config.getRarity(def.rarity)
	local chance = WildService.getChance(state, ballDef.multiplier)
	local success = math.random() < chance
	local shakes = if success then 3 else math.random(0, 2)

	local ground = WildService.getPosition(state)
	local base = CFrame.new(ground + Vector3.new(0, ball.Size.Y / 2 + 0.05, 0))
	ball.CFrame = base

	WildService.poof(ground + Vector3.new(0, 2, 0), Color3.new(1, 1, 1))
	task.wait(0.6)

	for _ = 1, shakes do
		shake(ball, base)
		task.wait(0.5)
	end

	if success then
		WildService.poof(base.Position, Color3.fromRGB(255, 230, 80))
		ball:Destroy()
		if WildService.isAlive(state) then
			WildService.removeCaptured(state)
		end
		DataService.addBrainrot(player, def.id, state.level, state.mutation)
		CompanionService.onCaptured(player, state)
		ProgressService.giveXp(player, Stats.xpReward(def, state.level))
		Remotes.CatchResult:FireClient(player, true, def.id, chance, state.level, state.mutation)
	else
		WildService.poof(base.Position, rarity.color)
		ball:Destroy()
		WildService.releaseAfterFail(state, player)
		Remotes.CatchResult:FireClient(player, false, def.id, chance)
	end
end

local function throwBall(player: Player, targetPos: any)
	if typeof(targetPos) ~= "Vector3" then
		return
	end
	local magnitude = targetPos.Magnitude
	if magnitude ~= magnitude or magnitude > 1e5 then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	if not humanoid or humanoid.Health <= 0 or not head or not character:FindFirstChild(BALL_NAME) then
		return
	end

	local now = os.clock()
	if lastThrow[player] and now - lastThrow[player] < C.ThrowCooldown then
		return
	end

	local ballId = player:GetAttribute("SelectedBall") or "Basica"
	local ballDef = Config.getBall(ballId)
	if not ballDef then
		return
	end
	if not DataService.useBall(player, ballId) then
		Remotes.notify(player, "Você não tem " .. ballDef.name .. "! Compre na Loja 🛒", RED)
		return
	end
	lastThrow[player] = now

	local origin = head.Position + Vector3.new(0, 0.5, 0)
	local offset = targetPos - origin
	if offset.Magnitude > C.MaxThrowDistance then
		offset = offset.Unit * C.MaxThrowDistance
	end
	if offset.Magnitude < 1 then
		offset = head.CFrame.LookVector * 10
	end
	local flightTime = offset.Magnitude / C.ThrowSpeed
	local velocity = offset / flightTime + Vector3.new(0, 0.5 * C.Gravity * flightTime, 0)

	local ball = makeBallPart(ballDef, 1.2)
	ball.Name = "ThrownBall"
	ball.Anchored = true
	ball.CanQuery = false
	ball.CFrame = CFrame.new(origin)
	ball.Parent = workspace

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, ball, workspace:FindFirstChild("Companions") }

	local position = origin
	local elapsed = 0
	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		local newVelocity = velocity - Vector3.new(0, C.Gravity * dt, 0)
		local newPosition = position + velocity * dt
		local result = workspace:Raycast(position, newPosition - position, params)

		if result then
			connection:Disconnect()
			local state = WildService.getStateFromPart(result.Instance)
			if state and WildService.isBoss(state) then
				WildService.poof(result.Position, ballDef.color)
				ball:Destroy()
				Remotes.notify(player, "👑 Chefões não podem ser capturados! Derrote ele!", RED)
			elseif state and WildService.isAlive(state) and not state.capturing then
				task.spawn(attemptCapture, player, state, ball, ballDef)
			else
				WildService.poof(result.Position, ballDef.color)
				ball:Destroy()
			end
			return
		end

		position = newPosition
		velocity = newVelocity
		ball.CFrame = CFrame.new(position) * CFrame.Angles(elapsed * 10, 0, 0)

		if elapsed > 4 then
			connection:Disconnect()
			ball:Destroy()
		end
	end)
end

---------------------------------------------------------------------
-- EQUIPAMENTOS
---------------------------------------------------------------------
local function setInvisible(player: Player, invisible: boolean)
	local character = player.Character
	if not character then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		if (d:IsA("BasePart") and d.Name ~= "HumanoidRootPart") or d:IsA("Decal") then
			if invisible then
				if d:GetAttribute("VisibleTransparency") == nil then
					d:SetAttribute("VisibleTransparency", d.Transparency)
				end
				d.Transparency = 1
			else
				local original = d:GetAttribute("VisibleTransparency")
				if original ~= nil then
					d.Transparency = original
					d:SetAttribute("VisibleTransparency", nil)
				end
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = if invisible then Enum.HumanoidDisplayDistanceType.None
			else Enum.HumanoidDisplayDistanceType.Viewer
	end
	player:SetAttribute("Invisible", if invisible then true else nil)
end

local function useGear(player: Player, gear)
	gearCooldown[player] = gearCooldown[player] or {}
	local now = os.clock()
	local readyAt = gearCooldown[player][gear.id] or 0
	if now < readyAt then
		Remotes.notify(player, gear.name .. " recarregando: " .. math.ceil(readyAt - now) .. "s", RED)
		return
	end
	local character = player.Character
	if not character then
		return
	end
	gearCooldown[player][gear.id] = now + gear.cooldown
	if gear.kind == "shield" then
		local ff = Instance.new("ForceField")
		ff.Visible = true
		ff.Parent = character
		Debris:AddItem(ff, gear.duration)
	elseif gear.kind == "invisible" then
		setInvisible(player, true)
		Remotes.notify(player, "👻 Você está invisível por " .. gear.duration .. "s!", Color3.fromRGB(180, 160, 255))
		local myCharacter = character
		task.delay(gear.duration, function()
			if player.Character == myCharacter then
				setInvisible(player, false)
			end
		end)
	end
end

local function createGearTool(player: Player, gear)
	local tool = Instance.new("Tool")
	tool.Name = gear.name
	tool.ToolTip = gear.description
	tool.CanBeDropped = false
	tool:SetAttribute("GearId", gear.id)

	if gear.kind == "speed" or gear.kind == "jump" then
		local handle = toolPart(tool, nil, {
			Name = "Handle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.4, 0.9, 0.9), Color = gear.color,
			Material = Enum.Material.Neon,
		})
		for i = -1, 1 do
			toolPart(tool, handle, {
				Name = "Coil", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.15, 1.1, 1.1), Color = Color3.fromRGB(200, 200, 210),
				Material = Enum.Material.Metal, CFrame = handle.CFrame * CFrame.new(i * 0.45, 0, 0),
			})
		end
		tool.Equipped:Connect(function()
			ToolService.refreshMovement(player)
		end)
		tool.Unequipped:Connect(function()
			task.defer(ToolService.refreshMovement, player)
		end)
	elseif gear.kind == "shield" then
		toolPart(tool, nil, {
			Name = "Handle", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.2, Color = gear.color,
			Material = Enum.Material.Glass, Transparency = 0.3,
		})
		tool.Activated:Connect(function()
			useGear(player, gear)
		end)
	else
		toolPart(tool, nil, {
			Name = "Handle", Size = Vector3.new(1.4, 1.8, 0.2), Color = gear.color, Material = Enum.Material.Fabric,
		})
		tool.Activated:Connect(function()
			useGear(player, gear)
		end)
	end
	return tool
end

---------------------------------------------------------------------
-- Dar as ferramentas
---------------------------------------------------------------------
function ToolService.giveTools(player: Player)
	local data = DataService.get(player)
	local backpack = player:FindFirstChild("Backpack")
	if not data or not backpack then
		return
	end

	for _, container in ipairs({ backpack, player.Character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and (child.Name == BAT_NAME or child.Name == BALL_NAME or child:GetAttribute("GearId")) then
					child:Destroy()
				end
			end
		end
	end

	local bat = createBat(Config.getBat(data.bat) or Config.Bats[1])
	bat.Activated:Connect(function()
		onSwing(player, bat)
	end)
	bat.Parent = backpack

	local ballDef = Config.getBall(player:GetAttribute("SelectedBall") or "Basica") or Config.Balls[1]
	createBallTool(ballDef).Parent = backpack

	for _, gear in ipairs(Config.Gear) do
		if data.ownedGear[gear.id] then
			createGearTool(player, gear).Parent = backpack
		end
	end
	ToolService.refreshMovement(player)
end

function ToolService.start()
	Remotes.ThrowBall.OnServerEvent:Connect(throwBall)

	local function watch(player: Player)
		player:GetAttributeChangedSignal("Carrying"):Connect(function()
			ToolService.refreshMovement(player)
		end)
		player:GetAttributeChangedSignal("Frozen"):Connect(function()
			ToolService.refreshMovement(player)
		end)
		player:GetAttributeChangedSignal("BreakInvisibility"):Connect(function()
			if player:GetAttribute("BreakInvisibility") then
				player:SetAttribute("BreakInvisibility", nil)
				if player:GetAttribute("Invisible") then
					setInvisible(player, false)
				end
			end
		end)
		player.CharacterAdded:Connect(function()
			player:SetAttribute("Invisible", nil)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, p in ipairs(Players:GetPlayers()) do
		watch(p)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
		lastThrow[player] = nil
		gearCooldown[player] = nil
	end)
end

return ToolService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000013"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[-- TROCA entre jogadores: um pede, o outro aceita, cada um escolhe brainrots e dinheiro,
-- os dois apertam "Pronto" e a troca acontece. Mudou a oferta? Os dois precisam confirmar de novo.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local TycoonService = require(script.Parent.TycoonService)
local CompanionService = require(script.Parent.CompanionService)
local Remotes = require(script.Parent.Remotes)

local TradeService = {}

local MAX_ITEMS = 8
local REQUEST_TIME = 20
local RED = Color3.fromRGB(255, 120, 120)
local GREEN = Color3.fromRGB(120, 255, 140)

local requests = {} -- [alvo] = { from = Player, time = número }
local trades = {} -- [Player] = troca

function TradeService.isTrading(player: Player): boolean
	return trades[player] ~= nil
end

local function itemInfo(item)
	local def = Config.getBrainrot(item.id)
	return {
		uid = item.uid,
		id = item.id,
		level = item.level or 1,
		mutation = item.mutation,
		name = Stats.displayName(def, item.level or 1, item.mutation),
		rarity = def.rarity,
	}
end

local function eligible(player: Player, uid: string)
	local item = DataService.findItem(player, uid)
	if not item or TycoonService.isItemStolen(player, uid) then
		return nil
	end
	return item
end

local function describe(trade, player: Player)
	local offer = trade.offers[player]
	local items = {}
	for _, uid in ipairs(offer.uids) do
		local item = DataService.findItem(player, uid)
		if item then
			table.insert(items, itemInfo(item))
		end
	end
	return { cash = offer.cash, items = items }
end

local function sendState(trade)
	for _, p in ipairs({ trade.a, trade.b }) do
		local other = if p == trade.a then trade.b else trade.a
		Remotes.Social:FireClient(p, "tradeUpdate", {
			partner = other.DisplayName,
			mine = describe(trade, p),
			theirs = describe(trade, other),
			myReady = trade.ready[p],
			theirReady = trade.ready[other],
		})
	end
end

local function close(trade, message: string?, color: Color3?)
	for _, p in ipairs({ trade.a, trade.b }) do
		if trades[p] == trade then
			trades[p] = nil
		end
		if p.Parent == Players then
			Remotes.Social:FireClient(p, "tradeClosed", message)
			if message then
				Remotes.notify(p, message, color or RED)
			end
		end
	end
end

function TradeService.request(from: Player, targetUserId: any)
	local target = type(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
	if not target or target == from then
		return false, "Jogador não encontrado."
	end
	if trades[from] or trades[target] then
		return false, "Alguém já está em uma troca."
	end
	if not DataService.get(target) then
		return false, "Esse jogador ainda está carregando."
	end
	requests[target] = { from = from, time = os.clock() }
	Remotes.Social:FireClient(target, "tradeRequest", { fromName = from.DisplayName, fromUserId = from.UserId })
	return true, "🤝 Pedido de troca enviado para " .. target.DisplayName .. "."
end

function TradeService.respond(target: Player, accept: any)
	local req = requests[target]
	requests[target] = nil
	if not req or os.clock() - req.time > REQUEST_TIME or req.from.Parent ~= Players then
		return false, "O pedido de troca expirou."
	end
	local from = req.from
	if not accept then
		Remotes.notify(from, target.DisplayName .. " recusou a troca.", RED)
		return true, nil
	end
	if trades[from] or trades[target] then
		return false, "Alguém já está em uma troca."
	end
	local trade = {
		a = from,
		b = target,
		offers = { [from] = { uids = {}, cash = 0 }, [target] = { uids = {}, cash = 0 } },
		ready = { [from] = false, [target] = false },
	}
	trades[from] = trade
	trades[target] = trade
	sendState(trade)
	return true, nil
end

function TradeService.setOffer(player: Player, uids: any, cash: any)
	local trade = trades[player]
	local data = DataService.get(player)
	if not trade or not data then
		return false, "Você não está em uma troca."
	end
	if type(uids) ~= "table" then
		uids = {}
	end
	local clean, seen = {}, {}
	for _, uid in ipairs(uids) do
		if type(uid) == "string" and not seen[uid] and #clean < MAX_ITEMS and eligible(player, uid) then
			seen[uid] = true
			table.insert(clean, uid)
		end
	end
	cash = math.floor(tonumber(cash) or 0)
	if cash ~= cash then
		cash = 0
	end
	cash = math.clamp(cash, 0, math.max(0, math.floor(data.cash)))

	trade.offers[player] = { uids = clean, cash = cash }
	trade.ready[trade.a] = false
	trade.ready[trade.b] = false
	sendState(trade)
	return true, nil
end

local function execute(trade)
	-- confere tudo de novo antes de trocar
	for _, p in ipairs({ trade.a, trade.b }) do
		local data = DataService.get(p)
		local offer = trade.offers[p]
		if not data or p.Parent ~= Players or data.cash < offer.cash then
			close(trade, "Troca cancelada: algo mudou.")
			return
		end
		for _, uid in ipairs(offer.uids) do
			if not eligible(p, uid) then
				trade.ready[trade.a] = false
				trade.ready[trade.b] = false
				sendState(trade)
				Remotes.notify(trade.a, "Um brainrot da troca mudou. Confira e aperte Pronto de novo.", RED)
				Remotes.notify(trade.b, "Um brainrot da troca mudou. Confira e aperte Pronto de novo.", RED)
				return
			end
		end
	end

	for _, p in ipairs({ trade.a, trade.b }) do
		local other = if p == trade.a then trade.b else trade.a
		local offer = trade.offers[p]
		local data = DataService.get(p)
		for _, uid in ipairs(offer.uids) do
			if data.companion == uid then
				CompanionService.dismiss(p)
			end
			local _, oldItem = DataService.transferItem(p, other, uid)
			if oldItem then
				TycoonService.onItemRemoved(p, oldItem)
			end
		end
		if offer.cash > 0 then
			DataService.get(p).cash -= offer.cash
			DataService.get(other).cash += offer.cash
		end
	end
	DataService.pushUpdate(trade.a)
	DataService.pushUpdate(trade.b)
	close(trade, "✅ Troca feita com sucesso!", GREEN)
end

function TradeService.setReady(player: Player, ready: any)
	local trade = trades[player]
	if not trade then
		return false, "Você não está em uma troca."
	end
	trade.ready[player] = ready == true
	sendState(trade)
	if trade.ready[trade.a] and trade.ready[trade.b] then
		execute(trade)
	end
	return true, nil
end

function TradeService.cancel(player: Player)
	local trade = trades[player]
	if trade then
		close(trade, "❌ " .. player.DisplayName .. " cancelou a troca.")
	end
	return true, nil
end

function TradeService.start()
	Players.PlayerRemoving:Connect(function(player)
		requests[player] = nil
		local trade = trades[player]
		if trade then
			close(trade, "❌ " .. player.DisplayName .. " saiu do jogo. Troca cancelada.")
		end
	end)
end

return TradeService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000014"><Properties><string name="Name">TycoonService</string><ProtectedString name="Source"><![CDATA[-- Bases dos jogadores (o "tycoon"): pedestais onde você coloca seus brainrots
-- capturados. Cada brainrot gera dinheiro por segundo, que vai para o coletor.
-- Outros jogadores podem ROUBAR brainrots dos pedestais (veja StealService) e
-- o dono pode TRANCAR a base por um tempo.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Stats = require(ReplicatedStorage.Shared.Stats)
local DataService = require(script.Parent.DataService)
local BrainrotModels = require(script.Parent.BrainrotModels)
local Remotes = require(script.Parent.Remotes)

local TycoonService = {}

local T = Config.Tycoon
local fmt = CatchMath.formatNumber

local plotsFolder = Instance.new("Folder")
plotsFolder.Name = "Plots"
plotsFolder.Parent = workspace

local plots = {}
local plotByPlayer = {} -- [Player] = plot
local lockCooldown = {} -- [Player] = os.clock() em que pode trancar de novo

-- posições dos 20 pedestais (frente da base = +Z)
local SLOT_COLUMNS = { -28, -14, 0, 14, 28 }
local SLOT_ROWS = { 12, -2, -16, -30 }
local BASE_TOP = 1
local PEDESTAL_HEIGHT = 2

-- preenchido pelo StealService: function(thief, plot, slot)
TycoonService.stealHandler = nil

---------------------------------------------------------------------
-- Construção
---------------------------------------------------------------------
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function billboard(adornee: BasePart, offsetY: number, width: number, height: number)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(width, height)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.RichText = true
	label.Parent = gui
	gui.Parent = adornee
	return label
end

local function makePrompt(parent: Instance, role: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0.25
	prompt.Enabled = false
	prompt:SetAttribute("PromptRole", role) -- a interface esconde o que não é para você
	prompt.Parent = parent
	return prompt
end

local function buildPlot(index: number, info)
	local cf = CFrame.new(info.position) * CFrame.Angles(0, math.rad(info.angle), 0)
	local model = Instance.new("Model")
	model.Name = "Plot" .. index

	local colors = {
		Color3.fromRGB(240, 120, 120), Color3.fromRGB(120, 170, 255), Color3.fromRGB(130, 220, 130),
		Color3.fromRGB(255, 210, 100), Color3.fromRGB(200, 140, 255), Color3.fromRGB(255, 160, 210),
	}
	local color = colors[(index - 1) % #colors + 1]
	local half = T.PlotSize / 2

	part(model, {
		Name = "Base", Size = Vector3.new(T.PlotSize, 1, T.PlotSize), CFrame = cf * CFrame.new(0, 0.5, 0),
		Color = Color3.fromRGB(230, 225, 215), Material = Enum.Material.Concrete,
	})
	part(model, {
		Name = "Floor", Size = Vector3.new(T.PlotSize - 6, 0.2, T.PlotSize - 12), CFrame = cf * CFrame.new(0, 1.05, -3),
		Color = Color3.fromRGB(205, 160, 110), Material = Enum.Material.WoodPlanks,
	})
	part(model, {
		Name = "Border", Size = Vector3.new(T.PlotSize + 2, 0.8, T.PlotSize + 2), CFrame = cf * CFrame.new(0, 0.3, 0),
		Color = color, Material = Enum.Material.SmoothPlastic,
	})
	local walls = {
		{ Vector3.new(T.PlotSize, 3, 1), CFrame.new(0, 2.5, -half + 0.5) },
		{ Vector3.new(1, 3, T.PlotSize), CFrame.new(-half + 0.5, 2.5, 0) },
		{ Vector3.new(1, 3, T.PlotSize), CFrame.new(half - 0.5, 2.5, 0) },
	}
	for _, w in ipairs(walls) do
		part(model, { Name = "Wall", Size = w[1], CFrame = cf * w[2], Color = Color3.fromRGB(235, 230, 220), Material = Enum.Material.Brick })
		part(model, {
			Name = "WallCap", Size = w[1] + Vector3.new(0.4, -2.6, 0.4), CFrame = cf * w[2] * CFrame.new(0, 1.7, 0),
			Color = color, Material = Enum.Material.SmoothPlastic,
		})
	end
	for _, s in ipairs({ -1, 1 }) do
		part(model, {
			Name = "LampPost", Size = Vector3.new(0.6, 9, 0.6), CFrame = cf * CFrame.new(s * (half - 2), 5.5, half - 2),
			Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal,
		})
		local bulb = part(model, {
			Name = "Lamp", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.6, CFrame = cf * CFrame.new(s * (half - 2), 10.5, half - 2),
			Color = color, Material = Enum.Material.Neon, CanCollide = false,
		})
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 18
		light.Parent = bulb
	end

	-- placa com o nome do dono
	local signBoard = part(model, {
		Name = "OwnerSign", Size = Vector3.new(34, 8, 1), CFrame = cf * CFrame.new(0, 10, -half + 2),
		Color = color, Material = Enum.Material.SmoothPlastic,
	})
	for _, x in ipairs({ -16, 16 }) do
		part(model, { Name = "SignPole", Size = Vector3.new(1, 10, 1), CFrame = cf * CFrame.new(x, 5, -half + 2), Color = color })
	end
	local signGui = Instance.new("SurfaceGui")
	signGui.Face = Enum.NormalId.Back
	signGui.CanvasSize = Vector2.new(680, 160)
	signGui.LightInfluence = 0
	local signLabel = Instance.new("TextLabel")
	signLabel.Size = UDim2.fromScale(1, 1)
	signLabel.BackgroundTransparency = 1
	signLabel.TextColor3 = Color3.new(1, 1, 1)
	signLabel.TextStrokeTransparency = 0
	signLabel.Font = Enum.Font.FredokaOne
	signLabel.TextScaled = true
	signLabel.RichText = true
	signLabel.Text = "Base livre"
	signLabel.Parent = signGui
	signGui.Parent = signBoard

	-- coletor de dinheiro
	local collector = part(model, {
		Name = "Collector", Size = Vector3.new(10, 0.4, 10), CFrame = cf * CFrame.new(0, BASE_TOP + 0.2, 26),
		Color = Color3.fromRGB(60, 230, 90), Material = Enum.Material.Neon,
	})
	local collectorLabel = billboard(collector, 4, 220, 70)

	-- campo de força da base trancada
	local lockField = part(model, {
		Name = "LockField", Size = Vector3.new(T.PlotSize, 16, T.PlotSize), CFrame = cf * CFrame.new(0, 8, 0),
		Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.ForceField, Transparency = 1,
		CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
	})

	local plot = {
		index = index,
		cf = cf,
		model = model,
		owner = nil,
		stored = 0,
		slots = {},
		signLabel = signLabel,
		collector = collector,
		collectorLabel = collectorLabel,
		lockField = lockField,
		lockedUntil = 0,
		spawnCF = cf * CFrame.new(0, 4, 32) * CFrame.Angles(0, math.pi, 0),
		outsideCF = cf * CFrame.new(0, 4, half + 12) * CFrame.Angles(0, math.pi, 0),
	}

	-- pedestais
	local n = 0
	for _, z in ipairs(SLOT_ROWS) do
		for _, x in ipairs(SLOT_COLUMNS) do
			n += 1
			if n > T.SlotCount then
				break
			end
			local pedestal = part(model, {
				Name = "Pedestal" .. n, Shape = Enum.PartType.Cylinder, Size = Vector3.new(PEDESTAL_HEIGHT, 8, 8),
				CFrame = cf * CFrame.new(x, BASE_TOP + PEDESTAL_HEIGHT / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(235, 235, 240), Material = Enum.Material.Marble,
			})
			local ring = part(model, {
				Name = "PedestalRing" .. n, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 7, 7),
				CFrame = cf * CFrame.new(x, BASE_TOP + PEDESTAL_HEIGHT + 0.05, z) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(90, 90, 100), CanCollide = false,
			})
			local slot = {
				index = n,
				part = pedestal,
				ring = ring,
				topCF = cf * CFrame.new(x, BASE_TOP + PEDESTAL_HEIGHT, z) * CFrame.Angles(0, math.pi, 0),
				prompt = makePrompt(pedestal, "owner"),
				stealPrompt = makePrompt(pedestal, "steal"),
				label = billboard(pedestal, 6, 200, 50),
				display = nil,
				stolen = false,
			}
			slot.stealPrompt.ActionText = "Roubar"
			slot.stealPrompt.HoldDuration = Config.Steal.HoldDuration
			slot.stealPrompt.KeyboardKeyCode = Enum.KeyCode.F
			plot.slots[n] = slot

			slot.prompt.Triggered:Connect(function(player)
				TycoonService.onSlotPrompt(player, plot, slot)
			end)
			slot.stealPrompt.Triggered:Connect(function(player)
				if player ~= plot.owner and TycoonService.stealHandler then
					TycoonService.stealHandler(player, plot, slot)
				end
			end)
		end
	end

	local debounce = {}
	collector.Touched:Connect(function(hit)
		local character = hit.Parent
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player or player ~= plot.owner or debounce[player] then
			return
		end
		debounce[player] = true
		TycoonService.collect(player)
		task.delay(0.5, function()
			debounce[player] = nil
		end)
	end)

	model.Parent = plotsFolder
	return plot
end

---------------------------------------------------------------------
-- Atualizar visual
---------------------------------------------------------------------
local function itemInSlot(data, slotIndex: number)
	for _, item in ipairs(data.inventory) do
		if item.slot == slotIndex then
			return item
		end
	end
	return nil
end

local function isLocked(plot): boolean
	return os.clock() < plot.lockedUntil
end

local function refreshSlot(plot, slot)
	if slot.display then
		slot.display:Destroy()
		slot.display = nil
	end

	local owner = plot.owner
	local data = owner and DataService.get(owner)
	local prompt = slot.prompt
	slot.stealPrompt.Enabled = false

	local function setRing(color: Color3, glowing: boolean)
		slot.ring.Color = color
		slot.ring.Material = if glowing then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end

	if not data then
		setRing(Color3.fromRGB(90, 90, 100), false)
		slot.label.Text = ""
		prompt.Enabled = false
		return
	end

	local maxSlots = Stats.maxSlots(data.rebirths)
	if slot.index > data.unlockedSlots then
		setRing(Color3.fromRGB(70, 70, 75), false)
		prompt.Enabled = false
		if slot.index > maxSlots then
			slot.label.Text = "♻"
		elseif slot.index == data.unlockedSlots + 1 then
			local price = T.SlotPrices[slot.index] or 0
			slot.label.Text = "🔒 Desbloquear\n<font color=\"#7CFF7C\">$" .. fmt(price) .. "</font>"
			prompt.ActionText = "Desbloquear"
			prompt.ObjectText = "$" .. fmt(price)
			prompt.Enabled = true
		else
			slot.label.Text = "🔒"
		end
		slot.label.Parent.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
		return
	end

	local item = itemInSlot(data, slot.index)
	if item and slot.stolen then
		setRing(Color3.fromRGB(255, 60, 60), true)
		slot.label.Text = "🚨 SENDO ROUBADO!"
		prompt.Enabled = false
	elseif item then
		local def = Config.getBrainrot(item.id)
		local rarity = Config.getRarity(def.rarity)
		local level = item.level or 1
		local name = Stats.displayName(def, level, item.mutation)
		setRing(rarity.color, true)

		local model = BrainrotModels.build(def, 0.9 * Stats.scale(level), Stats.stage(level), item.mutation)
		local hip = model:GetAttribute("HipHeight") or def.size.Y / 2
		model:PivotTo(slot.topCF * CFrame.new(0, hip, 0))
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CanQuery = false
			end
		end
		model.Parent = plot.model
		slot.display = model

		local income = Stats.income(def, level, item.mutation) * Stats.rebirthIncomeMultiplier(data.rebirths)
		slot.label.Text = name .. " Lv." .. level .. "\n<font color=\"#7CFF7C\">+$" .. fmt(income) .. "/s</font>"
		prompt.ActionText = "Guardar"
		prompt.ObjectText = name
		prompt.Enabled = true
		slot.stealPrompt.ObjectText = name
		slot.stealPrompt.Enabled = not isLocked(plot)
	else
		setRing(Color3.fromRGB(200, 230, 255), true)
		slot.label.Text = "Vazio\n<font size=\"14\">segure um brainrot e clique</font>"
		prompt.ActionText = "Colocar Brainrot"
		prompt.ObjectText = "Pedestal " .. slot.index
		prompt.Enabled = true
	end
	local height = if item and not slot.stolen then 8 * Stats.scale(item.level or 1) else 3
	slot.label.Parent.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
end

local function refreshSign(plot)
	if not plot.owner then
		plot.signLabel.Text = "Base livre"
	elseif isLocked(plot) then
		plot.signLabel.Text = "Base de " .. plot.owner.DisplayName .. "\n<font color=\"#FF8080\">🔒 TRANCADA "
			.. math.ceil(plot.lockedUntil - os.clock()) .. "s</font>"
	else
		plot.signLabel.Text = "Base de " .. plot.owner.DisplayName
	end
end

local function refreshPlot(plot)
	plot.model:SetAttribute("OwnerUserId", if plot.owner then plot.owner.UserId else nil)
	for _, slot in ipairs(plot.slots) do
		refreshSlot(plot, slot)
	end
	refreshSign(plot)
end

local function getIncome(player: Player): number
	local data = DataService.get(player)
	if not data then
		return 0
	end
	local total = 0
	for _, item in ipairs(data.inventory) do
		if item.slot then
			local def = Config.getBrainrot(item.id)
			if def then
				total += Stats.income(def, item.level or 1, item.mutation)
			end
		end
	end
	return total * Stats.rebirthIncomeMultiplier(data.rebirths)
end

local function updateCollectorLabel(plot)
	if plot.owner then
		plot.collectorLabel.Text = "💰 $" .. fmt(plot.stored) .. "\n<font color=\"#BFFFBF\">+$" .. fmt(getIncome(plot.owner)) .. "/s  (pise aqui)</font>"
	else
		plot.collectorLabel.Text = ""
	end
end

---------------------------------------------------------------------
-- Consultas
---------------------------------------------------------------------
function TycoonService.getPlot(player: Player)
	return plotByPlayer[player]
end

function TycoonService.getIncome(player: Player): number
	return getIncome(player)
end

function TycoonService.isInPlot(plot, position: Vector3): boolean
	local p = plot.cf:PointToObjectSpace(position)
	local half = T.PlotSize / 2
	return math.abs(p.X) <= half and math.abs(p.Z) <= half and p.Y > -5 and p.Y < 25
end

function TycoonService.getSlotItem(plot, slotIndex: number)
	local data = plot.owner and DataService.get(plot.owner)
	return data and itemInSlot(data, slotIndex)
end

function TycoonService.setSlotStolen(plot, slotIndex: number, stolen: boolean)
	local slot = plot.slots[slotIndex]
	if slot then
		slot.stolen = stolen
		refreshSlot(plot, slot)
		updateCollectorLabel(plot)
	end
end

-- O brainrot está sendo carregado por um ladrão agora?
function TycoonService.isItemStolen(player: Player, uid: string): boolean
	local plot = plotByPlayer[player]
	local item = DataService.findItem(player, uid)
	return plot ~= nil and item ~= nil and item.slot ~= nil and plot.slots[item.slot] ~= nil and plot.slots[item.slot].stolen
end

function TycoonService.isLocked(plot): boolean
	return isLocked(plot)
end

---------------------------------------------------------------------
-- Ações do jogador
---------------------------------------------------------------------
function TycoonService.refreshPlayer(player: Player)
	local plot = plotByPlayer[player]
	if plot then
		refreshPlot(plot)
		updateCollectorLabel(plot)
	end
end

function TycoonService.collect(player: Player)
	local plot = plotByPlayer[player]
	if not plot or plot.stored < 1 then
		return
	end
	local amount = math.floor(plot.stored)
	plot.stored -= amount
	DataService.addCash(player, amount)
	Remotes.notify(player, "Coletou $" .. fmt(amount) .. "!", Color3.fromRGB(100, 255, 120))
	updateCollectorLabel(plot)
end

function TycoonService.unlockNext(player: Player)
	local data = DataService.get(player)
	if not data then
		return false, "Dados não carregados"
	end
	local nextIndex = data.unlockedSlots + 1
	if nextIndex > T.SlotCount then
		return false, "Todos os pedestais já foram desbloqueados!"
	end
	if nextIndex > Stats.maxSlots(data.rebirths) then
		return false, "Faça REBIRTH ♻ para liberar mais pedestais!"
	end
	local price = T.SlotPrices[nextIndex] or 0
	if not DataService.spendCash(player, price) then
		return false, "Você precisa de $" .. fmt(price) .. " para desbloquear."
	end
	data.unlockedSlots = nextIndex
	TycoonService.refreshPlayer(player)
	DataService.pushUpdate(player)
	return true, "Pedestal " .. nextIndex .. " desbloqueado!"
end

-- Coloca um brainrot do inventário em um pedestal (o primeiro livre se slotIndex for nil)
function TycoonService.place(player: Player, uid: string?, slotIndex: number?)
	local data = DataService.get(player)
	local plot = plotByPlayer[player]
	if not data or not plot then
		return false, "Você não tem uma base."
	end

	local item
	if uid then
		item = DataService.findItem(player, uid)
		if not item then
			return false, "Brainrot não encontrado."
		end
		if item.slot then
			return false, "Esse brainrot já está em um pedestal."
		end
		if item.uid == data.companion then
			return false, "Esse é o seu parceiro de batalha! Guarde ele antes."
		end
	else
		local bestIncome = -1
		for _, candidate in ipairs(data.inventory) do
			local def = Config.getBrainrot(candidate.id)
			local income = def and Stats.income(def, candidate.level or 1, candidate.mutation)
			if not candidate.slot and candidate.uid ~= data.companion and def and income > bestIncome then
				item, bestIncome = candidate, income
			end
		end
		if not item then
			return false, "Você não tem brainrots guardados. Vá caçar!"
		end
	end

	if not slotIndex then
		for i = 1, data.unlockedSlots do
			if not itemInSlot(data, i) then
				slotIndex = i
				break
			end
		end
		if not slotIndex then
			return false, "Todos os pedestais estão ocupados. Desbloqueie mais!"
		end
	elseif slotIndex > data.unlockedSlots or itemInSlot(data, slotIndex) then
		return false, "Esse pedestal não está disponível."
	end

	item.slot = slotIndex
	refreshSlot(plot, plot.slots[slotIndex])
	updateCollectorLabel(plot)
	DataService.pushUpdate(player)
	return true, Stats.displayName(Config.getBrainrot(item.id), item.level or 1, item.mutation) .. " colocado no pedestal " .. slotIndex .. "!"
end

function TycoonService.store(player: Player, uid: string)
	local item = DataService.findItem(player, uid)
	local plot = plotByPlayer[player]
	if not item or not item.slot then
		return false, "Esse brainrot não está em um pedestal."
	end
	if TycoonService.isItemStolen(player, uid) then
		return false, "Ele está sendo roubado! Bata no ladrão!"
	end
	local slotIndex = item.slot
	item.slot = nil
	if plot then
		refreshSlot(plot, plot.slots[slotIndex])
		updateCollectorLabel(plot)
	end
	DataService.pushUpdate(player)
	return true, Stats.displayName(Config.getBrainrot(item.id), item.level or 1, item.mutation) .. " guardado."
end

-- Chamado quando um brainrot sai do inventário (vendido, trocado, roubado...)
function TycoonService.onItemRemoved(player: Player, item)
	local plot = plotByPlayer[player]
	if plot and item.slot and plot.slots[item.slot] then
		plot.slots[item.slot].stolen = false
		refreshSlot(plot, plot.slots[item.slot])
		updateCollectorLabel(plot)
	end
end

function TycoonService.onSlotPrompt(player: Player, plot, slot)
	if plot.owner ~= player then
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	local ok, msg
	if slot.index > data.unlockedSlots then
		ok, msg = TycoonService.unlockNext(player)
	else
		local item = itemInSlot(data, slot.index)
		if item then
			ok, msg = TycoonService.store(player, item.uid)
		else
			local character = player.Character
			local held = character and character:FindFirstChildOfClass("Tool")
			local heldUid = held and held:GetAttribute("BrainrotUid")
			ok, msg = TycoonService.place(player, heldUid, slot.index)
		end
	end
	if msg then
		Remotes.notify(player, msg, if ok then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 120, 120))
	end
end

-- Trancar a base: ninguém entra nem rouba por um tempo
function TycoonService.lock(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return false, "Você não tem uma base."
	end
	local now = os.clock()
	if lockCooldown[player] and now < lockCooldown[player] then
		return false, "Você pode trancar de novo em " .. math.ceil(lockCooldown[player] - now) .. "s."
	end
	plot.lockedUntil = now + T.LockDuration
	lockCooldown[player] = now + T.LockCooldown
	plot.lockField.Transparency = 0.6
	refreshPlot(plot)
	return true, "🔒 Base trancada por " .. T.LockDuration .. "s!"
end

---------------------------------------------------------------------
-- Entrar / sair
---------------------------------------------------------------------
function TycoonService.assign(player: Player)
	local data = DataService.get(player)
	for _, plot in ipairs(plots) do
		if not plot.owner then
			plot.owner = player
			plot.stored = 0
			plot.lockedUntil = 0
			plot.lockField.Transparency = 1
			plotByPlayer[player] = plot
			for _, slot in ipairs(plot.slots) do
				slot.stolen = false
			end

			if data then
				local used = {}
				for _, item in ipairs(data.inventory) do
					if item.slot then
						if item.slot > data.unlockedSlots or used[item.slot] or item.uid == data.companion then
							item.slot = nil
						else
							used[item.slot] = true
						end
					end
				end
			end

			refreshPlot(plot)
			updateCollectorLabel(plot)
			return plot
		end
	end
	Remotes.notify(player, "Todas as bases estão ocupadas neste servidor :(", Color3.fromRGB(255, 120, 120))
	return nil
end

function TycoonService.release(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local data = DataService.get(player)
	if data and plot.stored >= 1 then
		data.cash += math.floor(plot.stored)
	end
	plotByPlayer[player] = nil
	lockCooldown[player] = nil
	plot.owner = nil
	plot.stored = 0
	plot.lockedUntil = 0
	plot.lockField.Transparency = 1
	for _, slot in ipairs(plot.slots) do
		slot.stolen = false
	end
	refreshPlot(plot)
	updateCollectorLabel(plot)
end

function TycoonService.findFreeSlotNear(player: Player, position: Vector3, maxDistance: number): number?
	local plot = plotByPlayer[player]
	local data = DataService.get(player)
	if not plot or not data then
		return nil
	end
	local best, bestDist = nil, maxDistance
	for i = 1, math.min(data.unlockedSlots, #plot.slots) do
		if not itemInSlot(data, i) then
			local offset = plot.slots[i].topCF.Position - position
			local dist = Vector3.new(offset.X, 0, offset.Z).Magnitude
			if dist <= bestDist then
				best, bestDist = i, dist
			end
		end
	end
	return best
end

function TycoonService.teleportHome(player: Player)
	local plot = plotByPlayer[player]
	local character = player.Character
	if plot and character then
		character:PivotTo(plot.spawnCF)
	end
end

function TycoonService.start()
	for i, info in ipairs(T.Plots) do
		plots[i] = buildPlot(i, info)
		refreshPlot(plots[i])
	end

	-- renda passiva
	task.spawn(function()
		while true do
			task.wait(T.IncomeTick)
			for _, plot in ipairs(plots) do
				if plot.owner then
					plot.stored += getIncome(plot.owner) * T.IncomeTick
					updateCollectorLabel(plot)
				end
			end
		end
	end)

	-- bases trancadas: expulsa quem não é dono e atualiza a placa
	task.spawn(function()
		while true do
			task.wait(0.25)
			for _, plot in ipairs(plots) do
				if plot.owner and plot.lockedUntil > 0 then
					if isLocked(plot) then
						refreshSign(plot)
						for _, other in ipairs(Players:GetPlayers()) do
							local hrp = other ~= plot.owner and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
							if hrp and TycoonService.isInPlot(plot, hrp.Position) then
								other.Character:PivotTo(plot.outsideCF)
								Remotes.notify(other, "Essa base está trancada! 🔒", Color3.fromRGB(255, 120, 120))
							end
						end
					else
						plot.lockedUntil = 0
						plot.lockField.Transparency = 1
						refreshPlot(plot)
					end
				end
			end
		end
	end)
end

return TycoonService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000015"><Properties><string name="Name">WildService</string><ProtectedString name="Source"><![CDATA[-- Brainrots selvagens e CHEFÕES.
-- Cada brainrot nasce no bioma dele, anda, apanha, fica bravo e ataca, regenera
-- e desmaia se a vida zerar. Durante eventos alguns nascem com mutações.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CatchMath = require(ReplicatedStorage.Shared.CatchMath)
local Stats = require(ReplicatedStorage.Shared.Stats)
local BrainrotModels = require(script.Parent.BrainrotModels)
local DataService = require(script.Parent.DataService)
local Remotes = require(script.Parent.Remotes)

local WildService = {}

local WILD = Config.Wild
local BOSS = Config.Boss
local rng = Random.new()

local folder = Instance.new("Folder")
folder.Name = "WildBrainrots"
folder.Parent = workspace

local states = {} -- [Model] = estado
local biomeCounts = {} -- [biomeId] = quantos vivos
local bossStates = {} -- [bossId] = estado (se vivo)

-- evento atual (preenchido pelo EventService)
WildService.currentEvent = nil

---------------------------------------------------------------------
-- Avisos para outros sistemas (evita require circular)
---------------------------------------------------------------------
local listeners = { defeated = {}, bossDefeated = {}, playerAttacked = {}, bossSlam = {} }
local function fire(kind: string, ...)
	for _, fn in ipairs(listeners[kind]) do
		task.spawn(fn, ...)
	end
end
function WildService.onDefeated(fn) -- (state, player)
	table.insert(listeners.defeated, fn)
end
function WildService.onBossDefeated(fn) -- (bossConfig, contributors { [Player] = dano })
	table.insert(listeners.bossDefeated, fn)
end
function WildService.onPlayerAttacked(fn) -- (player, state)
	table.insert(listeners.playerAttacked, fn)
end
function WildService.onBossSlam(fn) -- (position, radius, damage, state)
	table.insert(listeners.bossSlam, fn)
end

---------------------------------------------------------------------
-- Utilidades
---------------------------------------------------------------------
local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function randomPoint(biome, margin: number?): Vector3
	margin = margin or 8
	local c = biome.center
	local hx, hz = biome.size.X / 2 - margin, biome.size.Y / 2 - margin
	return Vector3.new(c.X + rng:NextNumber(-hx, hx), c.Y, c.Z + rng:NextNumber(-hz, hz))
end

local function clampToBiome(biome, p: Vector3): Vector3
	local c = biome.center
	local hx, hz = biome.size.X / 2 - 3, biome.size.Y / 2 - 3
	return Vector3.new(math.clamp(p.X, c.X - hx, c.X + hx), c.Y, math.clamp(p.Z, c.Z - hz, c.Z + hz))
end

local function clampState(state, p: Vector3): Vector3
	p = clampToBiome(state.biome, p)
	if state.boss then
		local offset = flat(p - state.home)
		local limit = BOSS.WanderRadius + 25
		if offset.Magnitude > limit then
			p = state.home + offset.Unit * limit
		end
	end
	return p
end

local function pickDef(biome)
	local pool = {}
	for _, def in ipairs(Config.Brainrots) do
		if def.biome == biome.id then
			table.insert(pool, def)
		end
	end
	if #pool == 0 then
		return nil
	end
	-- sorteia a raridade (só as que existem nesse bioma), depois o brainrot
	local total = 0
	local present = {}
	for _, name in ipairs(Config.RarityOrder) do
		for _, def in ipairs(pool) do
			if def.rarity == name then
				present[name] = true
				total += Config.Rarities[name].spawnWeight
				break
			end
		end
	end
	local roll = rng:NextNumber(0, total)
	local chosen
	for _, name in ipairs(Config.RarityOrder) do
		if present[name] then
			chosen = name
			roll -= Config.Rarities[name].spawnWeight
			if roll <= 0 then
				break
			end
		end
	end
	local options = {}
	for _, def in ipairs(pool) do
		if def.rarity == chosen then
			table.insert(options, def)
		end
	end
	return options[rng:NextInteger(1, #options)]
end

local function rollMutation(): string?
	local event = WildService.currentEvent
	if event and rng:NextNumber() < event.chance then
		return event.mutation
	end
	for _, id in ipairs(Config.MutationOrder) do
		local m = Config.Mutations[id]
		if m.chance and rng:NextNumber() < m.chance then
			return id
		end
	end
	return nil
end

---------------------------------------------------------------------
-- Barra de vida
---------------------------------------------------------------------
local function nameText(state): string
	if state.boss then
		return "👑 " .. state.boss.name
	end
	return Stats.displayName(state.def, 1, state.mutation) .. "  Lv." .. state.level
end

local function createBillboard(state)
	local def = state.def
	local rarity = Config.getRarity(def.rarity)
	local isBoss = state.boss ~= nil
	local height = state.model:GetAttribute("HipHeight") or def.size.Y / 2

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = if isBoss then UDim2.fromOffset(320, 80) else UDim2.fromOffset(190, 56)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height + 3, 0)
	gui.MaxDistance = if isBoss then 250 else 110
	gui.LightInfluence = 0
	gui.Adornee = state.model.PrimaryPart

	local name = Instance.new("TextLabel")
	name.Name = "NameLabel"
	name.Size = UDim2.new(1, 0, 0, if isBoss then 30 else 20)
	name.BackgroundTransparency = 1
	name.Text = nameText(state)
	name.TextColor3 = if isBoss then Color3.fromRGB(255, 80, 80) else Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.3
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.Parent = gui

	local rarityLabel = Instance.new("TextLabel")
	rarityLabel.Name = "RarityLabel"
	rarityLabel.Position = UDim2.fromOffset(0, if isBoss then 30 else 20)
	rarityLabel.Size = UDim2.new(1, 0, 0, if isBoss then 20 else 16)
	rarityLabel.BackgroundTransparency = 1
	rarityLabel.Text = if isBoss then "CHEFÃO • não dá para capturar" else rarity.display
	rarityLabel.TextColor3 = if isBoss then Color3.fromRGB(255, 200, 80) else rarity.color
	rarityLabel.TextStrokeTransparency = 0.3
	rarityLabel.Font = Enum.Font.GothamBold
	rarityLabel.TextScaled = true
	rarityLabel.Parent = gui

	local back = Instance.new("Frame")
	back.Position = UDim2.fromOffset(15, if isBoss then 54 else 40)
	back.Size = UDim2.new(1, -30, 0, if isBoss then 20 else 12)
	back.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	back.BorderSizePixel = 0
	back.Parent = gui
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(80, 220, 80)
	fill.BorderSizePixel = 0
	fill.Parent = back
	Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 6)

	local hpText = Instance.new("TextLabel")
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.BackgroundTransparency = 1
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.TextStrokeTransparency = 0.2
	hpText.Font = Enum.Font.GothamBold
	hpText.TextScaled = true
	hpText.ZIndex = 2
	hpText.Parent = back

	gui.Parent = state.model
	state.gui = gui
	state.nameLabel = name
	state.fill = fill
	state.hpText = hpText
end

local function updateHealthBar(state)
	local ratio = math.clamp(state.health / state.maxHealth, 0, 1)
	state.fill.Size = UDim2.fromScale(ratio, 1)
	if state.boss then
		state.fill.BackgroundColor3 = Color3.fromRGB(230, 60, 60)
	elseif ratio > 0.5 then
		state.fill.BackgroundColor3 = Color3.fromRGB(80, 220, 80)
	elseif ratio > 0.2 then
		state.fill.BackgroundColor3 = Color3.fromRGB(255, 200, 40)
	else
		state.fill.BackgroundColor3 = Color3.fromRGB(240, 60, 60)
	end
	state.hpText.Text = CatchMath.formatNumber(math.ceil(state.health)) .. " / " .. CatchMath.formatNumber(state.maxHealth)
	state.model:SetAttribute("Health", state.health)
	state.model:SetAttribute("MaxHealth", state.maxHealth)
end

---------------------------------------------------------------------
-- Efeitos
---------------------------------------------------------------------
local function floatingText(position: Vector3, text: string, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = workspace

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160, 40)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Parent = gui

	TweenService:Create(anchor, TweenInfo.new(0.9), { CFrame = CFrame.new(position + Vector3.new(0, 4, 0)) }):Play()
	TweenService:Create(label, TweenInfo.new(0.9), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1)
end
WildService.floatingText = floatingText

function WildService.poof(position: Vector3, color: Color3, amount: number?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = CFrame.new(position)
	p.Parent = workspace
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.LightEmission = 0.6
	emitter.Parent = p
	emitter:Emit(amount or 35)
	Debris:AddItem(p, 1.5)
end

function WildService.shockwave(position: Vector3, radius: number, color: Color3)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.4, 2, 2)
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.45), { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.5)
end

local function flash(state)
	local h = Instance.new("Highlight")
	h.FillColor = Color3.fromRGB(255, 60, 60)
	h.FillTransparency = 0.3
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Parent = state.model
	Debris:AddItem(h, 0.15)
end

-- Empurra um jogador (o empurrão é aplicado no computador dele)
function WildService.knockbackPlayer(player: Player, fromPosition: Vector3, strength: number)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp or character:FindFirstChildOfClass("ForceField") then
		return
	end
	local dir = flat(hrp.Position - fromPosition)
	dir = if dir.Magnitude > 0.1 then dir.Unit else Vector3.new(1, 0, 0)
	Remotes.Knockback:FireClient(player, dir * strength + Vector3.new(0, strength * 0.45, 0))
end

---------------------------------------------------------------------
-- Ciclo de vida
---------------------------------------------------------------------
local function recordTransparency(state)
	state.transparency = {}
	for _, d in ipairs(state.model:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			state.transparency[d] = d.Transparency
		end
	end
end

local function newState(def, biome, level: number, mutation: string?, bossCfg)
	local scale = if bossCfg then bossCfg.scale else 1
	local model = BrainrotModels.build(def, scale, if bossCfg then 3 else 1, mutation)
	local maxHealth = if bossCfg then bossCfg.maxHealth else Stats.maxHealth(def, level, 1, mutation)
	local state = {
		def = def,
		model = model,
		biome = biome,
		boss = bossCfg,
		level = level,
		mutation = mutation,
		maxHealth = maxHealth,
		power = if bossCfg then bossCfg.damage else Stats.power(def, level, 1, mutation),
		health = maxHealth,
		position = randomPoint(biome),
		yaw = rng:NextNumber(0, math.pi * 2),
		target = nil,
		idleUntil = 0,
		lastDamage = 0,
		lastAttack = 0,
		lastSlam = os.clock(),
		aggroPlayer = nil,
		aggroCompanion = nil,
		aggroUntil = 0,
		capturing = false,
		hipHeight = model:GetAttribute("HipHeight") or def.size.Y / 2 * scale,
		phase = rng:NextNumber(0, 10),
		contributors = {},
		active = true,
		nextActiveCheck = 0,
	}
	if bossCfg then
		state.home = Vector3.new(bossCfg.position.X, biome.center.Y, bossCfg.position.Z)
		state.position = state.home
	end
	recordTransparency(state)

	model:SetAttribute("BrainrotId", def.id)
	model:SetAttribute("Level", level)
	model:SetAttribute("Mutation", mutation)
	model:SetAttribute("IsBoss", bossCfg ~= nil)
	model:PivotTo(CFrame.new(state.position + Vector3.new(0, state.hipHeight, 0)) * CFrame.Angles(0, state.yaw, 0))
	model.Parent = folder
	createBillboard(state)
	updateHealthBar(state)
	states[model] = state
	return state
end

local function spawnOne(biome)
	local def = pickDef(biome)
	if not def then
		return nil
	end
	local range = Config.getRarity(def.rarity).wildLevels or { 1, 1 }
	local state = newState(def, biome, rng:NextInteger(range[1], range[2]), rollMutation(), nil)
	biomeCounts[biome.id] = (biomeCounts[biome.id] or 0) + 1
	WildService.poof(state.position + Vector3.new(0, 2, 0), Config.getRarity(def.rarity).color)
	return state
end

local function despawn(state)
	if not states[state.model] then
		return
	end
	states[state.model] = nil
	if state.boss then
		bossStates[state.boss.id] = nil
	else
		biomeCounts[state.biome.id] = math.max(0, (biomeCounts[state.biome.id] or 1) - 1)
	end
	state.model:Destroy()
end

function WildService.spawnBoss(bossId: string)
	local cfg = Config.getBoss(bossId)
	if not cfg or bossStates[bossId] then
		return nil
	end
	local def = Config.getBrainrot(cfg.brainrot)
	local biome = Config.getBiome(cfg.biome)
	if not def or not biome then
		warn("[WildService] chefão mal configurado: " .. bossId)
		return nil
	end
	local state = newState(def, biome, 50, nil, cfg)
	bossStates[bossId] = state
	WildService.poof(state.position + Vector3.new(0, 6, 0), Color3.fromRGB(255, 60, 60), 80)
	for _, p in ipairs(Players:GetPlayers()) do
		Remotes.notify(p, "👑 O chefão " .. cfg.name .. " apareceu em " .. biome.name .. "!", Color3.fromRGB(255, 120, 90))
	end
	return state
end

local function bossDied(state)
	local cfg = state.boss
	WildService.poof(state.model:GetPivot().Position, Color3.fromRGB(255, 220, 80), 120)
	local contributors = state.contributors
	despawn(state)
	fire("bossDefeated", cfg, contributors)
	task.delay(cfg.respawn, function()
		WildService.spawnBoss(cfg.id)
	end)
end

local function faint(state, player: Player?)
	if state.boss then
		bossDied(state)
		return
	end
	local def = state.def
	local rarity = Config.getRarity(def.rarity)
	WildService.poof(state.model:GetPivot().Position, rarity.color)
	despawn(state)
	if player then
		local reward = math.floor(rarity.faintReward * (1 + 0.25 * (state.level - 1)) * Stats.mutationMult(state.mutation, "income"))
		DataService.addCash(player, reward)
		Remotes.notify(player, Stats.displayName(def, 1, state.mutation) .. " Lv." .. state.level .. " foi derrotado! +$"
			.. CatchMath.formatNumber(reward), Color3.fromRGB(255, 170, 60))
		fire("defeated", state, player)
	end
end

-- Muda a mutação de um selvagem vivo (usado quando um evento começa)
function WildService.setMutation(state, mutationId: string)
	if not WildService.isAlive(state) or state.boss or state.capturing then
		return
	end
	local ratio = state.health / state.maxHealth
	state.mutation = mutationId
	state.maxHealth = Stats.maxHealth(state.def, state.level, 1, mutationId)
	state.power = Stats.power(state.def, state.level, 1, mutationId)
	state.health = state.maxHealth * ratio
	local old = state.model:FindFirstChild("Mutation")
	if old then
		old:Destroy()
	end
	local oldParticles = state.model.PrimaryPart and state.model.PrimaryPart:FindFirstChild("MutationParticles")
	if oldParticles then
		oldParticles:Destroy()
	end
	BrainrotModels.applyMutation(state.model, mutationId)
	state.model:SetAttribute("Mutation", mutationId)
	state.nameLabel.Text = nameText(state)
	updateHealthBar(state)
	WildService.poof(state.position + Vector3.new(0, 2, 0), Config.getMutation(mutationId).color)
end

function WildService.forEachWild(fn)
	for _, state in pairs(states) do
		if not state.boss then
			fn(state)
		end
	end
end

---------------------------------------------------------------------
-- API usada pelo taco, bolas e parceiro
---------------------------------------------------------------------
function WildService.getStateFromPart(part: Instance)
	local model = part
	while model and model.Parent ~= folder do
		model = model.Parent
	end
	if model then
		return states[model]
	end
	return nil
end

function WildService.getStateFromModel(model: Instance)
	return states[model]
end

function WildService.isAlive(state): boolean
	return state ~= nil and states[state.model] == state
end

function WildService.isBoss(state): boolean
	return state ~= nil and state.boss ~= nil
end

function WildService.radius(state): number
	local scale = if state.boss then state.boss.scale else 1
	return state.def.size.X / 2 * scale
end

-- Acha o brainrot mais perto na frente do jogador
function WildService.findTargetInFront(player: Player, range: number)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil, nil
	end
	local best, bestDist = nil, math.huge
	for _, state in pairs(states) do
		if not state.capturing then
			local pos = state.model:GetPivot().Position
			local offset = flat(pos - hrp.Position)
			local dist = offset.Magnitude - WildService.radius(state)
			if dist <= range and math.abs(pos.Y - hrp.Position.Y) < 12 + state.hipHeight then
				local facing = offset.Magnitude < 0.1 or flat(hrp.CFrame.LookVector).Unit:Dot(offset.Unit) > 0.2
				if facing and dist < bestDist then
					best, bestDist = state, dist
				end
			end
		end
	end
	return best, bestDist
end

-- companion = o parceiro que bateu (ou nil se foi o jogador)
function WildService.damage(state, amount: number, player: Player?, companion: any?)
	if not WildService.isAlive(state) or state.capturing then
		return
	end
	amount = math.max(1, math.floor(amount + 0.5))
	state.health -= amount
	state.lastDamage = os.clock()
	if player then
		state.contributors[player] = (state.contributors[player] or 0) + amount
	end
	flash(state)
	floatingText(state.model:GetPivot().Position + Vector3.new(0, state.hipHeight + 1, 0), "-" .. amount, Color3.fromRGB(255, 80, 80))

	if state.health <= 0 then
		state.health = 0
		faint(state, player)
		return
	end
	updateHealthBar(state)

	local sourcePosition
	if companion and companion:isAlive() then
		state.aggroCompanion = companion
		state.aggroPlayer = nil
		state.aggroUntil = os.clock() + WILD.AggroTime
		sourcePosition = companion:getPosition()
	elseif player then
		state.aggroPlayer = player
		state.aggroCompanion = nil
		state.aggroUntil = os.clock() + WILD.AggroTime
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		sourcePosition = hrp and hrp.Position
	end
	if sourcePosition and not state.boss then
		local away = flat(state.position - sourcePosition)
		if away.Magnitude > 0.1 then
			state.position = clampState(state, state.position + away.Unit * WILD.Knockback)
		end
	end
end

function WildService.getChance(state, ballMultiplier: number): number
	if state.boss then
		return 0
	end
	return CatchMath.getChance(state.def.catchRate, state.health, state.maxHealth, ballMultiplier)
end

function WildService.setCapturing(state, capturing: boolean)
	state.capturing = capturing
	for part, original in pairs(state.transparency) do
		if part.Parent then
			part.Transparency = if capturing then 1 else original
		end
	end
	for _, d in ipairs(state.model:GetDescendants()) do
		if d:IsA("Highlight") or d:IsA("ParticleEmitter") or d:IsA("PointLight") then
			d.Enabled = not capturing
		end
	end
	if state.gui then
		state.gui.Enabled = not capturing
	end
end

function WildService.releaseAfterFail(state, player: Player?)
	if not WildService.isAlive(state) then
		return
	end
	WildService.setCapturing(state, false)
	if player then
		state.aggroPlayer = player
		state.aggroCompanion = nil
		state.aggroUntil = os.clock() + WILD.AggroTime
	end
end

function WildService.removeCaptured(state)
	despawn(state)
end

function WildService.getPosition(state): Vector3
	return state.position
end

function WildService.getInRadius(position: Vector3, radius: number)
	local list = {}
	for _, state in pairs(states) do
		if not state.capturing then
			local dist = flat(state.position - position).Magnitude - WildService.radius(state)
			if dist <= radius and math.abs(state.position.Y - position.Y) < 30 then
				table.insert(list, state)
			end
		end
	end
	return list
end

function WildService.findNearest(position: Vector3, radius: number)
	local best, bestDist = nil, math.huge
	for _, state in pairs(states) do
		if not state.capturing and math.abs(state.position.Y - position.Y) < 30 then
			local dist = flat(state.position - position).Magnitude
			if dist <= radius and dist < bestDist then
				best, bestDist = state, dist
			end
		end
	end
	return best
end

function WildService.findAggressor(player: Player, companion: any?, position: Vector3, radius: number)
	local now = os.clock()
	local best, bestDist = nil, math.huge
	for _, state in pairs(states) do
		if not state.capturing and now <= state.aggroUntil
			and (state.aggroPlayer == player or (companion and state.aggroCompanion == companion)) then
			local dist = flat(state.position - position).Magnitude
			if dist <= radius and dist < bestDist then
				best, bestDist = state, dist
			end
		end
	end
	return best
end

---------------------------------------------------------------------
-- Movimento e IA
---------------------------------------------------------------------
local function getAggroTarget(state)
	if os.clock() > state.aggroUntil then
		state.aggroPlayer = nil
		state.aggroCompanion = nil
		return nil
	end
	local companion = state.aggroCompanion
	if companion then
		if companion:isAlive() then
			return companion:getPosition(), function(amount)
				companion:takeDamage(amount, state)
			end
		end
		state.aggroCompanion = nil
		return nil
	end
	local player = state.aggroPlayer
	if not player or player.Parent ~= Players then
		state.aggroPlayer = nil
		return nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not hrp then
		state.aggroPlayer = nil
		return nil
	end
	return hrp.Position, function()
		humanoid:TakeDamage(if state.boss then state.boss.damage else state.def.damage)
		fire("playerAttacked", player, state)
	end
end

local function bossSlam(state)
	local cfg = state.boss
	local center = state.position
	WildService.shockwave(center + Vector3.new(0, 0.5, 0), BOSS.SlamRadius, Color3.fromRGB(255, 80, 60))
	WildService.poof(center + Vector3.new(0, 1, 0), Color3.fromRGB(150, 110, 80), 50)
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if hrp and humanoid and humanoid.Health > 0 and (hrp.Position - center).Magnitude <= BOSS.SlamRadius + 4 then
			humanoid:TakeDamage(cfg.damage)
			WildService.knockbackPlayer(player, center, BOSS.SlamKnockback)
		end
	end
	fire("bossSlam", center, BOSS.SlamRadius, cfg.damage * 2, state)
end

local function updateActive(state, now: number)
	if now < state.nextActiveCheck then
		return
	end
	state.nextActiveCheck = now + 0.5 + rng:NextNumber() * 0.3
	local active = false
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.Position - state.position).Magnitude < WILD.ActiveDistance then
			active = true
			break
		end
	end
	state.active = active
end

local function step(state, dt: number, now: number)
	if state.capturing then
		return
	end
	updateActive(state, now)
	if not state.active then
		return
	end
	local def = state.def
	local isBoss = state.boss ~= nil

	-- regenerar
	local regenDelay = if isBoss then BOSS.RegenDelay else WILD.RegenDelay
	local regenRate = if isBoss then BOSS.RegenPercentPerSecond else WILD.RegenPercentPerSecond
	if state.health < state.maxHealth and now - state.lastDamage > regenDelay then
		state.health = math.min(state.maxHealth, state.health + state.maxHealth * regenRate * dt)
		if state.health >= state.maxHealth then
			state.contributors = {}
		end
		updateHealthBar(state)
	end

	local goal
	local speed = def.speed
	local targetPosition, hitTarget = getAggroTarget(state)
	local chasing = targetPosition ~= nil
	local reach = WILD.AttackRange + WildService.radius(state)
	if targetPosition then
		goal = clampState(state, targetPosition)
		speed = def.speed * 1.15
		local dist = flat(targetPosition - state.position).Magnitude
		if dist <= reach and now - state.lastAttack >= WILD.AttackCooldown then
			state.lastAttack = now
			hitTarget(state.power)
			state.phase += 2
		end
		if isBoss and now - state.lastSlam >= BOSS.SlamInterval then
			state.lastSlam = now
			bossSlam(state)
		end
	else
		if now >= state.idleUntil and (not state.target or flat(state.target - state.position).Magnitude < 2) then
			if state.target and rng:NextNumber() < 0.4 then
				state.idleUntil = now + rng:NextNumber(1, 3)
				state.target = nil
			elseif isBoss then
				local a = rng:NextNumber(0, math.pi * 2)
				state.target = clampState(state, state.home + Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(0, BOSS.WanderRadius))
			else
				state.target = randomPoint(state.biome)
			end
		end
		goal = if now < state.idleUntil then nil else state.target
	end

	local moving = false
	if goal then
		local offset = flat(goal - state.position)
		local dist = offset.Magnitude
		local stopDist = if chasing then 2.5 + WildService.radius(state) * 0.5 else 0.1
		if dist > stopDist then
			local dir = offset.Unit
			state.position = clampState(state, state.position + dir * math.min(speed * dt, dist - stopDist))
			state.yaw = math.atan2(-dir.X, -dir.Z)
			moving = true
		elseif chasing and dist > 0.01 then
			local dir = offset.Unit
			state.yaw = math.atan2(-dir.X, -dir.Z)
		end
	end

	local hop
	if moving then
		state.phase += dt * speed * 0.6
		hop = math.abs(math.sin(state.phase)) * (if isBoss then 1.5 else 0.8)
	else
		hop = math.abs(math.sin(now * 2 + state.phase)) * 0.15
	end
	local cf = CFrame.new(state.position + Vector3.new(0, state.hipHeight + hop, 0)) * CFrame.Angles(0, state.yaw, 0)
	state.model:PivotTo(cf)
end

---------------------------------------------------------------------
-- Iniciar
---------------------------------------------------------------------
function WildService.start()
	for _, biome in ipairs(Config.Biomes) do
		biomeCounts[biome.id] = 0
		for _ = 1, math.floor(biome.maxAlive / 2) do
			spawnOne(biome)
		end
	end

	task.spawn(function()
		while true do
			task.wait(WILD.SpawnInterval)
			for _, biome in ipairs(Config.Biomes) do
				if (biomeCounts[biome.id] or 0) < biome.maxAlive then
					spawnOne(biome)
				end
			end
		end
	end)

	task.delay(20, function()
		for _, cfg in ipairs(Config.Bosses) do
			WildService.spawnBoss(cfg.id)
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		for _, state in pairs(states) do
			local ok, err = pcall(step, state, dt, now)
			if not ok then
				warn("[WildService] erro no brainrot " .. state.def.id .. ": " .. tostring(err))
				despawn(state)
			end
		end
	end)
end

return WildService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000016"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[-- Constrói o mapa: uma ilha grande com mar em volta e 6 BIOMAS
-- (Floresta, Deserto, Pântano, Montanha de Neve, Vulcão e o Céu Celestial flutuando),
-- caminhos de pedra, praça do spawn com o Portal Celestial, Arena de Duelo e decoração.
-- As bases (tycoons) são construídas pelo TycoonService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage.Shared.Config)
local BrainrotModels = require(script.Parent.BrainrotModels)

local WorldBuilder = {}

local V = Vector3.new
local RGB = Color3.fromRGB
local M = Enum.Material

local terrain = workspace.Terrain
local rng = Random.new(2025)

local ISLAND = 1120
local BEACH = 40
local HUB = V(-170, 0, 0)

---------------------------------------------------------------------
-- Ajudantes
---------------------------------------------------------------------
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function cyl(parent, diameter: number, height: number, pos: Vector3, color: Color3, material)
	return part(parent, {
		Shape = Enum.PartType.Cylinder, Size = V(height, diameter, diameter),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Material = material or M.SmoothPlastic,
	})
end

local function ball(parent, diameter: number, pos: Vector3, color: Color3, material)
	return part(parent, {
		Shape = Enum.PartType.Ball, Size = Vector3.one * diameter, CFrame = CFrame.new(pos), Color = color,
		Material = material or M.SmoothPlastic, CanCollide = false,
	})
end

local function textOn(board: BasePart, text: string, color: Color3, faces)
	for _, face in ipairs(faces) do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.CanvasSize = Vector2.new(board.Size.X * 20, board.Size.Y * 20)
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = color
		label.TextStrokeTransparency = 0
		label.TextScaled = true
		label.RichText = true
		label.Font = Enum.Font.FredokaOne
		label.Parent = gui
		gui.Parent = board
	end
end

local blocked = {}
local function block(cx, cz, sx, sz)
	table.insert(blocked, { cx - sx / 2, cx + sx / 2, cz - sz / 2, cz + sz / 2 })
end
local function isFree(x: number, z: number, margin: number): boolean
	for _, r in ipairs(blocked) do
		if x > r[1] - margin and x < r[2] + margin and z > r[3] - margin and z < r[4] + margin then
			return false
		end
	end
	return true
end

local function path(x1, z1, x2, z2, width)
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	local sx = math.abs(x2 - x1) + width
	local sz = math.abs(z2 - z1) + width
	terrain:FillBlock(CFrame.new(cx, -2, cz), V(sx, 4, sz), M.Cobblestone)
	block(cx, cz, sx, sz)
end

local function unlockText(biome): string
	local u = biome.unlock or {}
	local parts = {}
	if u.level then
		table.insert(parts, "Nível " .. u.level)
	end
	if u.boss then
		local boss = Config.getBoss(u.boss)
		table.insert(parts, "Derrote " .. (if boss then boss.name else u.boss))
	end
	if u.rebirths then
		table.insert(parts, u.rebirths .. " Rebirth")
	end
	if #parts == 0 then
		return "Livre"
	end
	return "🔒 " .. table.concat(parts, " + ")
end

-- ponto aleatório dentro do bioma, longe das entradas e do chefão
local function biomePoint(biome, margin: number)
	local c = biome.center
	for _ = 1, 20 do
		local x = c.X + rng:NextNumber(-biome.size.X / 2 + margin, biome.size.X / 2 - margin)
		local z = c.Z + rng:NextNumber(-biome.size.Y / 2 + margin, biome.size.Y / 2 - margin)
		local ok = true
		local relX, relZ = x - c.X, z - c.Z
		if (math.abs(relX) < 16 and math.abs(math.abs(relZ) - biome.size.Y / 2) < 20)
			or (math.abs(relZ) < 16 and math.abs(math.abs(relX) - biome.size.X / 2) < 20) then
			ok = false -- perto de uma entrada
		end
		for _, boss in ipairs(Config.Bosses) do
			if boss.biome == biome.id and (V(x, 0, z) - V(boss.position.X, 0, boss.position.Z)).Magnitude < 30 then
				ok = false
			end
		end
		if biome.id == "Floresta" and V(relX, 0, relZ).Magnitude < 22 then
			ok = false -- estátua
		end
		if ok then
			return V(x, c.Y, z)
		end
	end
	return nil
end

---------------------------------------------------------------------
-- Peças de decoração
---------------------------------------------------------------------
local function roundTree(parent, pos: Vector3)
	local height = rng:NextNumber(9, 15)
	cyl(parent, rng:NextNumber(1.6, 2.4), height, pos + V(0, height / 2, 0), RGB(110, 75, 45), M.Wood)
	local green = RGB(rng:NextInteger(50, 80), rng:NextInteger(140, 185), rng:NextInteger(45, 75))
	local size = rng:NextNumber(8, 11)
	ball(parent, size, pos + V(0, height + size * 0.25, 0), green, M.Grass)
	ball(parent, size * 0.7, pos + V(size * 0.35, height - 0.5, size * 0.1), green, M.Grass)
	ball(parent, size * 0.7, pos + V(-size * 0.3, height, -size * 0.25), green, M.Grass)
end

local function pineTree(parent, pos: Vector3, snowy: boolean?)
	local height = rng:NextNumber(4, 6)
	cyl(parent, 1.4, height, pos + V(0, height / 2, 0), RGB(100, 65, 40), M.Wood)
	local green = RGB(40, rng:NextInteger(110, 140), 60)
	local y = height
	for i = 0, 3 do
		local d = 9 - i * 2
		cyl(parent, d, 2.2, pos + V(0, y + 1.1, 0), green, M.Grass).CanCollide = false
		if snowy then
			cyl(parent, d * 0.9, 0.5, pos + V(0, y + 2.3, 0), RGB(245, 250, 255), M.Snow).CanCollide = false
		end
		y += 2
	end
end

local function flowers(parent, center: Vector3, count: number)
	local colors = { RGB(255, 90, 120), RGB(255, 220, 60), RGB(255, 255, 255), RGB(170, 110, 255), RGB(255, 150, 60) }
	local color = colors[rng:NextInteger(1, #colors)]
	for _ = 1, count do
		local pos = center + V(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		part(parent, { Size = V(0.15, 0.8, 0.15), CFrame = CFrame.new(pos + V(0, 0.4, 0)), Color = RGB(60, 140, 50), CanCollide = false, CastShadow = false })
		ball(parent, 0.6, pos + V(0, 0.9, 0), color).CastShadow = false
	end
end

local function rock(parent, pos: Vector3, color: Color3?, material)
	local size = V(rng:NextNumber(2, 5), rng:NextNumber(1.5, 3.5), rng:NextNumber(2, 5))
	part(parent, {
		Size = size, CFrame = CFrame.new(pos + V(0, size.Y / 2 - 0.4, 0))
			* CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)),
		Color = color or RGB(130, 125, 120), Material = material or M.Slate,
	})
end

local function cactus(parent, pos: Vector3)
	local green = RGB(70, 150, 70)
	local height = rng:NextNumber(5, 9)
	cyl(parent, 1.6, height, pos + V(0, height / 2, 0), green, M.Grass)
	ball(parent, 1.6, pos + V(0, height, 0), green, M.Grass)
	for _, s in ipairs({ -1, 1 }) do
		if rng:NextNumber() < 0.75 then
			local armY = rng:NextNumber(height * 0.35, height * 0.65)
			part(parent, { Shape = Enum.PartType.Cylinder, Size = V(1.6, 1, 1), CFrame = CFrame.new(pos + V(s * 1.2, armY, 0)), Color = green, Material = M.Grass })
			cyl(parent, 1, 2.4, pos + V(s * 2, armY + 1.2, 0), green, M.Grass)
			ball(parent, 1, pos + V(s * 2, armY + 2.4, 0), green, M.Grass)
		end
	end
end

local function deadTree(parent, pos: Vector3)
	local dark = RGB(70, 55, 45)
	local height = rng:NextNumber(8, 13)
	cyl(parent, 1.5, height, pos + V(0, height / 2, 0), dark, M.Wood)
	for _ = 1, 3 do
		local y = rng:NextNumber(height * 0.5, height)
		local a = rng:NextNumber(0, 6.28)
		part(parent, {
			Size = V(0.5, 0.5, 4), CFrame = CFrame.new(pos + V(0, y, 0)) * CFrame.Angles(0, a, 0) * CFrame.Angles(math.rad(-30), 0, 0) * CFrame.new(0, 0, -2),
			Color = dark, Material = M.Wood,
		})
	end
end

local function snowman(parent, pos: Vector3)
	ball(parent, 4, pos + V(0, 1.8, 0), RGB(250, 250, 255), M.Snow).CanCollide = true
	ball(parent, 3, pos + V(0, 4.6, 0), RGB(250, 250, 255), M.Snow)
	ball(parent, 2.2, pos + V(0, 6.6, 0), RGB(250, 250, 255), M.Snow)
	part(parent, { Size = V(0.3, 0.3, 1), CFrame = CFrame.new(pos + V(0, 6.6, -1.4)), Color = RGB(255, 140, 40), CanCollide = false })
	for _, s in ipairs({ -1, 1 }) do
		ball(parent, 0.3, pos + V(s * 0.4, 7, -1), RGB(20, 20, 20))
	end
	cyl(parent, 1.6, 1.2, pos + V(0, 8, 0), RGB(30, 30, 30))
end

local function crystal(parent, pos: Vector3, color: Color3)
	local height = rng:NextNumber(3, 7)
	part(parent, {
		Size = V(1.2, height, 1.2), CFrame = CFrame.new(pos + V(0, height / 2, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)),
		Color = color, Material = M.Neon, Transparency = 0.2, CanCollide = false,
	})
end

local function lavaPool(parent, pos: Vector3)
	local size = rng:NextNumber(8, 16)
	local pool = cyl(parent, size, 0.3, pos + V(0, 0.1, 0), RGB(255, 100, 20), M.Neon)
	pool.CanCollide = false
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 8
	fire.Parent = pool
	local light = Instance.new("PointLight")
	light.Color = RGB(255, 120, 40)
	light.Range = size
	light.Brightness = 2
	light.Parent = pool
end

local function cloud(parent, pos: Vector3, size: number)
	for _ = 1, 4 do
		local p = ball(parent, size * rng:NextNumber(0.6, 1), pos + V(rng:NextNumber(-size, size) * 0.6, rng:NextNumber(-1, 1), rng:NextNumber(-size, size) * 0.4),
			RGB(255, 255, 255), M.SmoothPlastic)
		p.Transparency = 0.15
		p.CastShadow = false
	end
end

local function lamp(parent, pos: Vector3)
	cyl(parent, 0.6, 9, pos + V(0, 4.5, 0), RGB(50, 50, 55), M.Metal)
	local bulb = ball(parent, 1.4, pos + V(0, 9.5, 0), RGB(255, 235, 170), M.Neon)
	local light = Instance.new("PointLight")
	light.Color = RGB(255, 220, 160)
	light.Range = 22
	light.Brightness = 1.5
	light.Parent = bulb
end

local function fence(parent, x1, z1, x2, z2, gapCenter: number?, gapSize: number, y: number, color: Color3)
	local dir = V(x2 - x1, 0, z2 - z1)
	local length = dir.Magnitude
	local unit = dir.Unit
	local start = V(x1, y, z1)
	local function segment(a: number, b: number)
		if b - a < 1 then
			return
		end
		local mid = start + unit * ((a + b) / 2)
		local cf = CFrame.lookAt(mid, mid + unit)
		for _, h in ipairs({ 1.3, 2.5 }) do
			part(parent, { Size = V(0.3, 0.35, b - a), CFrame = cf + V(0, h, 0), Color = color, Material = M.WoodPlanks })
		end
		local d = a
		while d <= b do
			part(parent, { Size = V(0.6, 3.2, 0.6), CFrame = CFrame.new(start + unit * d + V(0, 1.6, 0)), Color = color, Material = M.Wood })
			d += 10
		end
	end
	if gapCenter then
		segment(0, gapCenter - gapSize / 2)
		segment(gapCenter + gapSize / 2, length)
	else
		segment(0, length)
	end
end

local function fenceBiome(parent, biome, color: Color3)
	local c = biome.center
	local hx, hz = biome.size.X / 2, biome.size.Y / 2
	local gap = 22
	fence(parent, c.X - hx, c.Z - hz, c.X + hx, c.Z - hz, hx, gap, c.Y, color)
	fence(parent, c.X - hx, c.Z + hz, c.X + hx, c.Z + hz, hx, gap, c.Y, color)
	fence(parent, c.X - hx, c.Z - hz, c.X - hx, c.Z + hz, hz, gap, c.Y, color)
	fence(parent, c.X + hx, c.Z - hz, c.X + hx, c.Z + hz, hz, gap, c.Y, color)
end

local function arch(parent, pos: Vector3, facing: Vector3, title: string, subtitle: string, color: Color3)
	local cf = CFrame.lookAt(pos, pos + facing)
	for _, s in ipairs({ -1, 1 }) do
		part(parent, { Size = V(2, 14, 2), CFrame = cf * CFrame.new(s * 9, 7, 0), Color = RGB(200, 190, 175), Material = M.Brick })
		ball(parent, 2.2, (cf * CFrame.new(s * 9, 14.5, 0)).Position, color, M.Neon)
	end
	local beam = part(parent, { Size = V(22, 5, 1.2), CFrame = cf * CFrame.new(0, 12.5, 0), Color = RGB(70, 45, 30), Material = M.Wood })
	textOn(beam, title .. "\n<font size=\"40\">" .. subtitle .. "</font>", color, { Enum.NormalId.Front, Enum.NormalId.Back })
end

---------------------------------------------------------------------
-- Terreno
---------------------------------------------------------------------
local function buildTerrain()
	terrain:SetMaterialColor(M.Grass, RGB(100, 180, 75))
	terrain:SetMaterialColor(M.LeafyGrass, RGB(80, 160, 65))
	terrain:SetMaterialColor(M.Cobblestone, RGB(160, 150, 135))
	terrain:SetMaterialColor(M.Sand, RGB(235, 215, 155))
	terrain:SetMaterialColor(M.Mud, RGB(85, 75, 55))
	terrain:SetMaterialColor(M.Basalt, RGB(55, 50, 50))
	terrain:SetMaterialColor(M.Rock, RGB(125, 120, 115))
	terrain:SetMaterialColor(M.Salt, RGB(240, 245, 255))
	terrain.WaterColor = RGB(40, 150, 210)
	terrain.WaterTransparency = 0.4
	terrain.WaterWaveSize = 0.15
	terrain.WaterWaveSpeed = 8
	pcall(function()
		terrain.Decoration = true
	end)

	terrain:FillBlock(CFrame.new(0, -24, 0), V(1800, 4, 1800), M.Sand)
	terrain:FillBlock(CFrame.new(0, -12, 0), V(1800, 20, 1800), M.Water)
	terrain:FillBlock(CFrame.new(0, -8, 0), V(ISLAND + BEACH * 2, 16, ISLAND + BEACH * 2), M.Sand)
	terrain:FillBlock(CFrame.new(0, -8, 0), V(ISLAND, 16, ISLAND), M.Grass)

	local materials = {
		Floresta = M.LeafyGrass, Deserto = M.Sand, Pantano = M.Mud, Neve = M.Snow, Vulcao = M.Basalt,
	}
	for _, biome in ipairs(Config.Biomes) do
		local c = biome.center
		if biome.id == "Ceu" then
			terrain:FillBlock(CFrame.new(c.X, c.Y - 5, c.Z), V(biome.size.X, 10, biome.size.Y), M.Salt)
			terrain:FillBall(c + V(0, -55, 0), 50, M.Rock)
			terrain:FillBall(c + V(-50, -35, 30), 28, M.Rock)
			terrain:FillBall(c + V(55, -38, -25), 30, M.Rock)
		else
			terrain:FillBlock(CFrame.new(c.X, -2, c.Z), V(biome.size.X, 4, biome.size.Y), materials[biome.id] or M.Grass)
			block(c.X, c.Z, biome.size.X + 10, biome.size.Y + 10)
		end
	end

	-- poças no pântano e lava rachada no vulcão
	local swamp = Config.getBiome("Pantano")
	if swamp then
		for _ = 1, 10 do
			local p = biomePoint(swamp, 20)
			if p then
				terrain:FillBlock(CFrame.new(p.X, -1, p.Z), V(rng:NextInteger(3, 6) * 4, 2, rng:NextInteger(3, 5) * 4), M.Water)
			end
		end
	end
	local volcano = Config.getBiome("Vulcao")
	if volcano then
		for _ = 1, 14 do
			local p = biomePoint(volcano, 15)
			if p then
				terrain:FillBlock(CFrame.new(p.X, -2, p.Z), V(rng:NextInteger(2, 5) * 4, 4, rng:NextInteger(2, 5) * 4), M.CrackedLava)
			end
		end
	end

	-- caminhos de pedra
	for _, info in ipairs(Config.Tycoon.Plots) do
		local p = info.position
		block(p.X, p.Z, Config.Tycoon.PlotSize + 6, Config.Tycoon.PlotSize + 6)
		local dir = if p.Z > 0 then -1 else 1
		local front = p.Z + dir * Config.Tycoon.PlotSize / 2
		path(p.X, front, p.X, front + dir * 14, 10)
	end
	for _, s in ipairs({ -1, 1 }) do
		path(-140, s * 136, 140, s * 136, 10)
		path(0, s * 136, 0, s * 112, 10)
	end
	path(110, 0, 230, 0, 10) -- floresta -> deserto
	path(-230, 0, -110, 0, 10) -- pântano -> praça -> floresta
	path(65, -136, 65, -312, 10) -- até a neve
	path(65, -312, 0, -312, 10)
	path(-65, 136, -65, 312, 10) -- até o vulcão
	path(-65, 312, 0, 312, 10)
	path(170, 0, 170, -56, 8) -- arena
	block(HUB.X, HUB.Z, 60, 110)
	block(Config.Duel.Arena.X, Config.Duel.Arena.Z, 80, 80)

	-- montanhas
	local function mountain(pos: Vector3, radius: number, top)
		terrain:FillBall(pos, radius, M.Rock)
		terrain:FillBall(pos + V(0, -radius * 0.25, 0), radius * 0.95, top or M.Grass)
		block(pos.X, pos.Z, radius * 2, radius * 2)
	end
	mountain(V(-480, -12, -480), 50)
	mountain(V(480, -12, -480), 50)
	mountain(V(-480, -12, 480), 50)
	mountain(V(480, -12, 480), 50)
	for _, x in ipairs({ -330, 330 }) do
		terrain:FillBall(V(x, -10, -430), 58, M.Rock)
		terrain:FillBall(V(x, 26, -430), 26, M.Snow)
		block(x, -430, 116, 116)
	end
	for _, x in ipairs({ -330, 330 }) do
		terrain:FillBall(V(x, -14, 430), 62, M.Basalt)
		terrain:FillBall(V(x, 40, 430), 14, M.CrackedLava)
		block(x, 430, 124, 124)
	end
end

---------------------------------------------------------------------
-- Biomas
---------------------------------------------------------------------
local function decorateBiome(parent, biome)
	local folder = Instance.new("Folder")
	folder.Name = biome.id
	folder.Parent = parent
	local function scatter(count: number, margin: number, fn)
		for _ = 1, count do
			local p = biomePoint(biome, margin)
			if p then
				fn(p)
			end
		end
	end

	if biome.id == "Floresta" then
		scatter(22, 8, function(p)
			if rng:NextNumber() < 0.6 then
				roundTree(folder, p)
			else
				pineTree(folder, p)
			end
		end)
		scatter(30, 4, function(p)
			flowers(folder, p, rng:NextInteger(4, 8))
		end)
		scatter(8, 6, function(p)
			rock(folder, p)
		end)
	elseif biome.id == "Deserto" then
		scatter(26, 8, function(p)
			cactus(folder, p)
		end)
		scatter(16, 6, function(p)
			rock(folder, p, RGB(200, 160, 110), M.Sandstone)
		end)
		scatter(6, 6, function(p)
			part(folder, { Size = V(0.6, 0.6, 3), CFrame = CFrame.new(p + V(0, 0.3, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0),
				Color = RGB(240, 235, 220), CanCollide = false })
		end)
	elseif biome.id == "Pantano" then
		scatter(18, 8, function(p)
			deadTree(folder, p)
		end)
		scatter(30, 4, function(p)
			for _ = 1, 4 do
				cyl(folder, 0.2, rng:NextNumber(2, 4), p + V(rng:NextNumber(-1.5, 1.5), 1.2, rng:NextNumber(-1.5, 1.5)), RGB(90, 120, 60)).CanCollide = false
			end
		end)
		scatter(14, 4, function(p)
			cyl(folder, 0.5, 1.2, p + V(0, 0.6, 0), RGB(230, 220, 200))
			cyl(folder, 2, 0.5, p + V(0, 1.3, 0), RGB(200, 60, 60)).CanCollide = false
		end)
	elseif biome.id == "Neve" then
		scatter(28, 8, function(p)
			pineTree(folder, p, true)
		end)
		scatter(14, 6, function(p)
			crystal(folder, p, RGB(150, 220, 255))
		end)
		scatter(5, 10, function(p)
			snowman(folder, p)
		end)
	elseif biome.id == "Vulcao" then
		scatter(12, 10, function(p)
			lavaPool(folder, p)
		end)
		scatter(20, 6, function(p)
			rock(folder, p, RGB(40, 35, 35), M.Basalt)
		end)
		scatter(8, 6, function(p)
			crystal(folder, p, RGB(255, 120, 40))
		end)
	elseif biome.id == "Ceu" then
		scatter(16, 6, function(p)
			crystal(folder, p, RGB(130, 240, 255))
		end)
		scatter(20, 4, function(p)
			flowers(folder, p, rng:NextInteger(4, 7))
		end)
		for i = 0, 7 do
			local a = i * math.pi / 4
			local c = biome.center
			local pos = c + V(math.cos(a) * 85, 0, math.sin(a) * 85)
			cyl(folder, 2.5, 14, pos + V(0, 7, 0), RGB(255, 225, 130), M.Marble)
			ball(folder, 3, pos + V(0, 15, 0), RGB(130, 240, 255), M.Neon)
		end
		for _ = 1, 14 do
			local a = rng:NextNumber(0, 6.28)
			local r = rng:NextNumber(110, 170)
			cloud(folder, biome.center + V(math.cos(a) * r, rng:NextNumber(-25, 15), math.sin(a) * r), rng:NextNumber(8, 14))
		end
	end
end

local function biomeEntrances(parent)
	local colors = {
		Floresta = RGB(130, 230, 110), Deserto = RGB(255, 210, 110), Pantano = RGB(150, 200, 90),
		Neve = RGB(180, 230, 255), Vulcao = RGB(255, 120, 60), Ceu = RGB(130, 240, 255),
	}
	-- direção da entrada principal de cada bioma (para onde o portal olha)
	local mainGate = { Deserto = V(-1, 0, 0), Pantano = V(1, 0, 0), Neve = V(0, 0, 1), Vulcao = V(0, 0, -1) }
	for _, biome in ipairs(Config.Biomes) do
		local color = colors[biome.id] or RGB(255, 255, 255)
		if biome.id ~= "Ceu" then
			fenceBiome(parent, biome, if biome.id == "Neve" then RGB(220, 225, 235) else RGB(150, 105, 65))
		end
		local c = biome.center
		local title = biome.icon .. " " .. string.upper(biome.name)
		if biome.id == "Floresta" then
			local hx, hz = biome.size.X / 2, biome.size.Y / 2
			for _, dir in ipairs({ V(0, 0, 1), V(0, 0, -1), V(1, 0, 0), V(-1, 0, 0) }) do
				arch(parent, c + V(dir.X * hx, 0, dir.Z * hz), dir, title, "Livre", color)
			end
		elseif mainGate[biome.id] then
			local dir = mainGate[biome.id]
			local pos = c + V(dir.X * biome.size.X / 2, 0, dir.Z * biome.size.Y / 2)
			arch(parent, pos, dir, title, unlockText(biome), color)
		end
	end
end

---------------------------------------------------------------------
-- Praça do spawn, portais e arena
---------------------------------------------------------------------
local function buildHub(parent)
	-- piso
	part(parent, { Name = "HubFloor", Size = V(50, 0.4, 100), CFrame = CFrame.new(HUB + V(0, 0.2, 0)), Color = RGB(225, 220, 210), Material = M.Marble })
	local board = part(parent, { Name = "InfoBoard", Size = V(22, 11, 1), CFrame = CFrame.new(HUB + V(-22, 6.5, 0)) * CFrame.Angles(0, math.rad(90), 0),
		Color = RGB(60, 45, 35), Material = M.Wood })
	textOn(board, "🏏 BRAINROT TYCOON\n<font size=\"30\">Bata • Capture • Evolua • Roube • Duele</font>\n"
		.. "<font size=\"24\">Menu 🗺 Áreas para viajar</font>", RGB(255, 230, 120), { Enum.NormalId.Front })

	-- portal para o Céu Celestial
	local portalPos = HUB + V(0, 0, 36)
	local pad = cyl(parent, 12, 0.6, portalPos + V(0, 0.4, 0), RGB(130, 240, 255), M.Neon)
	pad.Name = "PortalCeu"
	pad.CanCollide = false
	local ring = part(parent, { Shape = Enum.PartType.Cylinder, Size = V(0.6, 16, 16),
		CFrame = CFrame.new(portalPos + V(0, 8.5, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = RGB(255, 230, 120), Material = M.Neon, CanCollide = false, Transparency = 0.3 })
	ring.Name = "PortalRing"
	local sign = part(parent, { Size = V(18, 3, 0.6), CFrame = CFrame.new(portalPos + V(0, 18, 0)), Color = RGB(40, 40, 70), Material = M.SmoothPlastic })
	textOn(sign, "☁ PORTAL CELESTIAL\n<font size=\"30\">" .. unlockText(Config.getBiome("Ceu") or { unlock = {} }) .. "</font>",
		RGB(150, 240, 255), { Enum.NormalId.Front, Enum.NormalId.Back })
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Color = ColorSequence.new(RGB(150, 240, 255))
	sparkle.LightEmission = 1
	sparkle.Rate = 20
	sparkle.Speed = NumberRange.new(2, 5)
	sparkle.Lifetime = NumberRange.new(1, 2)
	sparkle.Size = NumberSequence.new(0.4)
	sparkle.Parent = pad

	for _, z in ipairs({ -40, 40 }) do
		lamp(parent, HUB + V(18, 0, z))
		lamp(parent, HUB + V(-18, 0, z))
	end

	-- portal de volta no Céu
	local sky = Config.getBiome("Ceu")
	if sky then
		local back = cyl(parent, 10, 0.6, sky.center + V(0, 0.4, sky.size.Y / 2 - 15), RGB(255, 230, 120), M.Neon)
		back.Name = "PortalVolta"
		back.CanCollide = false
		local backSign = part(parent, { Size = V(14, 3, 0.6), CFrame = CFrame.new(back.Position + V(0, 8, 0)), Color = RGB(40, 40, 70) })
		textOn(backSign, "⬇ VOLTAR", RGB(255, 230, 120), { Enum.NormalId.Front, Enum.NormalId.Back })
	end
end

local function buildArena(parent)
	local c = Config.Duel.Arena
	part(parent, { Name = "ArenaFloor", Size = V(70, 1, 70), CFrame = CFrame.new(c + V(0, 0.5, 0)), Color = RGB(180, 70, 70), Material = M.Concrete })
	part(parent, { Name = "ArenaCircle", Shape = Enum.PartType.Cylinder, Size = V(0.2, 40, 40),
		CFrame = CFrame.new(c + V(0, 1.05, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = RGB(255, 255, 255), Material = M.SmoothPlastic, CanCollide = false })
	for _, s in ipairs({ -1, 1 }) do
		part(parent, { Size = V(70, 6, 2), CFrame = CFrame.new(c + V(0, 3, s * 35)), Color = RGB(90, 60, 50), Material = M.Brick })
		part(parent, { Size = V(2, 6, 70), CFrame = CFrame.new(c + V(s * 35, 3, 0)), Color = RGB(90, 60, 50), Material = M.Brick })
		cyl(parent, 8, 0.4, c + V(s * Config.Duel.PadOffset, 1.2, 0), if s < 0 then RGB(80, 160, 255) else RGB(255, 90, 90), M.Neon).CanCollide = false
	end
	-- entrada (buraco na parede de baixo, do lado do caminho)
	local sign = part(parent, { Size = V(26, 5, 1), CFrame = CFrame.new(c + V(0, 10, 36)), Color = RGB(60, 30, 30), Material = M.Wood })
	textOn(sign, "⚔ ARENA DE DUELO", RGB(255, 200, 90), { Enum.NormalId.Front, Enum.NormalId.Back })
end

local function statue(parent, center: Vector3)
	local def = Config.getBrainrot("TungTung") or Config.Brainrots[1]
	cyl(parent, 14, 2, center + V(0, 1, 0), RGB(190, 185, 175), M.Marble)
	cyl(parent, 11, 2, center + V(0, 3, 0), RGB(210, 205, 195), M.Marble)
	local plaque = part(parent, { Size = V(8, 1.6, 0.4), CFrame = CFrame.new(center + V(0, 2.6, -5.6)), Color = RGB(255, 205, 60), Material = M.Metal })
	textOn(plaque, def.name, RGB(60, 40, 10), { Enum.NormalId.Front })
	local model = BrainrotModels.build(def, 2.2)
	local hip = model:GetAttribute("HipHeight") or 3
	model:PivotTo(CFrame.new(center + V(0, 4 + hip, 0)) * CFrame.Angles(0, math.pi, 0))
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
	model.Name = "Statue"
	model.Parent = parent
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 3
	Lighting.GlobalShadows = true
	Lighting.OutdoorAmbient = RGB(150, 150, 165)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	local function effect(className: string, props)
		local old = Lighting:FindFirstChild("Brainrot" .. className)
		if old then
			old:Destroy()
		end
		local e = Instance.new(className)
		e.Name = "Brainrot" .. className
		for k, v in pairs(props) do
			e[k] = v
		end
		e.Parent = Lighting
	end
	effect("Atmosphere", { Density = 0.28, Offset = 0.2, Color = RGB(200, 225, 255), Decay = RGB(110, 145, 190), Glare = 0.2, Haze = 1 })
	effect("BloomEffect", { Intensity = 0.4, Size = 24, Threshold = 1.6 })
	effect("ColorCorrectionEffect", { Saturation = 0.18, Contrast = 0.06, Brightness = 0.02, TintColor = RGB(255, 255, 255) })
	effect("SunRaysEffect", { Intensity = 0.06, Spread = 0.8 })
end

---------------------------------------------------------------------
-- Construir tudo
---------------------------------------------------------------------
function WorldBuilder.build()
	if not Config.BuildMap then
		return
	end
	if workspace:FindFirstChild("Map") then
		workspace.Map:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = "Map"
	map.Parent = workspace
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end

	buildTerrain()
	setupLighting()

	local decor = Instance.new("Folder")
	decor.Name = "Decoracao"
	decor.Parent = map
	for _, biome in ipairs(Config.Biomes) do
		decorateBiome(decor, biome)
	end
	biomeEntrances(map)
	statue(map, Config.getBiome("Floresta") and Config.getBiome("Floresta").center or V(0, 0, 0))
	buildHub(map)
	buildArena(map)

	-- floresta em volta (fora dos biomas, bases e caminhos)
	local half = ISLAND / 2 - 8
	local placed = 0
	for _ = 1, 1500 do
		if placed >= 160 then
			break
		end
		local x, z = rng:NextNumber(-half, half), rng:NextNumber(-half, half)
		if isFree(x, z, 6) then
			placed += 1
			local roll = rng:NextNumber()
			if roll < 0.45 then
				roundTree(decor, V(x, 0, z))
			elseif roll < 0.8 then
				pineTree(decor, V(x, 0, z))
			elseif roll < 0.92 then
				flowers(decor, V(x, 0, z), rng:NextInteger(5, 9))
			else
				rock(decor, V(x, 0, z))
			end
		end
	end

	for _, s in ipairs({ -1, 1 }) do
		for x = -130, 130, 40 do
			lamp(map, V(x, 0, s * 136 + s * 7))
		end
	end

	local spawnLocation = workspace:FindFirstChildOfClass("SpawnLocation")
	if not spawnLocation then
		spawnLocation = Instance.new("SpawnLocation")
		spawnLocation.Parent = map
	end
	spawnLocation.Name = "SpawnLocation"
	spawnLocation.Anchored = true
	spawnLocation.Size = V(14, 1, 14)
	spawnLocation.CFrame = CFrame.new(HUB + V(0, 0.5, -25))
	spawnLocation.Material = M.Marble
	spawnLocation.Color = RGB(240, 240, 240)
	spawnLocation.Neutral = true
	spawnLocation.Duration = 3
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX0000000000000000000000000000001E"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000000000000000000000000001D"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX0000000000000000000000000000001C"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX0000000000000000000000000000001A"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Interface do jogador + arremesso da bola.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

